    | NEnvUnion => { key = "env_union"; region = REnv; kind = Cfg; title = "SPIRAL_UNION_NESTING_LIMIT"; detail = "union nesting guard" }
    | NEnvDefine => { key = "env_define"; region = REnv; kind = Cfg; title = "build define SPIRAL_CORE_HOPACSOTA"; detail = "build.ps1 -Mode hopacsota vs -Mode single-flight" }

