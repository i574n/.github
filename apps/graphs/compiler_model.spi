:~ relations () : list (relation part) =
    [
        { source = PServer NSvMain; target = PServer NSvNew; kind = Flow; label = "starts" };
        { source = PServer NSvNew; target = PServer NSvSuper; kind = Flow; label = "" };
        { source = PServer NSvHub; target = PServer NSvSuper; kind = Flow; label = "client requests" };
        { source = PServer NSvSuper; target = PProj NLoader; kind = Flow; label = "project load" };
        { source = PProj NLoader; target = PProj NSpiproj; kind = Flow; label = "schema" };
        { source = PProj NLoader; target = PProj NGraph; kind = Flow; label = "package order" };
        { source = PProj NLoader; target = PProj NWdiff; kind = Flow; label = "dirty nodes" };
        { source = PProj NWdiff; target = PFront NTokenize; kind = Flow; label = "" };
