:< sm'_operators
:< graph

:| region =
    | RWhole
    | RInfra
    | RFront
    | RProj
    | RTyping
    | RPrep
    | RPe
    | RPeTables
    | RPeOps
    | RPeGuards
    | RSeams
    | RSf
    | RHs
    | RHsSeams
    | RHsEngine
    | RHsTable
    | RHsGraph
    | RHsWork
    | RHsCtx
    | RDiverge
    | RCodegen
    | RBackends
    | RServer
    | REnv

:~ info_of_region (r : region) : region_info region =
    ?= r ?|
    | RWhole => { key = "whole"; parent = TopLevel; title = "spiral_compiler.fs (35,585 lines, 912 sections)"; subtitle = "apps/compiler: one F# file = the whole compiler core" }
    | RInfra => { key = "infra"; parent = Under (RWhole); title = "Shared infrastructure"; subtitle = "used by every phase, both builds" }
    | RFront => { key = "front"; parent = Under (RWhole); title = "Front end"; subtitle = "text -> tokens -> blocks -> AST bundles" }
    | RProj => { key = "proj"; parent = Under (RWhole); title = "Projects & incremental (WDiff / SpiProj)"; subtitle = "Hopac promises, dirty-node recompute" }
    | RTyping => { key = "typing"; parent = Under (RWhole); title = "Type inference"; subtitle = "Infer + adapters" }
    | RPrep => { key = "prep"; parent = Under (RWhole); title = "Prepass"; subtitle = "lowering to the evaluable core" }
    | RPe => { key = "pe"; parent = Under (RWhole); title = "Partial evaluation core (PartEval, L8930-12004)"; subtitle = "the SAME code in both builds; every concurrency-sensitive step goes through PartEvalSeams" }
    | RPeTables => { key = "pe_tables"; parent = Under (RPe); title = "peval state (per build)"; subtitle = "memo tables keyed by hash-consed join point keys" }
    | RPeOps => { key = "pe_ops"; parent = Under (RPe); title = "peval operations that touch the seams"; subtitle = "35 call sites" }
    | RPeGuards => { key = "pe_guards"; parent = Under (RPe); title = "Runaway guards & thread-local state"; subtitle = "what a parallel body must save/restore" }
    | RSeams => { key = "seams"; parent = Under (RWhole); title = "PartEvalSeams API (identical signatures in both builds)"; subtitle = "Adapter<'env> + Session<'env> + 16 operations" }
    | RSf => { key = "sf"; parent = Under (RWhole); title = "SINGLE-FLIGHT build (#else branch, L8892-8928)"; subtitle = "every seam is an F# inline function: zero cost, depth-first, one thread" }
    | RHs => { key = "hs"; parent = Under (RWhole); title = "HOPACSOTA build (#if SPIRAL_CORE_HOPACSOTA, L8241-8890)"; subtitle = "the single-flight core + a parallel layer" }
    | RHsSeams => { key = "hs_seams"; parent = Under (RHs); title = "PartEvalSeams (hopacsota, L8660-8890)"; subtitle = "Session: policy, deferral, markers, canonical replay" }
    | RHsEngine => { key = "hs_engine"; parent = Under (RHs); title = "PartEvalEngine (L8243-8657)"; subtitle = "Hopac-mediated claim table on dedicated 1.5 GB body threads" }
    | RHsTable => { key = "hs_table"; parent = Under (RHsEngine); title = "Table: the single source of truth for keys"; subtitle = "serialized behind MVar<Table>" }
    | RHsGraph => { key = "hs_graph"; parent = Under (RHsEngine); title = "Graph: wait-for edges"; subtitle = "deadlock detection" }
    | RHsWork => { key = "hs_work"; parent = Under (RHsEngine); title = "Worklist: body scheduling"; subtitle = "tokens = workers - 1" }
    | RHsCtx => { key = "hs_ctx"; parent = Under (RHsEngine); title = "Per-thread BodyContext"; subtitle = "ThreadLocal, one per body thread + root" }
    | RDiverge => { key = "diverge"; parent = Under (RWhole); title = "How the two builds diverge"; subtitle = "same inputs, same output text, different journeys" }
    | RCodegen => { key = "codegen"; parent = Under (RWhole); title = "Code generation (19 backends)"; subtitle = "reads the peval result tables" }
    | RBackends => { key = "backends"; parent = Under (RCodegen); title = "Backends"; subtitle = "build_many / build dispatch (L35115)" }
    | RServer => { key = "server"; parent = Under (RWhole); title = "Supervisor, server & entry points"; subtitle = "where a build starts" }
    | REnv => { key = "env"; parent = Under (RWhole); title = "Environment switches"; subtitle = "read once at startup" }

:~ regions () : list region =
    [ RWhole; RInfra; RFront; RProj; RTyping; RPrep; RPe; RPeTables; RPeOps; RPeGuards; RSeams; RSf; RHs; RHsSeams; RHsEngine; RHsTable; RHsGraph; RHsWork; RHsCtx; RDiverge; RCodegen; RBackends; RServer; REnv ]

:| infra_part =
    | NHashcons
    | NConsed
    | NStriped
    | NMemoize
    | NHopacext
    | NPvec
    | NParsec
    | NIdadapter
    | NHopaclib

:~ info_of_infra (p : infra_part) : part_info region =
    ?= p ?|
    | NHashcons => { key = "hashcons"; region = RInfra; kind = Data; title = "HashConsTable (L153)"; detail = "weak-ref buckets; Add under lock sync_root -> thread-safe for hopacsota" }
    | NConsed => { key = "consed"; region = RInfra; kind = Data; title = "ConsedNode<'a> (L131)"; detail = "equality by tag; join point keys are ConsedNodes" }
    | NStriped => { key = "striped"; region = RInfra; kind = Data; title = "StripedHashConsTable (L221)"; detail = "32 shards, Fibonacci hashing (MIGRATION, not wired into peval)" }
    | NMemoize => { key = "memoize"; region = RInfra; kind = Fn; title = "Utils.memoize (L351)"; detail = "Dictionary memo; single-flight family = memoize" }
    | NHopacext => { key = "hopacext"; region = RInfra; kind = Fn; title = "HopacExtensions (L3794)"; detail = "Hopac Job/Promise/Stream helpers (both builds)" }
    | NPvec => { key = "pvec"; region = RInfra; kind = Fn; title = "PersistentVector ext. (L46)"; detail = "immutable vectors for WDiff" }
    | NParsec => { key = "parsec"; region = RInfra; kind = Fn; title = "ParserCombinators (L381)"; detail = "tuple/pipe/many/choice combinators" }
    | NIdadapter => { key = "idadapter"; region = RInfra; kind = Fn; title = "IdentityAdapter (L11)"; detail = "name ids are strings in this core" }
    | NHopaclib => { key = "hopaclib"; region = RInfra; kind = Ext; title = "Hopac library"; detail = "Job, Ch, IVar, MVar, Promise, Scheduler" }

:| front_part =
    | NStartup
    | NTokenize
    | NBlocksplit
    | NBlockparse
    | NBundle
    | NFormatter

:~ info_of_front (p : front_part) : part_info region =
    ?= p ?|
    | NStartup => { key = "startup"; region = RFront; kind = Fn; title = "Startup / CliArguments (L250)"; detail = "Argu parse, DefaultEnv, PrimitiveType" }
    | NTokenize => { key = "tokenize"; region = RFront; kind = Fn; title = "Tokenize (L870)"; detail = "LexState, token, vscode_tokens, semantic legend" }
    | NBlocksplit => { key = "blocksplit"; region = RFront; kind = Fn; title = "BlockSplitting (L1629)"; detail = "block_at / block_all / wdiff_block_all" }
    | NBlockparse => { key = "blockparse"; region = RFront; kind = Fn; title = "BlockParsing (L1703)"; detail = "top_statement, patterns, OrPatternJoin, operators" }
    | NBundle => { key = "bundle"; region = RFront; kind = Fn; title = "BlockBundling (L3855)"; detail = "bundle_blocks, wdiff_block_bundle" }
    | NFormatter => { key = "formatter"; region = RFront; kind = Fn; title = "Formatter (L29325)"; detail = "4,180 lines, standalone" }

:| proj_part =
    | NSpiproj
    | NWdiff
    | NWdiffprep
    | NGraph
    | NLoader

:~ info_of_proj (p : proj_part) : part_info region =
    ?= p ?|
    | NSpiproj => { key = "spiproj"; region = RProj; kind = Fn; title = "SpiProj (L28785)"; detail = "package.spiproj / TOML schema, derived modules" }
    | NWdiff => { key = "wdiff"; region = RProj; kind = Fn; title = "WDiff (L27901)"; detail = "tokenizer/parse/module/file/proj diffs; typecheck funs" }
    | NWdiffprep => { key = "wdiffprep"; region = RProj; kind = Fn; title = "WDiffPrepass (L28620)"; detail = "incremental prepass per file/package" }
    | NGraph => { key = "graph"; region = RProj; kind = Fn; title = "Graph (L33525)"; detail = "MirroredGraph, topological_sort, circular_nodes" }
    | NLoader => { key = "loader"; region = RProj; kind = Fn; title = "ServerUtils loader (L33645)"; detail = "loader_package, dirty_nodes_tc/prepass, schema state" }

:| typing_part =
    | NInfer
    | NInferadapter
    | NInlinedepth
    | NTypeerr

:~ info_of_typing (p : typing_part) : part_info region =
    ?= p ?|
    | NInfer => { key = "infer"; region = RTyping; kind = Fn; title = "Infer (L4193)"; detail = "infer, TopEnv, FilledTop Hopac.Promise" }
    | NInferadapter => { key = "inferadapter"; region = RTyping; kind = Seam; title = "InferAdapter (L4187)"; detail = "identity seam: failedDeclaration, module reports" }
    | NInlinedepth => { key = "inlinedepth"; region = RTyping; kind = Data; title = "InlineDepth (L4147)"; detail = "InlineStackPolicy, InlineRecursionStop" }
    | NTypeerr => { key = "typeerr"; region = RTyping; kind = Fn; title = "TypeErrorCodes (L4180)"; detail = "type_error_report" }

:| prep_part =
    | NPrepass
    | NPrepassadapter
    | NPrepenv

:~ info_of_prep (p : prep_part) : part_info region =
    ?= p ?|
    | NPrepass => { key = "prepass"; region = RPrep; kind = Fn; title = "prepassPrepass (L7783)"; detail = "propagate (L7163) -> resolve (L7301) -> lower (L7424)" }
    | NPrepassadapter => { key = "prepassadapter"; region = RPrep; kind = Seam; title = "PrepassAdapter (L6742)"; detail = "identity seam: memoPatternRef, visitPatternRefOnce" }
    | NPrepenv => { key = "prepenv"; region = RPrep; kind = Data; title = "PartEvalPrepassEnv (L7673)"; detail = "add_term / fresh vars / process_term" }

:| pe_part =
    | NPeval
    | NTopenv
    | NLangenv
    | NResult
    | NTermscope
    | NCse

:~ info_of_pe (p : pe_part) : part_info region =
    ?= p ?|
    | NPeval => { key = "peval"; region = RPe; kind = Entry; title = "peval env main (L9705)"; detail = "builds the session, the tables and LangEnv; evaluates main" }
    | NTopenv => { key = "topenv"; region = RPe; kind = Data; title = "PartEvalTopEnv"; detail = "prototypes_instances, nominals, backend, inline_restart" }
    | NLangenv => { key = "langenv"; region = RPe; kind = Data; title = "LangEnv"; detail = "trace, seq, cse, i, env stacks, backend, globals (ResizeArray<string>)" }
    | NResult => { key = "result"; region = RPe; kind = Data; title = "PartEvalResult (L9573)"; detail = "join_point_method, join_point_closure, ty_to_data, globals" }
    | NTermscope => { key = "termscope"; region = RPe; kind = Fn; title = "term / term_scope''"; detail = "the evaluator: one big recursive match over E" }
    | NCse => { key = "cse"; region = RPe; kind = Fn; title = "push_typedop + CSE"; detail = "cse_tryfind / cse_add on s.cse" }

:| pe_tables_part =
    | NJpm
    | NJpc
    | NJpt
    | NBsv
    | NGlobals

:~ info_of_pe_tables (p : pe_tables_part) : part_info region =
    ?= p ?|
    | NJpm => { key = "jpm"; region = RPeTables; kind = Data; title = "join_point_method"; detail = "Dictionary<(backend, body), Dictionary<key, (seq option, ty option, name)> * HashConsTable>" }
    | NJpc => { key = "jpc"; region = RPeTables; kind = Data; title = "join_point_closure"; detail = "Dictionary<(backend, body), Dictionary<key, (domain, seq) option> * HashConsTable>" }
    | NJpt => { key = "jpt"; region = RPeTables; kind = Data; title = "join_point_type"; detail = "Dictionary<body, Dictionary<key, Ty option> * HashConsTable>" }
    | NBsv => { key = "bsv"; region = RPeTables; kind = Data; title = "backend_switch_validated"; detail = "Dictionary<(backend, RData[]), Ty> + its HashConsTable" }
    | NGlobals => { key = "globals"; region = RPeTables; kind = Data; title = "s.globals"; detail = "ordered list of emitted global text; GlobalsIndex keeps a HashSet per list" }

:| pe_ops_part =
    | NClosure
    | NTjp
    | NMjp
    | NBswitch
    | NUninh
    | NPrintst
    | NMainroot

:~ info_of_pe_ops (p : pe_ops_part) : part_info region =
    ?= p ?|
    | NClosure => { key = "closure"; region = RPeOps; kind = Op; title = "closure_convert (L9770)"; detail = "family -> claim -> announce(true) -> key_body \"closure\" -> defer -> fill" }
    | NTjp => { key = "tjp"; region = RPeOps; kind = Op; title = "type join point TJoinPoint' (L9955)"; detail = "family -> claim -> key_body \"type\" -> ty -> fill (never deferred)" }
    | NMjp => { key = "mjp"; region = RPeOps; kind = Op; title = "method join point EJoinPoint' (L10380)"; detail = "family -> claim -> announce(annotated?) -> key_body \"method\" -> defer -> fill" }
    | NBswitch => { key = "bswitch"; region = RPeOps; kind = Op; title = "BackendSwitch validation (L10844)"; detail = "validated -> read | key_body \"bsv\" -> apply -> fill" }
    | NUninh => { key = "uninh"; region = RPeOps; kind = Op; title = "is_uninhabited (L9939)"; detail = "nesting counter, limit 32" }
    | NPrintst => { key = "printst"; region = RPeOps; kind = Op; title = "PrintStatic / PrintRaw (L11775)"; detail = "print seam" }
    | NMainroot => { key = "mainroot"; region = RPeOps; kind = Op; title = "main entry (L12001)"; detail = "root globals (term_scope main ())" }

:| pe_guards_part =
    | NRunaway
    | NDynif
    | NUnionnest
    | NGindex
    | NRustgap

:~ info_of_pe_guards (p : pe_guards_part) : part_info region =
    ?= p ?|
    | NRunaway => { key = "runaway"; region = RPeGuards; kind = Fn; title = "RunawayUnrollDiagnostic (L9585)"; detail = "Rust-style report; ConcurrentDictionary of source lines" }
    | NDynif => { key = "dynif"; region = RPeGuards; kind = Data; title = "DynamicIfNesting (L9646)"; detail = "ThreadLocal depth, SPIRAL_IF_NESTING_LIMIT=1000" }
    | NUnionnest => { key = "unionnest"; region = RPeGuards; kind = Data; title = "UnionNesting (L9653)"; detail = "ThreadLocal depth, limit 256, EJP0041" }
    | NGindex => { key = "gindex"; region = RPeGuards; kind = Data; title = "GlobalsIndex (L9666)"; detail = "ConditionalWeakTable<list, HashSet>" }
    | NRustgap => { key = "rustgap"; region = RPeGuards; kind = Data; title = "RustGapTrace (L9674)"; detail = "ThreadLocal validating; ConcurrentDictionary of missing arms" }

:| seams_part =
    | NAdapter
    | NSSession
    | NSClaimty
    | NSStart
    | NSRestart
    | NSRoot
    | NSDefer
    | NSClaim
    | NSAnnounce
    | NSFill
    | NSFamily
    | NSKeyhit
    | NSKeybody
    | NSPrint
    | NSNesting
    | NSValidated
    | NSRead
    | NSActive

:~ info_of_seams (p : seams_part) : part_info region =
    ?= p ?|
    | NAdapter => { key = "adapter"; region = RSeams; kind = Type; title = "Adapter<'env>"; detail = "globals, with_globals, dynamic_if/set, validating/set, rebuild_index" }
    | NSSession => { key = "s_session"; region = RSeams; kind = Type; title = "Session<'env>"; detail = "single-flight: Inline   |   hopacsota: class or null" }
    | NSClaimty => { key = "s_claimty"; region = RSeams; kind = Type; title = "Claim<'v> = Found 'v"; detail = "Owner | who evaluates a key" }
    | NSStart => { key = "s_start"; region = RSeams; kind = Api; title = "start_for inline_restart adapter"; detail = "open a session for this peval" }
    | NSRestart => { key = "s_restart"; region = RSeams; kind = Api; title = "with_conflict_restart f"; detail = "f false, or f true after a conflict" }
    | NSRoot => { key = "s_root"; region = RSeams; kind = Api; title = "root session globals f"; detail = "run main, then settle" }
    | NSDefer => { key = "s_defer"; region = RSeams; kind = Api; title = "defer session s relative deferred evaluate"; detail = "evaluate a join point body now or later" }
    | NSClaim => { key = "s_claim"; region = RSeams; kind = Api; title = "claim session table key pending"; detail = "Found value or Owner" }
    | NSAnnounce => { key = "s_announce"; region = RSeams; kind = Api; title = "announce session usable table key value"; detail = "publish a usable signature early" }
    | NSFill => { key = "s_fill"; region = RSeams; kind = Api; title = "fill session table key value"; detail = "publish the finished value" }
    | NSFamily => { key = "s_family"; region = RSeams; kind = Api; title = "family session outer create key"; detail = "per-(backend, body) inner table" }
    | NSKeyhit => { key = "s_keyhit"; region = RSeams; kind = Api; title = "key_hit session key s"; detail = "a reuse of a finished key" }
    | NSKeybody => { key = "s_keybody"; region = RSeams; kind = Api; title = "key_body session key label s"; detail = "the env that evaluates a key's body" }
    | NSPrint => { key = "s_print"; region = RSeams; kind = Api; title = "print session s text"; detail = "compile-time printing" }
    | NSNesting => { key = "s_nesting"; region = RSeams; kind = Api; title = "nesting session shared"; detail = "which counter is_uninhabited uses" }
    | NSValidated => { key = "s_validated"; region = RSeams; kind = Api; title = "validated session table key"; detail = "backend switch type already known?" }
    | NSRead => { key = "s_read"; region = RSeams; kind = Api; title = "read session table key"; detail = "read a validated type" }
    | NSActive => { key = "s_active"; region = RSeams; kind = Api; title = "active session"; detail = "is a parallel session running?" }

:| sf_part =
    | NSfSession
    | NSfStart
    | NSfRestart
    | NSfRoot
    | NSfDefer
    | NSfClaim
    | NSfAnnounce
    | NSfFill
    | NSfFamily
    | NSfKeyhit
    | NSfKeybody
    | NSfPrint
    | NSfNesting
    | NSfValidated
    | NSfRead
    | NSfActive

:~ info_of_sf (p : sf_part) : part_info region =
    ?= p ?|
    | NSfSession => { key = "sf_session"; region = RSf; kind = Impl; title = "Session = Inline"; detail = "a one-case union; no state at all" }
    | NSfStart => { key = "sf_start"; region = RSf; kind = Impl; title = "start_for = Inline"; detail = "inline_restart is ignored" }
    | NSfRestart => { key = "sf_restart"; region = RSf; kind = Impl; title = "with_conflict_restart = f false"; detail = "a conflict cannot happen" }
    | NSfRoot => { key = "sf_root"; region = RSf; kind = Impl; title = "root = f ()"; detail = "main runs to completion on the build thread" }
    | NSfDefer => { key = "sf_defer"; region = RSf; kind = Impl; title = "defer = evaluate s"; detail = "the body is evaluated immediately, depth first, in the current env" }
    | NSfClaim => { key = "sf_claim"; region = RSf; kind = Impl; title = "claim = TryGetValue, else table.[key] <- pending; Owner"; detail = "pending marks 'in progress' for recursion" }
    | NSfAnnounce => { key = "sf_announce"; region = RSf; kind = Impl; title = "announce = table.[key] <- value"; detail = "just a write" }
    | NSfFill => { key = "sf_fill"; region = RSf; kind = Impl; title = "fill = table.[key] <- value"; detail = "just a write" }
    | NSfFamily => { key = "sf_family"; region = RSf; kind = Impl; title = "family = Utils.memoize outer create key"; detail = "one shared inner table" }
    | NSfKeyhit => { key = "sf_keyhit"; region = RSf; kind = Impl; title = "key_hit = ()"; detail = "no markers" }
    | NSfKeybody => { key = "sf_keybody"; region = RSf; kind = Impl; title = "key_body = s"; detail = "globals untouched" }
    | NSfPrint => { key = "sf_print"; region = RSf; kind = Impl; title = "print = printfn"; detail = "printed at the moment of evaluation" }
    | NSfNesting => { key = "sf_nesting"; region = RSf; kind = Impl; title = "nesting = shared ref"; detail = "one counter per peval" }
    | NSfValidated => { key = "sf_validated"; region = RSf; kind = Impl; title = "validated = ContainsKey |"; detail = "" }
    | NSfRead => { key = "sf_read"; region = RSf; kind = Impl; title = "read = table.[key] |"; detail = "" }
    | NSfActive => { key = "sf_active"; region = RSf; kind = Impl; title = "active = false"; detail = "validation globals come from validation_root_globals" }

:| hs_seams_part =
    | NHsPolicy
    | NHsSession
    | NHsStart
    | NHsRestart
    | NHsRoot
    | NHsDefer
    | NHsBody
    | NHsDrain
    | NHsKeyhit
    | NHsKeybody
    | NHsPrint
    | NHsFinish
    | NHsCensus
    | NHsFallback
    | NHsMarks

:~ info_of_hs_seams (p : hs_seams_part) : part_info region =
    ?= p ?|
    | NHsPolicy => { key = "hs_policy"; region = RHsSeams; kind = Cfg; title = "Policy"; detail = "DepthFirst | BreadthFirst | Seeded seed | Parallel; None = inline (no session)" }
    | NHsSession => { key = "hs_session"; region = RHsSeams; kind = Class; title = "Session<'env>(policy, adapter)"; detail = "queue, own Marks, seeded Random, engine (null unless Parallel), census" }
    | NHsStart => { key = "hs_start"; region = RHsSeams; kind = Impl; title = "start / start_for"; detail = "inline_restart -> null session; policy None -> null" }
    | NHsRestart => { key = "hs_restart"; region = RHsSeams; kind = Impl; title = "with_conflict_restart"; detail = "try f false; on HopacsotaConflict: eprintfn ... restart in canonical single-flight order (D4); f true" }
    | NHsRoot => { key = "hs_root"; region = RHsSeams; kind = Impl; title = "Session.Root"; detail = "Parallel -> new Engine(evaluating_threads); f(); Finished; Drain; census; Check; Finish; Close" }
    | NHsDefer => { key = "hs_defer"; region = RHsSeams; kind = Impl; title = "Session.Defer"; detail = "BFS/Seeded/Parallel with an annotation: new 'globals' marker + child list, body closure; returns the annotated result at once" }
    | NHsBody => { key = "hs_body"; region = RHsSeams; kind = Impl; title = "deferred body closure"; detail = "saves/zeroes dynamic_if + validating, evaluate body_env, failure -> 'fail' marker, restores, census row" }
    | NHsDrain => { key = "hs_drain"; region = RHsSeams; kind = Impl; title = "Session.Drain"; detail = "queue loop (Seeded: random pick) or engine.Drain" }
    | NHsKeyhit => { key = "hs_keyhit"; region = RHsSeams; kind = Impl; title = "Session.KeyHit"; detail = "appends the key's marker to the caller's globals" }
    | NHsKeybody => { key = "hs_keybody"; region = RHsSeams; kind = Impl; title = "Session.KeyBody"; detail = "names marker 'key-<label>', new child list, env with that list as globals" }
    | NHsPrint => { key = "hs_print"; region = RHsSeams; kind = Impl; title = "Session.Print"; detail = "'print' marker; text kept until Finish" }
    | NHsFinish => { key = "hs_finish"; region = RHsSeams; kind = Impl; title = "Session.Finish"; detail = "merge Marks of every context; walk markers from root; replay prints; first failure wins; dedupe globals; rebuild_index" }
    | NHsCensus => { key = "hs_census"; region = RHsSeams; kind = Data; title = "census"; detail = "SPIRAL_HOPACSOTA_CENSUS_OUT: body, parent, spawn_at_us, self_us" }
    | NHsFallback => { key = "hs_fallback"; region = RHsSeams; kind = Impl; title = "seam ops with engine = null"; detail = "claim/fill/announce/family/nesting/validated/read fall back to the single-flight code" }
    | NHsMarks => { key = "hs_marks"; region = RHsSeams; kind = Data; title = "Marks(prefix)"; detail = "Children, Prints, Failures, Keys; names '\\u0001hopacsota-<kind>-<prefix><n>'" }

:| hs_engine_part =
    | NEEngine
    | NEControl
    | NEBridge
    | NEAsk
    | NESettle
    | NEAwait
    | NEAbandon
    | NEStack
    | NEThreads
    | NELoop
    | NEClaim
    | NEValidated
    | NERead
    | NEFill
    | NEAnnounce
    | NEFamily
    | NESpawn
    | NEDrain
    | NECheck
    | NEClose
    | NEConflict

:~ info_of_hs_engine (p : hs_engine_part) : part_info region =
    ?= p ?|
    | NEEngine => { key = "e_engine"; region = RHsEngine; kind = Class; title = "Engine(workers)"; detail = "owns control scheduler, contexts, table, guard, graph, worklist, threads" }
    | NEControl => { key = "e_control"; region = RHsEngine; kind = Impl; title = "control Scheduler"; detail = "Hopac scheduler with NumWorkers = 1; all coordination runs here" }
    | NEBridge => { key = "e_bridge"; region = RHsEngine; kind = Impl; title = "bridge op"; detail = "Scheduler.run control op from a body thread; counts Bridges" }
    | NEAsk => { key = "e_ask"; region = RHsEngine; kind = Impl; title = "ask id op"; detail = "MVar.modifyFun guard (table.Decide), then wake the returned waiters" }
    | NESettle => { key = "e_settle"; region = RHsEngine; kind = Impl; title = "settle"; detail = "ClaimOp; on Wait -> await -> retry" }
    | NEAwait => { key = "e_await"; region = RHsEngine; kind = Impl; title = "await"; detail = "AddEdge to Graph; if accepted, read the IVar and RemoveEdge; else HopacsotaConflict" }
    | NEAbandon => { key = "e_abandon"; region = RHsEngine; kind = Impl; title = "abandon_chain"; detail = "AbandonOp for every key still in the context chain" }
    | NEStack => { key = "e_stack"; region = RHsEngine; kind = Impl; title = "lower_stack_limit"; detail = "reflection: Hopac.Core.Worker.ThreadStackLimit lowered for 1.5 GB stacks" }
    | NEThreads => { key = "e_threads"; region = RHsEngine; kind = Impl; title = "body threads"; detail = "workers x Thread('hopacsota-body-N', 1.5 GB stack), background" }
    | NELoop => { key = "e_loop"; region = RHsEngine; kind = Impl; title = "body_loop"; detail = "Take work -> run body -> abandon_chain -> report finished" }
    | NEClaim => { key = "e_claim"; region = RHsEngine; kind = Impl; title = "Engine.Claim"; detail = "ctx.Ready -> published snapshot -> settle; Taken -> push to Chain" }
    | NEValidated => { key = "e_validated"; region = RHsEngine; kind = Impl; title = "Engine.Validated"; detail = "like Claim without writing pending" }
    | NERead => { key = "e_read"; region = RHsEngine; kind = Impl; title = "Engine.Read"; detail = "ctx.Ready only; else compiler error" }
    | NEFill => { key = "e_fill"; region = RHsEngine; kind = Impl; title = "Engine.Fill"; detail = "FillOp; cache in Ready; leave Chain" }
    | NEAnnounce => { key = "e_announce"; region = RHsEngine; kind = Impl; title = "Engine.Announce"; detail = "AnnounceOp(usable); leave Chain if usable" }
    | NEFamily => { key = "e_family"; region = RHsEngine; kind = Impl; title = "Engine.Family"; detail = "per-context local table; FamilyOp create under the guard" }
    | NESpawn => { key = "e_spawn"; region = RHsEngine; kind = Impl; title = "Engine.Spawn"; detail = "Ch.give work (Spawn(body, Chain @ Inherited))" }
    | NEDrain => { key = "e_drain"; region = RHsEngine; kind = Impl; title = "Engine.Drain"; detail = "Drain request; rethrow the first body crash" }
    | NECheck => { key = "e_check"; region = RHsEngine; kind = Impl; title = "Engine.Check"; detail = "conflicts + cycles > 0 or FORCE_CONFLICT -> raise HopacsotaConflict" }
    | NEClose => { key = "e_close"; region = RHsEngine; kind = Impl; title = "Engine.Close"; detail = "Stop, join threads, stats line, kill scheduler" }
    | NEConflict => { key = "e_conflict"; region = RHsEngine; kind = Err; title = "exception HopacsotaConflict"; detail = "raised by await (cycle) or Check" }

:| hs_table_part =
    | NTTable
    | NTDecide
    | NTEntry
    | NTState
    | NTOps
    | NTReplies
    | NTPublished
    | NTGuard

:~ info_of_hs_table (p : hs_table_part) : part_info region =
    ?= p ?|
    | NTTable => { key = "t_table"; region = RHsTable; kind = Class; title = "Table()"; detail = "entries: Dictionary<obj, Entry>; counters named/conflicts/abandoned" }
    | NTDecide => { key = "t_decide"; region = RHsTable; kind = Impl; title = "Table.Decide id op"; detail = "the only place keys change state" }
    | NTEntry => { key = "t_entry"; region = RHsTable; kind = Data; title = "Entry(owner, marker)"; detail = "State + Waiters: IVar<unit> list" }
    | NTState => { key = "t_state"; region = RHsTable; kind = Data; title = "EntryState"; detail = "Evaluating -> Announced | Filled | Abandoned" }
    | NTOps => { key = "t_ops"; region = RHsTable; kind = Data; title = "TableOp"; detail = "ClaimOp | FillOp | AnnounceOp | AbandonOp | FamilyOp" }
    | NTReplies => { key = "t_replies"; region = RHsTable; kind = Data; title = "TableReply"; detail = "Taken | Present | Again | Wait | Written | Family | Failed" }
    | NTPublished => { key = "t_published"; region = RHsTable; kind = Data; title = "published"; detail = "ImmutableDictionary via Volatile.Write; lock-free reads by every thread" }
    | NTGuard => { key = "t_guard"; region = RHsTable; kind = Data; title = "MVar<Table> guard"; detail = "serializes Decide calls" }

:| hs_graph_part =
    | NGGraph
    | NGReq
    | NGCh

:~ info_of_hs_graph (p : hs_graph_part) : part_info region =
    ?= p ?|
    | NGGraph => { key = "g_graph"; region = RHsGraph; kind = Class; title = "Graph()"; detail = "waits_on: Dictionary<int, int>; cycles counter" }
    | NGReq => { key = "g_req"; region = RHsGraph; kind = Data; title = "GraphRequest"; detail = "AddEdge(waiter, owner, accepted) | RemoveEdge | CountCycles" }
    | NGCh => { key = "g_ch"; region = RHsGraph; kind = Data; title = "Ch<GraphRequest> edges"; detail = "foreverServer" }

:| hs_work_part =
    | NWList
    | NWReq
    | NWSettle
    | NWCh

:~ info_of_hs_work (p : hs_work_part) : part_info region =
    ?= p ?|
    | NWList => { key = "w_list"; region = RHsWork; kind = Class; title = "Worklist(tokens)"; detail = "queue, idle IVars, outstanding, drained" }
    | NWReq => { key = "w_req"; region = RHsWork; kind = Data; title = "WorkRequest"; detail = "Spawn | Take | Drain | Stop" }
    | NWSettle => { key = "w_settle"; region = RHsWork; kind = Impl; title = "Worklist.Settle"; detail = "hand queued bodies to idle threads while tokens > 0" }
    | NWCh => { key = "w_ch"; region = RHsWork; kind = Data; title = "Ch<WorkRequest> work"; detail = "foreverServer" }

:| hs_ctx_part =
    | NCCtx
    | NCTl

:~ info_of_hs_ctx (p : hs_ctx_part) : part_info region =
    ?= p ?|
    | NCCtx => { key = "c_ctx"; region = RHsCtx; kind = Data; title = "BodyContext(id)"; detail = "Marks, Ready, Families, Nesting, Chain, Inherited, counters, Crashes" }
    | NCTl => { key = "c_tl"; region = RHsCtx; kind = Data; title = "ThreadLocal context"; detail = "root context 0 + one per body thread" }

:| diverge_part =
    | NDOrder
    | NDErr
    | NDPrint
    | NDRec
    | NDConf
    | NDNest
    | NDGlobals
    | NDSame

:~ info_of_diverge (p : diverge_part) : part_info region =
    ?= p ?|
    | NDOrder => { key = "d_order"; region = RDiverge; kind = Note; title = "Order"; detail = "SF: depth first, a body runs where it is met. HS: annotated bodies are deferred; markers keep their place; Finish restores the canonical order" }
    | NDErr => { key = "d_err"; region = RDiverge; kind = Note; title = "Errors"; detail = "SF: the first exception propagates. HS: a failure becomes a 'fail' marker; Finish raises the first one in canonical order" }
    | NDPrint => { key = "d_print"; region = RDiverge; kind = Note; title = "Printing"; detail = "SF: printfn immediately. HS: buffered as 'print' markers and replayed in order" }
    | NDRec => { key = "d_rec"; region = RDiverge; kind = Note; title = "Recursion"; detail = "SF: re-entering an owned key finds the pending value: unannotated -> 'Recursive join points must be annotated'; announce made the annotated type usable. HS: AnnounceOp also releases threads waiting on the key" }
    | NDConf => { key = "d_conf"; region = RDiverge; kind = Note; title = "Conflicts"; detail = "SF: impossible. HS: a wait-for cycle or a foreign claim of an abandoned key -> HopacsotaConflict -> whole peval rerun with inline_restart = true (single-flight order)" }
    | NDNest => { key = "d_nest"; region = RDiverge; kind = Note; title = "Counters"; detail = "SF: one shared uninhabited counter. HS: Nesting per BodyContext; dynamic_if/validating saved and zeroed per body" }
    | NDGlobals => { key = "d_globals"; region = RDiverge; kind = Note; title = "Validation globals"; detail = "SF: validation_root_globals for the build backend. HS: s.globals of the current key body" }
    | NDSame => { key = "d_same"; region = RDiverge; kind = Note; title = "Same result"; detail = "both builds must emit byte-identical code; the tables passed to codegen are the same Dictionary instances" }

:| codegen_part =
    | NCgAdapter
    | NCgUtils
    | NCgDead
    | NCgUnused
    | NCgRefc

:~ info_of_codegen (p : codegen_part) : part_info region =
    ?= p ?|
    | NCgAdapter => { key = "cg_adapter"; region = RCodegen; kind = Seam; title = "CodegenAdapter (L12478)"; detail = "codegenMethodBody / codegenClosureBody read join_point_method/closure" }
    | NCgUtils => { key = "cg_utils"; region = RCodegen; kind = Fn; title = "CodegenUtils (L12005)"; detail = "CodegenEnv, line/indent, generated names" }
    | NCgDead => { key = "cg_dead"; region = RCodegen; kind = Fn; title = "DeadPureLetElision (L12296)"; detail = "drops pure lets before emit" }
    | NCgUnused => { key = "cg_unused"; region = RCodegen; kind = Fn; title = "UnusedGlobals.prune (L12260)"; detail = "prunes result.globals" }
    | NCgRefc => { key = "cg_refc"; region = RCodegen; kind = Fn; title = "RefCounting (L24644)"; detail = "refc_prepass for C" }

