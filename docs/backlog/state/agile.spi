inl fiscal_ro_cius () = Task ("FISCAL-RO-CIUS", "Romania ANAF RO_CIUS 1.0.9 (EN16931 CIUS) schematron over UBL", Story, P2, D4, 40u32, Active, "XSD-IMPORTED-NAMESPACE-ELEMENTS", "fiscal,generic,country,team:fiscal", "current", "current")
