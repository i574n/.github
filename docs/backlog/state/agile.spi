inl kit_fold_process_health () = Task ("KIT-FOLD-PROCESS-HEALTH", "Fold i574n.github process-health scripts (orphan-reaper, dangling-census, host-dupes-census, node-watch, node-utilization-monitor) into the kit machine watch family", TaskKind, P2, D3, 35u32, Active, "", "team:rig,kit,scripts,cleanup", "current", "current")
