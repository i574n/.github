inl xsd_facet_types () = Task ("XSD-FACET-TYPES", "xsd_emit: XSD builtins become real types (decimal.decimal, i64, bool, date nominals); facet-free restrictions alias their parent; totalDigits/fractionDigits/min/max facets validated", Story, P0, D5, 65u32, Active, "FISCAL-EDITION3-ROUND,XSD-FACET-DIGITS,XSD-FACET-BOUNDS", "team:fiscal,fiscal,xsd,typefeatures,codegen,team:fiscal", "current", "current")
