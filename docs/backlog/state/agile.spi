inl cells_rust_opt_level () = Task ("CELLS-RUST-OPT-LEVEL", "Cells compiles every Rust test cell at opt-level=2; measure 0/1/2 and cut gate CPU (a 6.9 MB fiscal cell took 83+ CPU-min)", Story, P1, D3, 0u32, Planned, "", "cells,main,cpu,node,team:org,team:microblog", "current", "current")
