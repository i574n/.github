inl showcases_spiral_vs_rust () = Task ("SHOWCASES-SPIRAL-VS-RUST", "Bring the browser session's six compiled Spiral-vs-Rust showcases into the spiral repo as reproducible samples, each with the best stable-Rust attempt and its real rustc error: GADT rules interpreted away (S1), policies with hidden stages (S2), one rule as validation/simulation/audit via HKT (S3), type-level decimal scales (S4), audit diffs by reflection (S5), one fiscal kernel emitted to 6 languages (S6); S7 (post-CIC proofs) stays vision", Story, P2, D4, 0u32, Planned, "SHOWCASE-S1-GADT-RULES,SHOWCASE-S2-HIDDEN-STAGES,SHOWCASE-S3-HKT-RULE,SHOWCASE-S4-DECIMAL-SCALES,SHOWCASE-S5-REFLECTION-DIFFS,SHOWCASE-S6-SIX-LANGUAGES", "samples,showcase,rust,typefeatureset,main,team:org", "current", "current")
