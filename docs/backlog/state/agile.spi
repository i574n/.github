inl lib_otp_name () = Task ("LIB-OTP-NAME", "lib/spiral: wrap process.Name(msg) as a typed name handle that survives a supervisor restart, and address supervised actors by name instead of by subject", Story, P1, D3, 100u32, Done, "LIB-OTP-PINS,LIB-OTP-ACTORS", "lib,gleam,otp,backends,wipe-redo", "current", "current")
