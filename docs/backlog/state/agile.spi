inl compiler_win_stack_overflow () = Task ("COMPILER-WIN-STACK-OVERFLOW", "Windows: SpiralCompilerCore stack overflow (0xC00000FD) compiling large fiscal units to Rust; Linux passes", TaskKind, P1, D4, 100u32, Done, "", "compiler,windows,rust,fiscal,ci", "current", "current")
