union task_kind =
    | Epic :: task_kind
    | Feature :: task_kind
    | Story :: task_kind
    | TaskKind :: task_kind

union priority =
    | P0 :: priority | P1 :: priority | P2 :: priority | P3 :: priority | P4 :: priority | P5 :: priority

union difficulty =
    | D0 :: difficulty | D1 :: difficulty | D2 :: difficulty | D3 :: difficulty | D4 :: difficulty
    | D5 :: difficulty | D6 :: difficulty | D7 :: difficulty | D8 :: difficulty

union task_status =
    | Planned :: task_status | Active :: task_status | Blocked :: task_status | Paused :: task_status | Done :: task_status

union agile_item =
    | Task :: string * string * task_kind * priority * difficulty * u32 * task_status * string * string * string * string -> agile_item

inl eoie_dogfood () = Task ("EOIE-DOGFOOD", "Use eoie for our agile backlog and tool runs with the compiler configured, and fix every friction so it beats Claude Code tools: (1) unbounded/renewing lease on local machines, configurable, no per-lease reports (user); (2) help and inspection never blocked by an expired lease, accept --help on every verb; (3) agile list renders a table (id, P, D, %, status, title) instead of raw .spi lines; (4) agile status shows local times and remaining minutes instead of unix ms; (5) agile add to create tasks; (6) agile init scaffolds a root (state/, package.spiproj with agile+prompt); (7) actionable package-graph errors (|core- in state package was rejected without a reason); (8) record-preflight must not demand eoie release files (history, ratings, bench, migration) from a plain backlog root; done 2026-10-08: (1) EOIE_LEASE_POLICY=renewing, (5) agile add, (9) agile edit, (3) in progress; acceptance bar: every verb beats its pwsh counterpart: elapsed time, counts, bytes, exit code, stderr digest, cache hits in every result; aligned human output plus --json; diagnostics that run the obvious intent instead of only suggesting it; findings (9) agile edit for descriptions/notes; (10) eoie help <capability> should show proxy help instead of exit 2; (11) normalize path separators in outputs (root\\\\.github/x); (12) say expected vs received argument count on bad arguments; (13) dev.ps1 should accept module names (agile_state_runtime_policy_domain) as well as package names; (14) a failed cargo check must surface the first rustc error, not only 'Cargo rejected regenerated EOIE owners'; (15) fs-search must accept '.' as the root itself; 08:2x done: (3) agile list table sorted by priority with status counts and elapsed_ms, (9) agile edit; new findings (16) text-replace needs --all/--expect N for multi-match edits; (17) EOIE_LEASE_POLICY should also come from the eoie config file (shells started before the user env var miss it); (18) fs-remove prints nothing on success; (19) list header % column off by one; (20) inspection (text-replace check) still lease-blocked; 08:4x done: (4) agile status shows phase, policy and relative times (started=2h49m_ago) beside the raw unix fields, (17) lease policy from <config>/eoie/lease-policy (this machine: renewing) with EOIE_LEASE_POLICY still first, (19) list header aligned, (20) text-replace check / *-preview modes are inspections (effect key verb:sub:mode, lookup moved from rust_global into Spiral crate agile_lease_terms); contract tests isolate EOIE_LEASE_POLICY and EOIE_CONFIG_HOME; 08:5x done: (2)+(10) --help/-h anywhere after a verb or subcommand and help <capability> answer with exit 0 before the lease guard (Spiral help_request union in command_spec_domain); left: (6) agile init, (7) package-graph errors, (8) record-preflight, (11) path separators, (12) arg-count diagnostics, (13) dev.ps1 module names, (14) cargo error surfacing, (15) fs-search ., (16) text-replace --all, (18) fs-remove receipt, enriched outputs everywhere; 08:5x done: (6) agile init <root> scaffolds state/package.spiproj + the typed agile.spi schema (Spiral crate agile_backlog_scaffold, Renew effect like begin); init -> begin -> add -> check verified on a fresh root; 09:1x done: (12) agile arity errors name the expected shape and received operand count, (16) text-replace migrated from the legacy rust_global arm to Spiral crate proxy_text_replacement: --expect N / --all, typed mode/expectation unions, rooted path via rust_std_fs (finding 11 for this verb), atomic replace + readback, receipt with matches/expected/bytes/elapsed_ms; 09:2x done: (18) fs-remove migrated to Spiral crate proxy_file_removal with a receipt (path, kind file|symlink, bytes, elapsed_ms) and typed rejections (missing, directory -> use fs-remove-tree, root escape), (15) fs-search <root> . searches the root (Spiral search_scope union; . stays rejected for mutating verbs so fs-remove-tree . cannot wipe a root); left: (7) package-graph errors, (8) record-preflight, (13) dev.ps1 module names, (14) cargo error surfacing, enriched receipts on the remaining legacy verbs; 09:4x done: (13) dev.ps1 accepts crate directory names and underscored names (resolved to Cargo package names, unknown names still rejected), (14) a failed cargo check now puts the first rustc error block into the thrown message; left: (7) package-graph errors, (8) record-preflight wording for plain backlogs, enriched receipts on the remaining legacy verbs; 09:5x done: proxy run/command failures are no longer reported as usage errors: a child that exits N makes eoie exit N with a plain error after its receipt (Spiral crate proxy_failure_classification: ArgumentFailure | ChildProcessFailure), misuse still exits 2 with usage; evidence renewed ready=True at 09:41 (before this change: renew again at end of day); 10:1x done: agile list <root> [filter] --json emits one JSON document {tasks[], shown, filter, counts{planned,active,blocked,paused,done}, elapsed_ms} (listing_format union; status census split into Spiral crate agile_task_census and scan helpers moved into agile_task_text to stay under the 1000-line crate gate); quotes and backslashes round-trip; raw tabs in titles are not escaped yet (spi_escaped lacks \\t); 10:5x done: (7) the compiler host now says which packages failed and why a |core- packages: entry fails (SPIRAL_COMPILER_PACKAGE_DIR or a deps/The-Spiral-Language clone); verified: with the variable set the same backlog checks clean (spiral dev24); 10:4x done: (8) agile check prints \"records catalog=v1 present=0/4 missing=... (agile check does not need them)\" from the new typed crate agile_record_catalog (RecordCatalogComplete | RecordCatalogPartial), replacing the ready=0 text in the rust_global blob; spi_escaped escapes tabs; eoie_agile_state.spi unchanged vs HEAD; 195/195; 11:0x receipts: fs-copy migrated whole into typed crate proxy_file_copy (elapsed_ms, precise rooted errors kept); agile set receipt from typed crate agile_update_receipt (bytes_before/after + elapsed_ms like agile edit); parallel-search accepts . as the whole root; workspace_primitives.rooted shares proxy argument + root confinement (fs-remove/text-replace regenerated byte-identical); 195/195. Next: parallel-search receipt elapsed, hit-limit truncation instead of abort (needs inspection_collect migrated out of rust_global); 12:5x parallel-search: new typed receipt crate proxy_search_receipt shows serial_ms/parallel_ms/elapsed_ms; it exposed a 111 s search of eoie/src (src/target = 61,538 files, 11.7 GB of build output); the search walk now skips build output (typed search_directory: .git, node_modules, CACHEDIR.TAG or .rustc_info.json) and the receipt says excludes=...: 1.5 s, same 7 hits; hash-tree/manifest walks unchanged; 195/195; 13:1x parallel-search over max-hits truncates deterministically instead of aborting (each subtree keeps limit+1, serial/parallel parity holds) and the typed receipt says hits=N truncated=true found_at_least=N+1 (hit_budget union); fs-search, which has no receipt, keeps an explicit error naming EOIE_SEARCH_MAX_HITS; 195/195; 16:37 evidence renewed after the afternoon batch (chain.ps1 -SkipBuild, label r1008b): cold renewal 119/119 chains, agile check --compiler exit 0, closeout applied, strict preflight -RequireReady ready=True diagnostics=0 (the pre-closeout gates rejected the stale Cargo.toml/Cargo.lock receipts the new crates changed, as expected); 17:0x new verb proxy command-output <root> <timeout-ms> <program> [args...]: prints the child stdout/stderr directly, then a typed receipt (crate proxy_command_output: ok|child-failed status elapsed_ms stdout_bytes stderr_bytes) and propagates the child exit code; replaces the command-capture + read-receipt two-step for git reads; registered in usage/help/lease (nested eoie child at index 4) and legacy surface; lesson: proxy_direct_route_names is positional (route code = index), legacy-dispatched verbs stay out of it; 195/195; 17:04 evidence renewed again after command-output (label r1008d): cold renewal, agile check --compiler exit 0, strict preflight ready=True diagnostics=0; 17:4x parallel-search aborted on the first symlink child (refusing symlink: dice\\deps\\polyglot), so whole-repo searches of dice/polyglot failed; symlink children are now a typed SymlinkEntry (not descended, receipt excludes=...,symlinks) while a symlinked start path still errors; dice searches 0.2 s; 195/195; eoie changed again, evidence renewal due; 18:16 evidence renewed after the symlink fix: strict preflight ready=True diagnostics=0; 10-11 21:3x landed the fs-search receipt (the gap named at 13:1x): proxy_search_receipt/search_receipt.spi grew fs_search_receipt_text plus its eoie_fs_search_receipt_text export, parallel_search_contract/search_terminal.spi times inspection_search (started before collect, found captured before the consuming loop) and prints after the hits, dev.ps1 -Publish emitted 2/2, passed cargo check and its tests and published the 2 changed owners, the eoie-cli debug build exited 0 carrying the downstream crates with it, and a real run on a scratch root prints eoie proxy fs-search ok hits=2 excludes=.git,node_modules,build-output,symlinks elapsed_ms=3 with exit 0 (the first draft printed a double space after ok, fixed and re-regenerated before the recorded run); receipts now cover agile set, command-output, parallel-search, text-replace, fs-remove, fs-copy and fs-search, while fs-slice, fs-context, hash and hash-tree still print bare output in search.rs and parallel-manifest has an ok-line but no elapsed_ms; 4 files changed unstaged (search_receipt.spi, search_terminal.spi, search_receipt.rs, search.rs), cargo test --workspace green at 21:40 (214 suites, 178 passed + 17 ignored = 195, 0 failed, exit 0), and the measured evidence debt at 21:45: test-strict-preflight.ps1 reports ready=False diagnostics=3 with bundle error evidence currentness evidence tree identity mismatch path=src (expected dbb103fa..., observed 44b84681...) plus ColdProofV4 census drift expected=21544 observed=21550, the drift being exactly the 6 spiral lines this change added, so evidence renewal via the formal-receipts-renew and census-gate path stays due; the two published .rs diffs also carry regeneration drift these files had not yet picked up, enum variants renamed readable (US0_0 to US0_AllHitsShown, and to US0_SourceDirectory, BuildOutputDirectory, VersionControlDirectory, PackageInstallDirectory, SymlinkEntry) plus new impl Default blocks, only 3 of the 42 added search.rs lines being the receipt itself, all of it compiling and covered by the green suite; 2026-10-12 05:31Z: fs-slice fs-context hash hash-tree get receipts and parallel-manifest gets elapsed_ms via Spiral emitters in proxy_search_receipt (hash receipts on stderr so stdout stays the digest); build.ps1 -Test 178 passed 0 failed 17 ignored; dev.ps1 splits comma package lists; 2026-10-12 06:10Z: help proxy now lists formal-receipts-renew and coverage-register; build.ps1 -Test -CompilerContracts 195 passed 0 failed; renewal chain (agile begin, renew-cold-rebuild -Apply, agile check --compiler, staged census + release-closeout apply) gives strict preflight ready=True diagnostics=0; 2026-10-12 06:48Z: agile edit title-append now joins with \"; \" unless the text starts with punctuation (field rendering split into typed crate agile_field_rendering, which also brings agile_task_revision back under the 1000-line gate); rooted paths print native separators; fs-read gets a stderr receipt (bytes, shown, truncated, no_final_newline, elapsed_ms), fs-list a stdout receipt, fs-write and fs-remove-tree elapsed_ms (crate proxy_file_receipt); text-replace usage names --all/--expect; renewal chain scripted as compiler-contracts/renew-strict-evidence.ps1; 2026-10-12 08:16Z: new inspection agile show <root> <id> (crate agile_task_inspection: full unescaped title, deps, tags, receipt); renew-strict-evidence.ps1 now renews the owner growth receipt (new crates agile_field_rendering, proxy_file_receipt, agile_task_inspection) and ran end to end: build.ps1 -Test -CompilerContracts 195 passed 0 failed, strict preflight ready=True diagnostics=0, eoie.exe cb2b3aed; a first run hit the 15 s cold owner budget under load (16.7 s), passing at -ParallelChains 2; 2026-10-12 09:25Z: fs-list moved whole into typed crate proxy_directory_listing, fs-copy-tree gained elapsed_ms, renewal retries the cold budget at fewer chains; 195/0, strict preflight ready=True, eoie.exe ef711a26; 2026-10-12 10:20Z: agile show --json, full proxy help list, renewal stops early on unrenewable diagnostics; final eoie.exe f2d681ff, 195/0, ready=True; 2026-10-12 11:29Z: fs-read moved whole into typed crate proxy_file_reading (streamed, byte-exact), fs-search truncates like parallel-search; 195/0, ready=True, eoie.exe 2a3eeee3; 2026-10-12 12:05Z: fs-read now fails (exit 2) on stream or flush errors; final eoie.exe ce371e74, 195/0, ready=True; 2026-10-12 08:17 lane closed by its agent: receipts, agile show, fs-read/fs-list typed crates, renew-strict-evidence.ps1, strict preflight ready=True (cee3a96); follow-ups in EOIE-REGEN-DRIFT", Epic, P0, D6, 100u32, Done, "", "eoie,dogfood,agile", "current", "current")
inl readable_generated_names () = Task ("READABLE-GENERATED-NAMES", "Generated code as human readable as possible on every backend: functions, unions, union cases, layouts and closures named after their Spiral source (join point, method and type names) instead of method12, U3, closure7; the numeric index only on name collisions or where inlining and join points leave no name; local names inside bodies derived from the Spiral bindings where possible. Performance first: naming must not change codegen shape or runtime cost; oracle outputs keep agreeing while residual hashes change once; build the naming as an onion layer (our own naming pass the backends consult) so upstream codegen diffs stay small; 2026-10-08 investigation: names already exist: LangEnv.join_point_method_key_names / join_point_closure_key_names map each join point key to its Spiral name (used for EJP diagnostics) but PartEvalResult does not expose them; 34 naming sites (method{tag}/closure{tag}) across ~12 backends, C/F#/Python/Cuda are upstream sections; plan: expose the tables in PartEvalResult (both cores), one GeneratedNames section maps tag -> sanitized source name (+ suffix on collision, deterministic in tag order), backends call it; upstream sections need a one-call hook each (decide with the upstream onion move); then one reviewed re-bless; 2026-10-08 14:2x correction: the names already flow: single-flight stores jp_name in each join_point_method entry, hopac in JpMethodBodyCellReadyPayload, and C/Cpp (upstream) already emit them (loop, score, derivative...; anonymous join points stay method{n}); the other backends dropped them with | body, range, _ ->; slice 1: generatedMethodName (CodegenRust section: [A-Za-z0-9_] sanitized, {name}_{tag} so it cannot meet v{n}/closure{n}/US0_ names; Gleam lowercased) used by Rust, Delphi, Zig, Lean, Bend, Gleam, Lua, TypeScript, Python through a per-codegen tag->name map; dev review: 2,018 jobs, no regression, DISAGREE 0, 286 changed rows proven identical after name normalization, the rest Bend prelude/helper names derived from method names; F# left: CodegenFsharp precedes generatedMethodName and codegenMethodBody (move the helper earlier), and hopac F# drops methodName at the cell classification (167864/167872, CodegenJpMethodBodyCellReady has no name; its codegen uses concurrent collections); 15:2x blessed (dev28 deployed): 2,018 rows, review = bless run row for row, 338 changed rows all renames (fn method0 -> fn fib_0; stems seen: loop, score, derivative, make_star, regex_compare, canonical_derivative); F# in both cores implemented (helper moved to the end of CodegenUtils; hopac carries (range, sourceName) through the generic cell unions), build + review next; 16:0x F# blessed (dev29): 41 rows changed, 39 proven rename-only vs HEAD (2 format_any carry the blessed renumbering), renamed .fsx run in dotnet fsi exit 0 (the harness only compiles F#); now every backend names functions after the Spiral source (C/Cpp {name}{tag}, the rest {name}_{tag}); upstream export: CodegenC/CodegenFsharp/CodegenUtils clean, CodegenPython 2 conflicts (section already differs from the fork there); next slices: closures (closure{n}) and union/layout names; closures next: single-flight stores names only for methods (165470); closure entries are (domain_args, body), hopac keeps closure names only in join_point_closure_key_names (diagnostics); closure naming needs PartEval to store a name in the closure entry (upstream section) before any backend can use it; 18:0x found by the dice regression build: join points named after operators (e.g. |>) sanitized to underscore-only names (fn ___9, def ___3); generatedMethodName now falls back to method{tag} unless the source name has a letter or digit; suite review all parity (no sample has operator-named join points), deployed dev30 (both cores), dice outputs regenerated; 01:4x union case names slice: generatedCaseNames/generatedCaseSuffixes (CodegenUtils, next to generatedMethodName: sanitized Spiral case name, index only on collision or when nothing readable remains) used by Rust (enum variants US0_Some), Zig and Delphi (constructor functions), TypeScript (case types and constructors); union type names stay US0/UH0 and runtime tags stay numeric; dev review single-flight-20261009-013031: DISAGREE 0, 126 changed rows (Rust 34, Zig 35, Delphi 32, TypeScript 25) all rename-only after case-name normalization, natives agree; left: Lua (its case name doubles as a runtime string tag Uh0i1), Lean/Gleam/Bend (no per-case constructor names), upstream C/F#/Python, closures; 02:44 Lua slice blessed (Uh0_Cons, incl. runtime tag strings; 32 Lua rows rename-only; main oracle 2183 rows, repro 0); Lean (U0.Cons) + Gleam (Uh0Cons) slice in review; 03:34 Lean (U0.Cons) + Gleam (Uh0Cons) blessed (57 rows rename-only; main oracle 2183, repro 0); F# slice (both cores, UnionTag as a match) in review; 04:25 F# blessed (UH0_Cons in both cores; UnionTag now a match, was a Map that could not compile for cases with fields; 47 rows rename-only, fsi compile-checked; main oracle 2183, repro 0); C + Python (tag-keyed names) in review; left: C++/CUDA struct names, Bend, closures; 05:20 C + Python blessed (tag-keyed generatedCaseNameOfTag; 53 rows rename-only, every backend still agrees with the renamed C oracle; repro 0); Bend (U0_Cons) in review; left: C++/CUDA structs (Union0_0), closures; 06:15 Bend blessed (U0_Cons; 27 rows rename-only, all agree; repro 0). Union case names now readable in Rust, Zig, Delphi, TypeScript, Lua, Lean, Gleam, F# (both cores), C, Python, Bend. Left: closure names on backends other than Rust. 2026-10-10 C++/CUDA case structs use the Spiral case name (Union0_Hit, Union0_Miss, Union0_Nil, Union0_Cons). The outer type stays Union{i}, the field stays case{n}, and the runtime tag stays the number. single-flight-20261010-173754, hopac-20261010-174528, and single-flight-20261010-174600 agree with C, DISAGREE 0. Not blessed. Rust, Kotlin, Swift and TypeScript closures from a named inl binding emit stem_c tag (fn f_c0, fun f_c0, func f_c0, function f_c0); anonymous closures stay closure n. Rust: single-flight-20261011-070642, hopac-20261011-071623, and restore single-flight-20261011-072251 agree with C, DISAGREE 0 (C and Rust). Kotlin, Swift and TypeScript: single-flight-20261011-073934, hopac-20261011-095228, and restore single-flight-20261011-101905 each ran the C+Kotlin+Swift+TypeScript examples suite (1052 ran, 10 build-fail, oracle agree 609, DISAGREE 0, hopac missing 0, script exit 0), and the restore is row for row identical to single-flight-20261011-073934 (0 of 1,092 rows differ). Zig, Lean, Bend, Gleam, Lua, Wasm and Delphi closures: single-flight-20261011-122112, hopac-20261011-123041, and restore single-flight-20261011-124049 each ran the C+Delphi+Zig+Lean+Bend+Gleam+Lua+Wasm examples suite (1650 jobs, 12 build-fail, oracle agree 1140, DISAGREE 0, hopac missing 0, regressed 0, broken 0, script exit 0), and the restore is row for row identical to single-flight-20261011-122112 (0 of 1,650 rows differ). Left: closures on the remaining backends (C, Python, C++/CUDA). Not blessed. 2026-10-11 F# (both cores) and Python closures use the source name: {stem}_c{tag} (let rec f_c0 / def f_c0), closure{n} or Closure{n} otherwise. F# through a closure_names memo (ConcurrentDictionary hopac / Dictionary single-flight) filled from closureSourceName at the closure join point (JpBodyOwnerIdentity.body jp_body in hopac, snd jp_body in single-flight); Python through a name field on ClosureRec taken from the source name codegenClosureBody already returns. Python is natively compared to C; F# is not (test.ps1 excludes Fsharp from the native jobs), so F# is compile-checked by the suite and 16 closure samples probe-run in fsi exit 0. single-flight-20261011-140929, hopac-20261011-141813, and restore single-flight-20261011-142157 each ran C+Fsharp+Python examples -Native: 814 jobs, oracle agree 19, DISAGREE 0, hopac missing 0, regressed 0, broken 0, script exit 0; the restore reproduces single-flight-20261011-140929 row for row (0 of 814 rows differ). The only residual changes are the closure names (F# portable_convert_parse; Python portable_convert_parse, ts_closure_capture, ts_closure_return, all still agreeing with C). 2026-10-11 C closures use the source name: {stem}_c{tag} when the closure comes from a named inl binding (int32_t f_c0), closure{n} otherwise. codegenClosureBody already returned the source name (the C section dropped it with _ before); the ClosureRecC carries a name field and the closure body function is generatedClosureName name tag. The env struct Closure{i}, the factory ClosureCreate{i} and the two decrefs stay tag-keyed, exactly as Zig keeps ClosureEnv{tag}/closureCreate{tag}. single-flight-20261011-152506, hopac-20261011-153643, and restore single-flight-20261011-154343 each ran C+Rust+Delphi+Python examples -Native: 1276 jobs, 1196 native ran, 12 build-fail, oracle agree 745, DISAGREE 0, hopac missing 0, regressed 0, broken 0, script exit 0; the restore reproduces single-flight-20261011-152506 row for row (0 of 1276 rows differ). The only residual changes are the C closure body names on the 99 samples that define a closure (closure_apply ClosureMethod0 -> f_c0, closure_curry -> closure1); every backend still agrees with C. Left: closures on C++/CUDA; 10-11 20:5x scoped so the call is decidable: generatedClosureName (spiral_compiler.fs 167281, yields stem_cTag and closureTag for anonymous) is called from 15 sites covering C (179175, cname for the closure method) and Python (181197) plus the middle backends, but the CodegenCpp.fs upstream section (header at 179552, pinned @ 0cb0fda0 host_cpp_and_cuda_backend) calls it zero times and both its backends name closures as tag-only struct types: 179881 constructs local Closure{tag}, 180004 news Closure{tag} behind a ClosureBase{tag} csptr, 180295 emits struct Closure{tag} : public ClosureBase{tag}, 180321 the device constructor, 180329 the device destructor. Unlike C, where the readable name attaches to the method while the struct stays Closure{tag}, C++ and CUDA emit operator() (180305-180306) so there is no method name to rename: only the struct type is a candidate, it must stay paired with a ClosureBase{tag} built from the independent cfun tag space (180294), it sits in a section the upstream sync replaces wholesale so every differing line needs a ws: marker, and renaming churns every emitted C++ and CUDA file; design call for the user. Not blessed.", Epic, P1, D6, 80u32, Active, "", "compiler,codegen,readability,est:600m,load:heavy,agent:pair", "current", "current")
inl node_to_bun () = Task ("NODE-TO-BUN", "Use bun only, no node: spiral harness TypeScript tier (env.ps1 Node, test.ps1, native-shims/run_main.mjs worker + stack size), Kino toolchain.ex TypeScript cells, CI setup-node in spiral/polyglot/dice/i574n.github gh-pages.yml and gitlab node -v; verify every TypeScript row agrees with the C oracle under bun first; 22:1x closed: full suite single-flight-20261008-215335 runs all 117 TypeScript rows under bun, 117 agree with C; CI workflows in spiral/polyglot/dice/i574n.github use oven-sh/setup-bun only; remaining node references are vendored third-party (Fable, dotnet-interactive, hyperui, VS Code plugin) or untracked dist/ build copies", TaskKind, P1, D3, 100u32, Done, "", "bun,typescript,ci,kino", "current", "current")
inl ci_spiral_rust_run_check () = Task ("CI-SPIRAL-RUST-RUN-CHECK", "spiral Windows CI: apps/spiral/build.ps1 run check `spiral rust` exits 1 with no output; passes locally; stderr now printed, read it on the next push and fix; 07:03 push: run check passes (RUST-OK apps/spiral); next failure apps/wasm cargo via bash on Windows", TaskKind, P0, D4, 100u32, Done, "", "ci,spiral,windows", "current", "current")
inl ci_dice_e2e () = Task ("CI-DICE-E2E", "dice ubuntu e2e: playwright webServer ran through /bin/sh which expanded $job; named-job fix verified locally, confirm on the next push and walk the later steps; 07:03 push failed earlier at lib/spiral/common.fsx missing (fixed by FSX-FREE); 22:0x CI run 37854297989 (18:34 push): build (ubuntu-24.04) success, so the e2e fix holds; the windows job failure is the WSL contract path tracked in CI-SPIRAL-WASM-NATIVE", TaskKind, P0, D2, 100u32, Done, "", "ci,dice,linux", "current", "current")
inl bless_byte_to_i32_switch () = Task ("BLESS-BYTE-TO-I32-SWITCH", "Suite, review and bless the samples/core byte_to_i32 BackendSwitch (C identical modulo variable numbering) and the comment-free samples", TaskKind, P1, D2, 100u32, Done, "", "compiler,oracle", "current", "current")
inl bend_backend () = Task ("BEND-BACKEND", "Bend 2 backend named Bend, Windows-native toolchain (bun from source), as stable as Zig/Lean/Rust/C: IO codegen, unions, tuples, arrays, strings, closures, 8/16-bit ints, harness list; 2026-10-08 09:3x: 115/133 agree (was 72), 0 wrong: mutable aliased arrays as a one-slot Chan cell holding a power-of-two Bend Array (per-element-type helper set, O(log n) peek/swap, bounds abort 3), nested arrays, unions holding arrays/functions declared is Type, closures as lambdas over closure defs; harness Bend list 116 + Known bounds row; left: floats (Bend 2 has F32 only, no formatter), i64/u8, 2 raw-macro while samples, 1 macro sample; 10:1x blessed: review run and bless run identical on 2004 rows (6 FOR-D rows filtered by design), oracle now holds the 116 Bend rows; 10:2x: F32 (Bend F32 ops/compare, decimal literals with F32.neg/division for negatives, inf, nan, signed i32<->f32 helpers) -> 119/133 agree; deployed dev23; harness Bend list 120; left: f64 (no Bend F64; emulating it in F32 would change results), i64/u8, 2 mutable-layout samples, 2 raw-macro while samples, 1 raw-macro sample; 10:4x blessed C+Bend (350 rows; review and bless runs identical; the 116 earlier Bend residuals changed only by the 23-line F32 prelude); oracle holds 120 Bend rows; 13:2x coverage probe (test.ps1 -Suite examples -Native -Probe Bend, 229 Bend rows, outputs in the scratch dir): 119 agree (exactly the listed set) + 1 known, DISAGREE 0; the 108 others: 33 raw C macros/ABI, 16 negative samples rejected everywhere, 23 BackendSwitch records without a Bend key (while_* and native_cube_* assign through !!!!BackendSwitch: needs mutable locals; Rust/Python-specific samples; lib functions without Bend arms), f64 x5 (Bend 2 has only Nat/U32/F32: no faithful f64), u64 x2 (native_closure_union_rec, rust_static_closure_chain: Nat mod 2^64), the integer zoo ts_int_wrap (u8/i8 via U32 masking), layouts x4 (heap/mut records); next by unlock size: mutable locals for while/assignment, then u64 via Nat, then small ints; 17:5x u64 decision input: Bend 2 Nat is unary (type Nat: Zero | Succ, Nat.add/sub recurse per unit), so u64 via Nat is not viable; it needs a (U32, U32) two-word encoding with carry add/sub/mul and 64/32 long division, for 2 unlockable samples: parked", Feature, P1, D7, 92u32, Active, "", "backend,bend,est:240m,load:medium,agent:yes", "current", "current")
inl compiler_upstream_onion () = Task ("COMPILER-UPSTREAM-ONION", "Move the compiler into the upstream fork's repo with our changes as onion layers over mrakgr's files (PR-ready), one file per backend, splitter adapted for parallel builds; 2026-10-08 first upstream-ready patch: CodegenC (user globals reach C output; (void)x in empty decref bodies, 211 -Wunused-parameter -> 0 apart from one stale output), made line-local so scripts/upstream.py exports it cleanly (4 hunks): python scripts/upstream.py export deps/The-Spiral-Language HEAD <out> --since HEAD writes The Spiral Language 2/CodegenC.fs; opening the PR on the fork is the user's call; 18:2x readable-names + C patch material now durable at %LOCALAPPDATA%\\spiral-bin\\upstream-pr\\names-and-c (CodegenC, CodegenFsharp, CodegenPython, CodegenUtils); both CodegenPython conflicts resolved by intent (fork already carries the string option source name in join_point_method); upstream.py export fix: an addition after the last line of a section goes to the end of the target file (it was spliced between codegen_env and its members); generatedMethodName uses System.Char (CodegenUtils opens only System.Text); verified by a differential build of the fork (unpatched vs patched, external includes restored from history): 0 patch-only errors, with a canary type error proving fsc reaches the codegen files past the unrelated lib/fsharp/Common.fs errors; 21:1x CodegenC now emits the backend standard includes before user globals (Seq.append globals env.globals |> Seq.distinct): user globals using bool/size_t no longer precede <stdbool.h>; dev review: only the include order changed in the 2 samples with C globals (Lean exit=-1 rows were load kills, parity alone); deployed dev32 both cores; patch material CodegenC.fs refreshed (export --since 98492a63, since the 18:34 commit moved HEAD past the names work); 19:4x two fresh candidate exports exist for the next curation pass, both exit 0 against the fork clone at polyglot/deps/The-Spiral-Language: names-and-c-194526 (export --since HEAD, so only tonight's uncommitted edits, 45634 bytes, carries the closure void-cast fix at lines 616-617 but not the committed globals fix) and names-and-c-full-194526 (export --since 98492a63, the documented PR base, 46185 bytes, carries all three: the void-cast fix, the Seq.append globals env.globals fix from C-USER-GLOBALS-DROPPED and generatedClosureName from the readable-names work); both report conflicts the fork has since moved into (14 and 20 hunks, mostly CodegenCpp plus 2-3 CodegenC hunks in the closure and string-compare areas), so the curated 10-08 names-and-c material stays canonical and opening the PR remains the user's call; 2026-10-12 split: non-defacing changes go upstream as a PR series (test-block parser skip, canonical package dirs, DeadPureLetElision, hermetic BackendSwitch, the new backends, bug fixes), each with its sample rows; edition-3 syntax stays fork-only (SPIRAL3-EDITIONS)", Epic, P1, D8, 10u32, Planned, "", "compiler,upstream,est:3000m,load:heavy,agent:pair", "current", "current")
inl hopac_speed () = Task ("HOPAC-SPEED", "Measure hopac vs single-flight (real-work rows 3-22x slower, fresh process per job), split startup from evaluation, profile and iterate to single-flight speed; stats 2026-10-08 09:5x (probe.ps1, fresh process per compile, F# backend, mean of runs 2-3, net = total - frontier_hello baseline): startup sf 1.0s / hopac 1.45s; net eval brzozowski 0.65s / 0.8s (1.2x), zeta 0.95 / 1.4 (1.5x), omniledger 2.65 / 5.0 (1.9x), lean_cic 1.8 / 5.5 (3.1x), spiral_proves 1.5 / 4.65 (3.1x); the suite-level 126x median compares warm single-flight workers with fresh hopac processes and overstates the gap; next: profile lean_cic; profile lean_cic hopac (probe -Profile 12, SPIRAL_DIAG_QUIET=1), innermost compiler frames: term 36%, installBridge 7.4% (thread-local tail-result bridge save/restore per declared JP step), ty_core_impl 6.8%, buildFreshApplyState 3.2%, DiagSidecar.emitReentryKeySample 2.6% (runs even when quiet: ConditionalWeakTable + 2 AddOrUpdate per re-entry; counts may feed hot-key fallback, check before gating), DiagJson runner/loop/emitRecord 5.5% (background thread, CPU not wall), EvalWorklist replay tick 2.3%; candidates: gate sidecar sampling when quiet if counts are diagnostic-only, make the bridge scope a struct/stack instead of ThreadLocal round trips; each change needs an A/B probe on lean_cic/spiral_proves; 11:3x A/B (tmp/hopac-speed/ab-threadlocal.ps1, 2 interleaved rounds, runs 2-3): the 4 hot-path JP slots AsyncLocal -> ThreadLocal gave identical outputs on 4 samples but lean_cic 6.15/6.50 -> 6.15/6.20 s, spiral_proves 6.10/6.15 -> 5.95/6.10 s, brzozowski and hello within noise (A alone varies 5% between rounds): no proven gain, reverted; the installBridge 7.4% is not the AsyncLocal write cost; next: allocation profile (gc-verbose) of term on lean_cic; 11:4x runtime knobs on the unchanged binary (ab-runtime*.ps1, 2 interleaved rounds, baseline noise about 0.3 s): the shipped config (server GC, concurrent, TieredPGO off) is already best: gen0 64 MB +10%, gen0 8 MB within noise, TieredCompilation off +15%, workstation GC +20-25% on lean_cic/spiral_proves (the hopac core allocates from several threads); GC tuning is ruled out; remaining levers: startup JIT (ReadyToRun, hello is 1.6 s of mostly startup) and algorithmic work in term; 11:4x gen0: test.ps1 sets DOTNET_GCgen0size=256 MB for every run; fresh-process probes (ab-gen0.ps1) show it 4-13% slower than the runtime default on lean_cic/spiral_proves in BOTH cores; but an A-B-A single-flight suite (aba-gen0-suite.ps1, warm workers, 236 C rows) shows no difference (summed 62.5 / 67.6 default / 67.4 s); test.ps1 left unchanged: switching it needs an A-B-A hopac -Suite all (fresh process per job) showing the gain; ReadyToRun is already applied by build.ps1 since 2026-10-05; 12:3x hopac harness default now warm-recycle with deferral (HOPAC-WARM-SERVER): suite 2.35x faster at identical rows; 2026-10-12: hermetic BackendSwitch validation made the hopac rung 76 min vs 54.5 (validating every arm, per-build type cache); candidate: type-check other arms without evaluating their join points; ladders 2026-10-12: hopac 67 min vs single-flight 27-35 min on -Suite all -Native", Epic, P1, D7, 35u32, Active, "", "compiler,hopac,performance,est:2400m,load:heavy,agent:pair", "current", "current")
inl portable_primitives () = Task ("PORTABLE-PRIMITIVES", "Replace C-only macros with portable ops: StringConcat, Floor/Ceil/Round/Atan2, string search/case, a char model, Zig/Lean/Bend arms in lib backend switches; 2026-10-08 13:1x lib/spiral math (edited in math.livemd via mix spiral.edit, math.spi re-exported and compared): floor/ceil/atan2/round gain C (__builtin_* with _Generic for f32/f64), Cpp (<cmath>), Delphi (Int/Frac/Ord, ArcTan2) and TypeScript arms; Lua and Gleam round fixed (gave 2 for 2.7 and 4 for 3.2; now the shared round_half_to_even); lib backend.spi dispatches C and Delphi (before: no lib function could reach a C arm); new sample portable_math_rounding: 10 backends, 9 native runs exit 0, all agree with the C oracle; 13:0x blessed the lib-using samples (30 rows; review and bless runs identical): portable_math_rounding new on 10 backends; format_any x2 C/Delphi now fail at the C/Pascal compiler with backend_switch_has_no_<backend>_arm_in_lib_spiral (BackendSwitch evaluates every arm, so a lib fallback cannot raise a Spiral error for one backend only, same as the Zig/Lean fallbacks); 7 F#/Rust/Zig rows changed only in variable numbering (proved by normalizing v<n>); next: console write_line/write for C and Delphi via the portable !!!!Printf with a typecase, which needs one agreed bool/float text across backends (F# True vs Rust true); 17:1x lib console (console.livemd via spiral.edit, console.spi re-exported): write_line/write gain C arms (printf via real typecase helpers write_line_c/write_c: string %s, i32, i64, u32, u64; floats and bools stay out: no shortest round-trip float text in C, F#/Python print True) and Delphi arms (Writeln/Write); TypeScript write_line moved from console.log to process.stdout.write(String(x)+newline): the harness runs TS in a Worker where console.log and process.stdout.write reorder, and console.log printed i64 BigInt as -7n; new sample portable_console_lines: 8 native backends, stdout identical to C; lib samples re-reviewed (zig_lib_console changed only in numbering); 19:5x lib convert (convert.livemd): convert_i32_base gains C (strtol) and Delphi (FPC radix prefixes ##36/##37/##38, base 2/8/10/16) arms; convert_i32 gains C/Delphi/TypeScript typed dispatch (string -> base 10, float -> round half even via nearbyint/Round, int -> cast); try_convert from string gains C/Delphi/TypeScript/Lua arms through parsed_integer (strict whole-text validation, never-throwing value expression, target range check via integer_fits) and Gleam trims like Rust; Lua previously returned the unparsed string, TypeScript had no convert_i32; lib console Gleam write_line/write print ints via int.to_string (io.println took only String); new sample portable_convert_parse: 7 native backends print 255/11/-42/123/none/none/7 like C; portable_console_lines now has a Gleam row; 19:1x triaged what is left: the lib backend_switch fallback in lib/spiral/backend.spi already carries Zig and Lean arms (they only compileError or name the missing arm for non-unit types) and math (5/5/5), console (3/3/3) and optionm (5/5/5) are fully covered, but the switchable backends run_target_args' and the backend union itself know only Gleam, Lua, Fsharp, Cuda, Cpp, Rust and TypeScript, so a Zig or Lean arm there needs a design call on extending a union that every consumer matches exhaustively; the lib files with not one zig or lean arm are date_time (28 switches), listm (10), resultm (10), seq (9), trace (9), runtime (4), async (3), crypto (3), env (3) and the single-switch common, guid, platform, reflection and testing, while base (23 switches, 5/5), am (13, 3/3) and sm (27, 12/11) are partly covered; nothing is blocked on this today because the harness matrix runs only the C and Gleam backends (the 19:0x restore rung: 610 rows = 483 C + 127 Gleam, no Zig or Lean row exists to fail) and a new arm cannot be validated without a sample, which tonight's scope forbids; StringConcat, string search and case ops and a char model remain compiler-op additions that need every backend and both cores", Feature, P1, D6, 60u32, Active, "", "compiler,lib,portability,est:720m,load:medium,agent:yes", "current", "current")
inl zig_float_format () = Task ("ZIG-FLOAT-FORMAT", "Zig build time: std.fmt float printing adds ~0.4 s per program; a lean shortest-round-trip formatter matching the C oracle; 2026-10-10 measured on zig 0.17: the float arm is compiled only when a float is printed (an i32 print and a program that prints nothing both cold-build in about 9s; f32 and f64 cold-build in about 10-11s; a warm f64 after an i32 cache is about 2s). Printf still rejects a float argument, so no current program pays that cost. The printer is still unwritten.", TaskKind, P2, D5, 0u32, Planned, "", "backend,zig,performance,est:360m,load:medium,agent:yes", "current", "current")
inl gleam_parity () = Task ("GLEAM-PARITY", "Gleam: closures inside recursive unions, BEAM has no inf/NaN; 1 DISAGREE left is Known; done 2026-10-11: native_closure_union_rec runs exit 70 agreeing with C (TyConv keys on the source primitive) and native_float_infinity joins the Gleam list as the Known row (BEAM floats are never infinite or NaN: a 0x7FF0000000000000 float bit-pattern match is nomatch, binary_to_term raises badarg), ladders single-flight-20261011-174150 / hopac-20261011-174720 / restore single-flight-20261011-175313 each ran C,Gleam examples with native: 610 jobs, oracle agree 126, known 1, DISAGREE 0, hopac missing 0, script exit 0, restore 0 of 610 rows differ", TaskKind, P2, D4, 100u32, Done, "", "backend,gleam", "current", "current")
inl clean_generated_output () = Task ("CLEAN-GENERATED-OUTPUT", "Zero toolchain warnings and no comments in generated code across backends (Lean partial-def warnings suppressed by linters); 2026-10-08 13:3x measured C: the harness builds C with -w (all warnings suppressed); gcc -Wall -Wextra -fsyntax-only over the 208 committed main.c: 126 files warn (211 -Wunused-parameter, 180 -Wunused-but-set-variable); the 31 hard errors are expected (27 C-ABI samples linked with harness shims, 2 format_any lib arms deferred to the C compiler, 2 POSIX poll.h cube samples); fixes ((void)param for unused parameters, no set-but-unused temporaries) are in CodegenC = upstream section, so they go with COMPILER-UPSTREAM-ONION; then drop -w from the harness so warnings fail the native tier; 13:4x C -Wunused-parameter fixed: empty refcount bodies (ArrayDecrefBody, ClosureDecrefBody, heap DecrefBody) emit (void)x; (114 C outputs changed only by that line and one blank line; native unchanged); left: 180 -Wunused-but-set-variable (match results stored and never read: dead stores from peval, needs dead-store elimination), the // case comments on C switch labels (go with READABLE-GENERATED-NAMES); 18:4x fresh gcc -Wall -Wextra -fsyntax-only sweep over all 462 committed main.c: 382 clean, 31 hard errors (15 abi_external, 10 dynamic_array_growth/resize, the 2 format_any lib arms, the 2 POSIX cube samples, 2 native_managed_array_scc), 213 warnings in 49 files = 204 -Wunused-but-set-variable (was 180, new samples landed), 8 -Wunused-parameter, 1 -Wtautological-compare; two corrections to the record: the // case comments on C switch labels are gone (0 comment lines in the 462 main.c, and 0 across main.rs 402, main.pas 391, main.fsx 516, main.kt 246, main.swift 246, main.lean 135, main.wat 147, main.ts 117, main.lua 135, main.gleam 127, main.bend 120; the only comments left anywhere are the 11 main.zig build-header lines), and -Wunused-parameter is not fully fixed: the 8 remaining are closure body runtime parameters that the body never reads (closure_array v1, closure_depth v2, closure_heap v1, closure_mut v1, closure_return_heap v2, closure_return_text v2, method_depth v1, mega_brzozowski_derivatives/bench_interned x), unlike the refcount bodies that already emit (void)x; the one -Wtautological-compare is ebpf_conv compiling its own m <= m source comparison (main.spi line 23), not a codegen defect; 19:4x fixed the closure-body half of the leftover: the C closure printer now void-casts exactly the domain arguments the body never reads (it collects the body's free variables once through the existing refc_used_vars walk and emits (void)vN; only for arguments absent from it), a three-line change in the shared CodegenC section that both cores build; the full-suite run single-flight-20261011-190603 regenerated the outputs with 7 files each gaining one (void)vN; line (closure_array v1, closure_depth v2, closure_heap v1, closure_mut v1, closure_return_heap v2, closure_return_text v2, method_depth v1) at 3774 jobs exit 0, native 2749 ran with 13 build-fail, oracle agree 2284, DISAGREE 0 and missing|regressed 0; re-sweeping the same 462 main.c gives 389 clean, 42 warning files, 206 warnings = 204 -Wunused-but-set-variable, the ebpf_conv tautological compare and 1 -Wunused-parameter, and that last one is the stale mega_brzozowski_derivatives/bench_interned output that predates the 13:4x (void)x; fix (425 of 426 empty decref bodies carry it), and it did not clear in tonight's three full-suite runs: that sample is only in the suite as a Fsharp contracts job, its main.fsx refreshed at 20:47 with the same residual b00257ff342f6cce in rung 1 and in the restore, while its main.c still sits at 10-06 16:36, so no suite run regenerates its C file and clearing it needs a targeted C regeneration of that sample; 5 mega samples also drifted in that run (Rust impl Default blocks and the (v5)->refc++ parenthesization of earlier changes), pre-existing and benign; codegen proof ladder 2026-10-11 evening: rung 1 single-flight-20261011-190603, rung 2 hopac-20261011-195057, rung 3 the single-flight restore single-flight-20261011-204644, each 3774 jobs (contracts 669, examples 3052, frontier 48, mega 5), every run script exit 0 with native 2749 ran, 13 build-fail, oracle agree 2284, DISAGREE 0 and baseline missing|regressed 0; the restore reproduces rung 1 exactly, 0 of 3774 rows differ, so hopac left no residue behind and the void-cast fix reads back identically from both cores; across the cores 84 of 3774 rows differ and only in the emitted-text hash (83 rows over 32 samples and 13 backends, portable_math_rounding 11, portable_console_lines 11, portable_convert_parse 9) or in that one compile status (runaway_inline_match_recursion flips timeout in rung 1 to error under load in rung 2, non-ok in both), while compile, native, exit and stdout stay identical throughout; left: the 204 dead stores, which need dead-store elimination in peval; 2026-10-12: the gcc census used -fsyntax-only, which skips flow analysis: a real -O0 -c -Wall compile of 80 sampled main.c finds -Wreturn-type (control reaches end of non-void function) in 18 files, 42 of 48 warnings, from union switches whose cases all return; fix: the last case of a match with no fallback and one scrutinee is emitted as default (exhaustive in C, no builtin). Dead stores: new backend-agnostic DeadPureLetElision pass in CodegenUtils (backward liveness, drops TyLet of pure ops whose vars are dead, never Div/Mod/index/slice/macros/calls; memoized per body because RefcDecrTable keys statements by reference), applied to the main body and the CodegenAdapter method/closure bodies of both cores. Both unbuilt; verifier checks every changed output is a line subsequence of the old one; 2026-10-12 built and proven (single-flight-20261012-062458, 3,768 rows, DISAGREE 0, no regression): DeadPureLetElision + exhaustive default changed 268 rows, every one verified as a line deletion of the bless-time snapshot modulo the documented knock-ons (case->default relabel, (void)vN for a now-unused closure parameter, Gleam _v unused-parameter prefix, Delphi tmpN and Wasm $tN temp renumbering, blank-line placement); about 3,000 dead lines removed (C 1,199, Delphi 606, F# 535, Zig 554, Rust 298, TypeScript 96, Kotlin/Swift 46 each); gcc -O0 -c -Wall on the same 80-file sample: 48 warnings in 18 files -> 2 in 2 (-Wreturn-type gone, 2 dead stores the purity whitelist keeps); ladder single-flight-20261012-062458 / hopac-20261012-070019 / restore single-flight-20261012-080719: 3,768 rows each, 0 rows differ across cores or on restore (compile, residual hash, native, exit, stdout, oracle, baseline), DISAGREE 0; bless dev41 started 08:36 (main cache, then a reproduction pass); samples/string_ord joins the Wasm list (exit 0 like C, a $str_cmp forced to 0 exits 1); blessed dev41 2026-10-12 08:36 (single-flight-20261012-083637, 3,769 rows incl. the new string_ord Wasm row, agree 2,287, DISAGREE 0) with reproduction single-flight-20261012-090246: 0 of 3,769 rows differ, parity 3,769", TaskKind, P2, D3, 92u32, Active, "", "compiler,codegen,est:120m,load:medium,agent:yes", "current", "current")
inl for_d_compiler_bugs () = Task ("FOR-D-COMPILER-BUGS", "Six FOR-D repro samples: runaway match recursion without EJP0040, multiline scrutinee, multiline type application, nominal phantom parameter, GADT match constraint, runtime existential unpack", Feature, P2, D7, 20u32, Planned, "", "compiler,parteval,est:1200m,load:heavy,agent:yes", "current", "current")
inl workflow_end_to_end () = Task ("WORKFLOW-END-TO-END", "i574n.github/scripts/workflow.ps1 end to end, WSL parts last", TaskKind, P2, D5, 50u32, Paused, "", "ci,workflow,est:600m,load:heavy,agent:no", "current", "current")
inl spiral_independent () = Task ("SPIRAL-INDEPENDENT", "Make spiral independent of polyglot, then split what remains of polyglot into descriptive repos; 2026-10-08: lib/spiral/*.fsx gone (FSX-FREE, spiral_runtime.fs instead), 4 compiler samples resolve their lib through spiral itself instead of deps/polyglot/deps/spiral (20 rows parity, residuals unchanged), apps/wasm builds natively on Windows; remaining polyglot mentions: env.ps1 and Kino core-package fallbacks (../polyglot), Kino polyglot_root option alias, docs; 23:2x dir-tree-html left spiral for its own repo; consumers reach it through spiral scripts/dir-tree-html.ps1, not polyglot paths; 2026-10-12 inventory (code files only): what still ties spiral to polyglot is shallow, three steps: (1) naming: `namespace Polyglot` in spiral_compiler.fs, host Program.fs, runtime-compat PolyglotCommon.fs, RootNamespace in SpiralCompilerCore/SpiralCompiler fsproj and gear-dev.ps1, and two stack-trace filters matching \"Polyglot\" (spiral_compiler.fs ~133373, ~188068) -> rename to Spiral in one ladder; (2) consumers: dice and alphabet reach spiral as deps/polyglot/deps/spiral (init.ps1, package.spiproj packageDir, CI checkout) -> clone spiral directly as deps/spiral (mirror dice -> alphabet); (3) then drop the polyglot fallbacks: env.ps1:129-130 (VS Code Plugin core path), kino domain_compiler.ex:49, toolchain.ex:21, notebook.ex @lib_rels polyglot entries, kino.ex polyglot_root/SPIRAL_KINO_POLYGLOT_ROOT option; leave mentions in docs/history and the contract_*_polyglot_* sample names alone; step (2) is a multi-repo decision for the user: dice (and alphabet) use polyglot for far more than reaching spiral: polyglot/scripts/core.ps1 in every build script, polyglot/lib/fsharp (Common.fs, Notebooks.livemd, open Polyglot), polyglot's parser app and init toolchains, polyglot/deps/hyperui css; cloning spiral directly in dice would leave two spiral copies (deps/spiral and polyglot/deps/spiral) unless polyglot stops vendoring spiral or the shared helpers move (core.ps1 into spiral or its own repo); step (1) and (3) can proceed independently", Epic, P2, D6, 55u32, Active, "", "repos,polyglot,est:900m,load:medium,agent:pair", "current", "current")
inl stable_entry_points () = Task ("STABLE-ENTRY-POINTS", "Stable entry points in emitted code; Rust backend hacks vs the creator's C", TaskKind, P2, D5, 50u32, Active, "", "compiler,rust,est:360m,load:medium,agent:yes", "current", "current")
inl kino_fsi_cleanup () = Task ("KINO-FSI-CLEANUP", "Kino fsi_chain/fsi_session still mention dotnet-repl and .dib: confirm what F# cells need natively and drop the rest; confirmed 2026-10-11 18:3x, nothing turned out to be droppable without a design call: F# cells need the dotnet fsi session and its ;; submissions, #r nuget resolution, the ///- --timeout and ///- --ignore cell directives (ignored?/1 is applied by the livemd runner as well), and the prelude that opens Microsoft.DotNet.Interactive.Formatting, which polyglot's live notebooks really use (Notebooks.livemd sets Formatter.ListExpansionLimit, NotebooksHtml.livemd and Testing.livemd call Formatter.Register, actual.ToDisplayString () and AssertExceptionFormatter.Display (), and a small Formatter shim stands in when the dll is absent); the only dotnet-repl-specific piece is the .dib document route, which is still the fallback format for any non-.livemd notebook and for a #!import of one, so it is a live input path even though polyglot migrated all five of its .dib notebooks to .livemd and no .dib file exists in either repo today; dropping that route would remove a user-facing format, which is the user's call", TaskKind, P3, D3, 100u32, Done, "", "kino,fsharp", "current", "current")
inl sample_readmes_decision () = Task ("SAMPLE-READMES", "119 older per-sample README.md files describe code in prose; delete as drift or keep (user decision); 2026-10-12 user position: no prose in repos; decide per README: fold the fact into the sample name or a test-block name, else delete (SAMPLES-TO-TEST-BLOCKS); 2026-10-12 classification (keyword heuristic, list in job scratch metrics/sample-readmes.tsv): 120 READMEs = 58 descriptions (4,247 words, mostly restate the sample name) + 46 bug histories (4,435 words, \"used to\"/regressions; the commits already hold them) + 12 expectations (1,084 words: exit codes/oracle notes -> inline expectations, TEST-EXPECT-PERSIST) + 3 manual checks (2,955 words, mega_brzozowski_derivatives alone 2,677; manual steps -> automation); proposal for the user: delete the 58 descriptions now, the 46 histories once SAMPLES-TO-TEST-BLOCKS gives tests descriptive names, fold the 12 expectations, automate the 3 manual checks", TaskKind, P3, D1, 0u32, Planned, "", "samples,docs,est:120m,load:light,agent:yes", "current", "current")
inl comment_constants_review () = Task ("COMMENT-CONSTANTS-REVIEW", "Review the 14 unused unit-function constants added in place of sample comments; done 2026-10-11: all 14 located and kept, they are the only rationale a comment-free sample can carry (6 x oracle_must_not_record_current_error; 3 x type_applications_stay_on_one_line_or_the_parser_drops_the_definition; one each of expected_parse_error_at_empty_match, expected_error_lib_extra_is_ambiguous, expected_error_ejp0040, fourth_from_end_one_left_out_its_compile_time_minimization_takes_43_s, excluded_erp_p2p_eight_event_recursive_atomic_payload_outbox_terminal_does_not_compile); every name occurs exactly once in its own file, so all 14 are unused, and none of them reaches a generated file; one name was wrong and is corrected: expected_error_ejp0040 on samples/runaway_inline_match_recursion named the if-nesting limit, which that sample cannot reach because it has no dynamic if branch, only a match recursion over a runtime nat, so hopac reports error[EJP0011] partial evaluation re-entered more than 1024 times (6.5 s probe) and single-flight returns nothing at all within 240 s (killed at 226.7 s, no diagnostic); the marker is now expected_error_ejp0011_reentry_limit and the sample behaves exactly as before", TaskKind, P3, D1, 100u32, Done, "", "samples", "current", "current")
inl lua_wide_integers () = Task ("LUA-WIDE-INTEGERS", "Lua 5.1 doubles: 64-bit integers are inexact (Known rows); exact u64/i64 emulation would lift them", TaskKind, P4, D6, 0u32, Planned, "", "backend,lua,est:720m,load:medium,agent:yes", "current", "current")
inl python_strings_upstream () = Task ("PYTHON-STRINGS-UPSTREAM", "CodegenPython string semantics differ from C; upstream section, coordinate with the upstream move", TaskKind, P4, D4, 0u32, Planned, "COMPILER-UPSTREAM-ONION", "backend,python,upstream,est:300m,load:medium,agent:yes", "current", "current")
inl main () : i32 = 0i32
inl task_KINO_PARALLEL_CACHE () = Task ("KINO-PARALLEL-CACHE", "Kino stress notebook: N Spiral cells over one shared prefix run concurrently; measure per-cell compile time vs cold, require each cell's output identical to a single-cell run (catches cross-request state leaks like FRONTIER fix 57); if caching holds, migrate single-module samples to notebooks; 2026-10-08: Kino CompilerDaemon serializes every compile (GenServer handle_call -> one single-flight compiler process, warm after the first request), so concurrent cells queue instead of running in parallel; the experiment needs a compiler that serves parallel requests from one warm process, i.e. HOPAC-WARM-SERVER (fix 57: per-request join point state), then a daemon pool or async dispatch; 2026-10-08 17:0x unblocked differently: single-flight is warm-safe, so concurrency needs no hopac: a pool of K single-flight daemons (client-side, one port each); memory measured (tmp/kino-mem/warm-growth.ps1, one warm --batch process, 190 example compiles): ~530 MB after 189 compiles (~2.5 MB retained per compile), a single runaway sample (runaway_inline_match_recursion, FOR-D) spiked to 2 GB; the 5.5 GB Kino server seen this morning was a heavy compile's working set, not accumulated leaks; K=2-3 fits this 16 GB machine for normal cells; 17:4x implemented the pool: CompilerClient spreads compiles over SPIRAL_KINO_COMPILERS single-flight daemons (ports 13905..; default 1 = the old path exactly; least-busy pick through atomic ETS counters; ensure/retire/locks/logs per port; shutdown retires all); Kino tests 53/53; stress (tmp/kino-mem/stress.exs: 6 cells, fresh source copies, every daemon warmed first): pool 1 seq 16.9 s / par 9.4 s, pool 3 seq 17.5 s / par 6.7 s (1.4x over pool 1, 2.6x over sequential); outputs identical seq vs par and across pools; caches are per daemon (a repeated source is a cache hit only on the daemon that compiled it); cold daemon ~7 s first compile", Feature, P2, D5, 60u32, Active, "HOPAC-WARM-SERVER", "kino,compiler,cache,parallel,est:300m,load:heavy,agent:yes", "current", "current")
inl task_WORKSPACE_PRIMITIVES_LIB () = Task ("WORKSPACE-PRIMITIVES-LIB", "One granular Spiral library of workspace primitives (fs, processes with supervision/timeout/elapsed, git read, tables TSV/CSV/JSON/psd1, time, env, hash) returning enriched results; eoie verbs become thin wrappers over it; the same library is what converted repo scripts call (46% of 6,804 pwsh calls are glue this replaces); 2026-10-08 first slice: eoie src/workspace_primitives (source-only Spiral package, one module per concern: outcome validation_result, numbers, bytes, clock unix_ms/ms_since, console stdout/stderr receipts, files checked atomic replace + size receipts); the 7 crates written today (agile add/edit/list/census/init, text-replace, fs-remove) open it; 4 of them regenerated byte-identical, 3 changed only the generic failure wording", Epic, P1, D7, 10u32, Active, "", "eoie,spiral,library,est:2400m,load:medium,agent:yes", "current", "current")
inl task_PS1_TO_SPIRAL () = Task ("PS1-TO-SPIRAL", "After HOPAC-SPEED reaches state of the art (user): rewrite each repo's .ps1 scripts (build, test, init, workflow) as Spiral programs compiled to Rust, living in their own repos, compiled and run through the spiral CLI, using WORKSPACE-PRIMITIVES-LIB; no shelling out to pwsh or eoie", Epic, P3, D7, 0u32, Blocked, "HOPAC-SPEED,WORKSPACE-PRIMITIVES-LIB", "scripts,spiral,repos,est:4800m,load:medium,agent:pair", "current", "current")
inl task_HOPAC_WARM_SERVER () = Task ("HOPAC-WARM-SERVER", "Make the hopac core stable as a long-lived warm server (fix 57: per-request join point state keyed per request) so harness and Kino stop paying ~10 s warm-up per process; prerequisite for Kino SOTA and for HOPAC-SPEED numbers; scoping 2026-10-08 (FRONTIER.md fix 57): warm --batch already compiles a suite 12x faster (186 s vs 2,295 s) with 1,054/1,089 rows unchanged; the ~35-100 diverging rows come from JP work items whose hard-deadline watchdog (left by a build the host abandoned) sets the process-wide terminal-failure latch inside a later build; point resets (latch, invalidation count, sequential flag, per-request watchdog ordinal) are done, tagging work items per request did not help; the remaining design is one per-BuildFile session object owning JP work items, cells, caches, deadlines and the latch, created per request and dropped after it; single-flight is already warm in the Kino daemon; 2026-10-08 12:3x DONE for the harness: host defers a failure from a process that already served a build (withholds the result, exit 4; the runner resumes that job first in a fresh process); -WarmRecycle is hopac default; same DLL -Suite all: 782 s vs 1,834 s fresh (2.35x), 2,014/2,014 rows identical (status, residual hash, verdict); 605 deferrals, 106 warm-only failures caught; remaining for Kino/fully warm (~12x): the per-BuildFile session object; 16:3x deployed hopac (CodegenC fixes + readable names) on the default warm-recycle path, -Suite all -Parallel 2: 2,024 jobs in 851 s, every oracle row in the parity class (no missing/REGRESSED), 53 parity-residual-differs = the 37 known + 14 rows of the three lib/spiral samples (variable numbering inside lib backend_switch code differs between the cores, not names)", Epic, P1, D7, 60u32, Active, "", "compiler,hopac,kino,est:900m,load:heavy,agent:pair", "current", "current")
inl task_KINO_SOTA () = Task ("KINO-SOTA", "Kino to state of the art: warm compiler server, concurrent cells over a shared prefix with correct memoization (KINO-PARALLEL-CACHE), fast incremental re-run, rich outputs; acceptance test: SOCIAL-TRANSPORT-SIM scenarios pass their invariants at scale", Epic, P1, D8, 0u32, Planned, "KINO-PARALLEL-CACHE,QUERY-CACHE-COMPILER,KINO-RESULT-MEMO", "kino,est:3600m,load:heavy,agent:pair", "current", "current")
inl task_KINO_SPIRAL_GLEAM () = Task ("KINO-SPIRAL-GLEAM", "Experiment: Kino logic written in Spiral compiled to Gleam (BEAM), called from a thin Elixir/Livebook shim; stage two replaces Livebook runtime pieces with our own runner to drop Elixir; style reference: polyglot examples/elixir exercism multi-clause functions", Feature, P3, D8, 0u32, Planned, "", "kino,gleam,elixir,est:2400m,load:medium,agent:yes", "current", "current")
inl task_GLEAM_UPGRADE () = Task ("GLEAM-UPGRADE", "Gleam 1.14.0 -> 1.19.1 (emits Erlang abstract forms instead of .erl source): local done via scoop, Gleam probe rerun, then the CI gleam-version pins in spiral/polyglot/dice/i574n.github (already 1.19.1 in each gh-pages.yml: spiral 59d77c99, polyglot 525c5f44, dice bd4f5c2, i574n.github 2d04303, committed 2026-10-08); done 2026-10-11: local toolchain verified (gleam 1.19.1, OTP 29), all four gh-pages.yml pins still read 1.19.1 (spiral:28, polyglot:28, dice:31, i574n.github:31), and the probe rerun is the Gleam examples ladder single-flight-20261011-174150 / hopac-20261011-174720 / restore single-flight-20261011-175313: 127 Gleam rows, 126 agree plus the one Known, DISAGREE 0, hopac missing 0, script exit 0; the GitHub CI run itself lands with the next push", TaskKind, P1, D2, 100u32, Done, "", "gleam,toolchain", "current", "current")
inl fsx_free () = Task ("FSX-FREE", "Iterate until spiral lib/spiral/*.fsx (common, sm, crypto, date_time, async_, threading, networking, platform, runtime, file_system, trace, lib) are no longer needed (user 2026-10-08): dice lib.ps1 GetFsxModulePaths/PublishFsharp, polyglot lib/fsharp/Notebooks.livemd and apps/parser #!import; restored byte-exact after the 98492a63 deletion broke dice+polyglot CI; 2026-10-08 08:2x: replaced by hand-written lib/spiral/spiral_runtime.fs (Lib facades used by consumers + new_disposable/retry_fn), trace output byte-identical to the generated stack; dice lib publishes dice.fsx alone, dice lib/fsharp + polyglot Notebooks.livemd use the runtime; verified dice both F# paths, polyglot apps/parser and lib/fsharp 6/6 with the 13 .fsx deleted; confirm on the next CI push; 18:4x re-verified locally: lib/spiral holds no .fsx at all (0 files) and spiral_runtime.fs is 8,512 bytes, the only .fsx left under lib being 113 generated bench/parsing/target files with none outside target; the CI confirmation lands with the next push", Feature, P0, D5, 100u32, Done, "", "fsharp,ci,spiral,polyglot,dice", "current", "current")
inl ci_spiral_wasm_native () = Task ("CI-SPIRAL-WASM-NATIVE", "spiral Windows CI 07:03: apps/wasm built through bash/WSL (cargo: command not found); now native on every platform like apps/spiral: near-workspaces default-features=false (its build.rs install panicked Unsupported platform), sandbox fetched at runtime; RUST-OK apps/wasm locally on Windows; confirm on next push; local preflight of the steps after wasm on Windows: apps/plot RUST-OK (native), scripts/outdated.ps1 exit 0; polyglot CI path (spiral app, parser, lib/fsharp 6/6, wasm, lib/math has no F# cells) checked; lib/spiral/build.ps1 step: the two notebooks that failed yesterday (file_system, parsing) now exit 0 when run alone (outputs to tmp), the other 36 passed yesterday; 20:0x CI on the 18:34 push: dice windows-2025 still red here: contract build runs process_rust wasm through SPIRAL_WASM_COMMAND with -Linux (bash on the Windows runner) from D:\\a\\dice\\spiral, `workspace/target/release/spiral_wasm: No such file` (exit 127), while dice scripts/init.ps1 builds and ships spiral_wasm.exe under polyglot/deps/spiral/workspace; needs the native (non-Linux) invocation with the .exe from the same checkout; 21:5x decided: dice windows contract run stays on the WSL path (spiral_wasm deploys into near_workspaces.sandbox_worker, Linux-only), so it is WSL work and waits for the WSL-last phase; no Windows skip switch; 03:55 local no-WSL repro: workspace/target/release/spiral_wasm is an ELF leftover (2026-10-07) beside spiral_wasm.exe (PE, 2026-10-08). Native exe --help exits 0. exe -w a file -t debug retries 15 times with Could not initialize sandbox node (near-workspaces 0.11.1 InitFailure) then exits 0, because spiral_wasm.run turns an exhausted Error into Ok and main returns 0. near-sandbox-utils platform() is None on Windows through 0.15.1 (linux x86 and darwin arm only). The GitHub windows runner has no ELF, so bash -Linux reports the unsuffixed path missing. Pointing that job at the exe would not run the sandbox", TaskKind, P0, D3, 90u32, Active, "", "ci,spiral,wasm,windows,est:60m,load:light,agent:pair", "current", "current")
inl wasm_backend () = Task ("WASM-BACKEND", "WebAssembly as a full Spiral backend: codegen in spiral_compiler.fs, a harness backend list, a native tier with a run check, C oracle parity on the examples suite (wasm module run by a local runtime); 22:4x codegenWasm (section CodegenWasm, --backend Wasm / .wat): WAT text run by wasmtime (WASI fd_write/proc_exit, -W max-wasm-stack=1 GB like the other natives); scalars on the four value types with sub-word narrowing, unsigned ops, conversions incl. trunc_sat; join points as funcs, self tail calls as loop/br, while as block/loop; unions/heap/mutable layouts/arrays as i32 pointers into linear memory (bump allocator, tag + 8-byte slots), closures as [table index][captures] called through call_indirect over a funcref table; strings [len][utf-8] with concat/eq/slice (exit 3 on bad bounds or a cut UTF-8 sequence); portable Printf %s/%d; failwith -> stderr + exit 1; lib backend.spi/console/math gain Wasm arms; harness: Wasm list, native tier, wasmtime tool; exploration over the 144 Zig samples: 135 agree with C (from 62 in v1), 3 excluded (C-syntax macros), Log/Pow pending; 23:43 blessed: full review + -Bless + repro single-flight-20261008-231513 vs -232952, 2179 rows, 0 differences, DISAGREE 0; 143 Wasm rows in the oracle; the 29 residual changes elsewhere were proven renumbering only (BackendSwitch now evaluates the Wasm arms too); next: convert Wasm arms ($parse_i64 strtol-like, $integer_text_ok strict), then Log/Pow/atan2 (no WASM instruction: software or WASI-free math); 00:0x convert arms (strtol-like $parse_i64, strict $integer_text_ok) and software math ($math_exp/log/sin/cos/tanh/pow/atan2: range reduction + series, worst relative error 3.5e-16 vs .NET libm, identities exact) make portable_convert_parse, portable_math_rounding, native_float_math_family and native_float_pow_pi agree; the prelude is tree-shaken by call $name reachability (average .wat 7 KB); lib math floor/ceil/round use typed macros (`t.floor); Wasm list 147, all agree with C (zig_lib_console with its Zig row, lua_while_union_pair agree-fail); full bless cycle running; 00:53 blessed into the main oracle (an earlier cycle had silently blessed the dev cache: host-build-dev*.ps1 leaked SPIRAL_BIN_CACHE_DIR into the chain): single-flight-20261009-002903 vs -004217, 2183 rows, 0 differences, DISAGREE 0; the 161 changed rows were 143 Wasm (tree-shaken prelude) + 18 renumbered rows of portable_convert_parse/portable_math_rounding (their lib modules gained Wasm arms), natives agree; 147 Wasm rows in the oracle; 00:5x coverage sweep over the 56 other samples with a C native row: none portable as written (29 have their own BackendSwitch records without a Wasm key, 21 call C-only helpers, 3 C-syntax macros, 3 not run), so the Wasm list stays 147 = every sample whose code is portable; temporary entries and 24 stray .wat reverted", Feature, P1, D6, 90u32, Active, "", "backend,compiler,est:240m,load:medium,agent:yes", "current", "current")
inl wgsl_backend () = Task ("WGSL-BACKEND", "WGSL as a full Spiral backend: codegen in spiral_compiler.fs, a harness backend list, a native tier with a run check, C oracle parity on the examples suite (compute shaders run on a local WebGPU runtime; lowering for no recursion and no function pointers); 2026-10-10: codegenWgsl (--backend Wgsl / .wgsl) and spiral-wgsl (wgpu 24, tests/native-shims/wgsl-run). The shader writes main's i32 into storage SpiralIo.code; the runner exits with that code and prints nothing. No adapter is exit 3 (no-toolchain); validation is exit 2 (build-fail). Scalars i32/u32/f32/bool, char as i32, flattened tuple structs, if/while, methods, self-tail as loop/continue, shift counts forced to u32, macros emitted as text (Wgsl arm of set' is !a = !b). Harness 20 samples. single-flight-20261010-132430: 20 Wgsl rows agree with C, DISAGREE 0. hopac-20261010-133655: all 20 Wgsl rows, including tuples, agree with C, DISAGREE 0. Out of v1: f64, i64/u64, sub-word integers, unions, arrays, strings, closures, heap refs, globals, failwith, non-self-tail recursion, BackendSwitch records without a Wgsl key", Feature, P2, D7, 40u32, Active, "", "backend,compiler,est:1200m,load:medium,agent:yes", "current", "current")
inl calyx_backend () = Task ("CALYX-BACKEND", "Calyx as a full Spiral backend: codegen in spiral_compiler.fs, a harness backend list, a native tier with a run check, C oracle parity on the examples suite (hardware IR, simulated locally); 2026-10-10: codegenCalyx (--backend Calyx / .futil). Integer subset: std_reg per local, one group per assignment, self-tail as while on a go register, cider stdout dump converted by auxin. component main writes the i32 into @external spiral_io. Harness 9 samples. single-flight-20261010-135938: 9 Calyx rows agree with C, DISAGREE 0 (backend_smoke exits 13, native_bitwise_scalar exits 42, python_self_tail_call_depth 5000 iterations). Out of v1: f32/f64, i64/u64, tuples, macros, strings, unions, arrays, closures, heap refs, globals, failwith, non-self-tail recursion. hopac-20261010-140941: the same 9 rows agree with C, DISAGREE 0.", Feature, P2, D8, 50u32, Active, "", "backend,compiler,est:1500m,load:medium,agent:yes", "current", "current")
inl kotlin_backend () = Task ("KOTLIN-BACKEND", "Kotlin as a full Spiral backend: codegenKotlin in spiral_compiler.fs, the harness Kotlin list, native tier Kotlin 2.4.21 on Temurin JDK 25. 2026-10-11: all 246 listed samples agree with C on both cores (single-flight-20261011-034849, hopac-20261011-042553, restore single-flight-20261011-045745; the 3774-row ladder single-flight-20261011-204644 has Kotlin 246/246, verified 2026-10-12). Representation, semantics and proof details live in apps/compiler/tmp/AGENTS.md. Left: recursive unions, array elements of more than one value, a closure that calls itself, function types other than a plain arrow, recursive/stack/ref layouts, globals, and BackendSwitch records without a Kotlin key; 2026-10-12 closed: 246 rows agree with C on both cores, warm compile server (median 285 ms/row); the Not supported list (recursive unions, multi-value array elements, self-calling closures, stack/ref layouts, globals) moves to BACKEND-COVERAGE-GAPS", Feature, P2, D5, 100u32, Done, "", "backend,compiler", "current", "current")
inl swift_backend () = Task ("SWIFT-BACKEND", "Swift as a full Spiral backend: codegenSwift in spiral_compiler.fs, the harness Swift list, native tier Windows swiftc 6.4. 2026-10-11: all 246 listed samples agree with C on both cores (the same runs as KOTLIN-BACKEND; the 3774-row ladder single-flight-20261011-204644 has Swift 246/246, verified 2026-10-12). Representation, semantics and proof details live in apps/compiler/tmp/AGENTS.md. Left: recursive unions, array elements of more than one value, a closure that calls itself, function types other than a plain arrow, recursive/stack/ref layouts, globals, and BackendSwitch records without a Swift key; 2026-10-12 closed: 246 rows agree with C; build speed (swiftc ~3 s/row) moves to SWIFT-WARM-COMPILE, unsupported shapes to BACKEND-COVERAGE-GAPS", Feature, P2, D5, 100u32, Done, "", "backend,compiler", "current", "current")
inl openqasm3_backend () = Task ("OPENQASM3-BACKEND", "OpenQASM 3 as a full Spiral backend: codegen in spiral_compiler.fs, a harness backend list, a native tier with a run check, C oracle parity on the examples suite (classical subset first, run on a local simulator); 2026-10-10: codegenOpenQasm (--backend OpenQasm / .qasm). OPENQASM 3.0 classical subset, output int[32] spiral_io, empty stdout. Simulator is tests/native-shims/openqasm-run/run.py (32-bit wrap, toward-zero div and mod, arithmetic signed shift, logical unsigned shift, float[32] rounded per op). Scalars int[32]/uint[32]/float[32]/bool, char as int[32]. Tuples are a deliberate extension beyond standard OpenQASM 3 (no tuple or multi-value type) and the local simulator accepts them: a tuple domain flattens to one parameter per element and a tuple return flattens to `-> (T1, T2, ...)` with `v0, v1 = f(...)` at the call (a nested tuple flattens recursively; a tuple-returning self-tail's dead return is `return 0, 0, ...;`). Harness 21 samples (the 16 non-tuple names plus tuple_pair, ebpf_nest3, ebpf_tacc, ebpf_t2, ebpf_t3). single-flight-20261010-145423: 16 rows agree with C, DISAGREE 0 (backend_smoke exits 13, native_bitwise_scalar exits 42). hopac-20261010-150227: the same 16 rows agree with C, DISAGREE 0. single-flight-20261010-150322 (rerun after hopac rewrote the samples): agree 16, DISAGREE 0. 2026-10-11 tuples: single-flight-20261011-125450, hopac-20261011-130419, and restore single-flight-20261011-130704 each ran -Backend C,OpenQasm -Suite examples -Native: 504 jobs, 10 build-fail, 21 OpenQasm rows agree with C, DISAGREE 0, hopac missing 0, broken 0, exit 0; the restore run reproduces single-flight-20261011-125450 row for row (0 of 504 rows differ). Out of v1: f64, i64/u64, NaN/infinity, strings, unions, arrays, closures, heap refs, globals, failwith, non-self-tail recursion.", Feature, P2, D8, 50u32, Active, "", "backend,compiler,est:900m,load:medium,agent:yes", "current", "current")
inl ebpf_c_profile () = Task ("EBPF-C-PROFILE", "eBPF as a profile of the C backend (verifier-friendly bounded loops, no recursion, BPF maps), started once the WASM, WGSL, Calyx, Kotlin, Swift and OpenQASM 3 backends are complete; 2026-10-10: codegenEbpf (--backend Ebpf / .ebpf). Windows gcc -std=c11 -O2 -w -x c runs it. No kernel load: the installed clang has no BPF target. Loops are for-loops capped at 16777216. Maps are a 64-slot array (spiral_map_lookup, spiral_map_update). Harness is the Kotlin 20 plus samples/ebpf_map, ebpf_map_full, ebpf_arith, ebpf_nested, ebpf_float, ebpf_conv, ebpf_unit, ebpf_shift, ebpf_bool, ebpf_cast, ebpf_div, ebpf_bits, ebpf_key, ebpf_umul, ebpf_neq, ebpf_facc, ebpf_uacc, ebpf_bacc, ebpf_char, ebpf_sh31, ebpf_flt, ebpf_minkey, ebpf_nest3, ebpf_uadd, ebpf_fdiv, ebpf_tacc, ebpf_t2, ebpf_ineq, ebpf_tworec, ebpf_t3, and ebpf_snot. single-flight-20261010-154804: 20 rows agree with C, DISAGREE 0 (backend_smoke exits 13, native_bitwise_scalar exits 42). hopac-20261010-155533: those 20 agree, DISAGREE 0. single-flight-20261010-155601 (rerun after hopac): agree 20, DISAGREE 0. samples/ebpf_map stores 42 at key 7, overwrites it with 9, and looks up a missing key: single-flight-20261010-155757, hopac-20261010-155818, and single-flight-20261010-155823 agree with C, exit 0, DISAGREE 0. samples/ebpf_map_full fills 64 slots (including key -1 and a stored 0), rejects key 63, and overwrites a full map; samples/ebpf_arith checks toward-zero signed division and remainder, arithmetic right shift, and unsigned wrap. hopac-20261010-161118 and single-flight-20261010-161123 agree with C on those two, exit 0, DISAGREE 0. samples/ebpf_nested (self-tail with an inner while) and samples/ebpf_float: hopac-20261010-161541 and single-flight-20261010-161809 agree, exit 0, DISAGREE 0. samples/ebpf_conv (INT32_MIN, casts, unsigned division of the high bit, logical shift, left at runtime) and samples/ebpf_unit (map update from a join point): single-flight-20261010-162410, hopac-20261010-162431, and single-flight-20261010-162437 agree, exit 0, DISAGREE 0. samples/ebpf_shift (runtime shift counts: arithmetic right shift of a negative, left shift of a positive, unsigned left and right): single-flight-20261010-162550, hopac-20261010-162607, and single-flight-20261010-162612 agree, exit 0, DISAGREE 0. samples/ebpf_bool (runtime bool arguments, &&, ||, inequality): single-flight-20261010-162736, hopac-20261010-162802, and single-flight-20261010-162807 agree, exit 0, DISAGREE 0. samples/ebpf_cast (runtime i32, negative i32, and u32 to f32, and f32 to u32): single-flight-20261010-162924, hopac-20261010-162942, and single-flight-20261010-162948 agree, exit 0, DISAGREE 0. samples/ebpf_div (negative signed divisor, and a runtime u32 divisor): single-flight-20261010-163012, hopac-20261010-163033, and single-flight-20261010-163039 agree, exit 0, DISAGREE 0. samples/ebpf_bits (runtime u32 and, or, xor, and complement): single-flight-20261010-163054, hopac-20261010-163123, and single-flight-20261010-163128 agree, exit 0, DISAGREE 0. samples/ebpf_key (a shifted i32 is the map key) and samples/ebpf_umul (unsigned multiply wrap): single-flight-20261010-163156, hopac-20261010-163216, and single-flight-20261010-163222 agree, exit 0, DISAGREE 0. samples/ebpf_neq (runtime f32 negation, and <> as equality plus bool !=): single-flight-20261010-163335, hopac-20261010-163411, and single-flight-20261010-163417 agree, exit 0, DISAGREE 0. samples/ebpf_facc (self-tail f32 accumulator, dead return 0.0f) and samples/ebpf_uacc (self-tail u32 accumulator, unsigned add wrap, dead return 0u): single-flight-20261010-163445, hopac-20261010-163459, and single-flight-20261010-163506 agree, exit 0, DISAGREE 0. Combined reprove of those 17 Ebpf samples: hopac-20261010-163533 and single-flight-20261010-163544 agree 17, DISAGREE 0, every native exit 0. samples/ebpf_bacc (self-tail bool accumulator, dead return false) and samples/ebpf_char (runtime char equality, 'A' is 65; char fails the number constraint so < is rejected): single-flight-20261010-163634 for bacc, single-flight-20261010-163652 for char, then hopac-20261010-163736 and single-flight-20261010-163743 agree, exit 0, DISAGREE 0. samples/ebpf_sh31 (u32 shift by 31 and by 0) and samples/ebpf_flt (negative f32 ordering): single-flight-20261010-163819, then the 21-sample hopac-20261010-163835 and single-flight-20261010-163848 agree, exit 0, DISAGREE 0. That pair of runs also reproves the earlier 19 profile samples, agree 21, DISAGREE 0. samples/ebpf_minkey (map key INT32_MIN) and samples/ebpf_nest3 (nested i32, u32, f32 flattened to one struct): single-flight-20261010-163933, hopac-20261010-163950, and single-flight-20261010-163957 agree, exit 0, DISAGREE 0. samples/ebpf_uadd (u32 add across 2^31): single-flight-20261010-164046, hopac-20261010-164105, and single-flight-20261010-164111 agree, exit 0, DISAGREE 0. samples/ebpf_fdiv (f32 division by a negative divisor): single-flight-20261010-164142, hopac-20261010-164203, and single-flight-20261010-164209 agree, exit 0, DISAGREE 0. samples/ebpf_tacc (self-tail returning a pair, dead return (SpiralTuple0){0}): single-flight-20261010-164304, hopac-20261010-164320, and single-flight-20261010-164326 agree, exit 0, DISAGREE 0. samples/ebpf_t2 (pair and triple in one program): single-flight-20261010-164419, hopac-20261010-164436, and single-flight-20261010-164442 agree, exit 0, DISAGREE 0. Full harness reprove of all 47 Ebpf samples: hopac-20261010-164510 and single-flight-20261010-164532 agree 47, DISAGREE 0 (backend_smoke exits 13, native_bitwise_scalar exits 42). On-disk outputs are the single-flight-20261010-164532 generation. samples/ebpf_ineq (runtime NEQ on i32, u32, and f32, emitted as !=): single-flight-20261010-165107, hopac-20261010-165121, and single-flight-20261010-165152 agree, exit 0, DISAGREE 0. samples/ebpf_tworec (two self-tail methods, +3 and -2, each with continue and dead return 0): single-flight-20261010-165227, hopac-20261010-165252, and single-flight-20261010-165321 agree, exit 0, DISAGREE 0. samples/ebpf_t3 (self-tail returning a triple, live three fields, dead return (SpiralTuple0){0}): single-flight-20261010-165358, hopac-20261010-165414, and single-flight-20261010-165429 agree, exit 0, DISAGREE 0. samples/ebpf_snot (complement of runtime -1i32 and -8i32): single-flight-20261010-165553, hopac-20261010-165558, and single-flight-20261010-165604 agree, exit 0, DISAGREE 0. Out of v1: f64, i64/u64, NaN/infinity, strings, unions, arrays, closures, heap refs, globals, failwith, non-self-tail recursion, a kernel verifier.", Feature, P3, D6, 50u32, Active, "WASM-BACKEND,WGSL-BACKEND,CALYX-BACKEND,KOTLIN-BACKEND,SWIFT-BACKEND,OPENQASM3-BACKEND", "backend,compiler,est:900m,load:medium,agent:yes", "current", "current")
inl c_user_globals_dropped () = Task ("C-USER-GLOBALS-DROPPED", "C backend drops every user global: CodegenC seeds its dedupe set from env.globals (global x = if has_added.Add x then globals.Add x) but prints only its private globals buffer, never env.globals, so !!!!Global / core global \"...\" text (e.g. #include) never reaches C output; the same in upstream The Spiral Language 2/CodegenC.fs (lines 175-176, 898); every other codegen prints env.globals; CodegenC maps to the upstream file, so the fix goes upstream (COMPILER-UPSTREAM-ONION) instead of a local edit; repro: tmp/cglobal (global \"#include <tgmath.h>\" absent from main.c); lib/spiral math C arms use __builtin_* with _Generic meanwhile; 13:4x FIXED here (correction: the upstream-section exception was only for comment stripping; functional fixes in CodegenC are the normal workflow, exported to the fork with scripts/upstream.py export --since): the C program assembly now writes env.globals before its own includes (Seq.append env.globals globals), as every other codegen does; repro tmp/cglobal now emits #include <tgmath.h>; upstream PR candidate (The Spiral Language 2/CodegenC.fs line 898); 18:2x re-verified live with the committed compiler: a scratch repro (an !!!!Global call carrying the text #include <tgmath.h>) compiles to C and main.c carries #include <tgmath.h> on line 6, after the backend's own stdbool/stdint/stdio/stdlib/string includes (Seq.append globals env.globals in CodegenC, HEAD a602d846); the repro directory was deleted afterwards; the exported patch material at %LOCALAPPDATA%/spiral-bin/upstream-pr (2026-10-08) already contains the fix; opening the upstream PR is the user's call", TaskKind, P2, D2, 100u32, Done, "", "compiler,upstream,c", "current", "current")
inl ci_kino_shared_tmp_delete () = Task ("CI-KINO-SHARED-TMP-DELETE", "spiral ubuntu CI 18:34: 17 lib notebooks failed because spiral gleam/lua on CI delete their package dir = grandparent of the code file, which for Kino cells (/tmp/spiral_kino/<id>/main.gleam) is the shared /tmp/spiral_kino (other cells: could not write main.spi, remove_dir_all DirectoryNotEmpty); fix: package_owns_code (code under <package>/src) guards the CI deletion in process_gleam and process_lua; 21:1x verified locally with CI=1 and the Kino layout <root>/<id>/main.gleam plus a sibling <root>/other: unfixed CLI deleted the sibling and the root, fixed CLI keeps both (gleam.toml lands in the cell dir); apps/spiral rebuilt (run check: 43 notebook exports, rust/cuda ok) and shipped; first build failed because parsed_integer conv ran at peval for u = ref str via every BackendSwitch arm, now gated by a static integral check; 21:39 local CI=1 sweep with the fixed CLI: all 16 notebooks CI reported (sm, testing, guid, runtime, trace, resultm, base, date_time, math, optionm, listm, reflection, lustre, env, convert, console) exit 0 and %TEMP%/spiral_kino survives; parsing and file_system are the two known failures; awaits the next push; 01:2x spiral CI after the 21:49/22:56 pushes: only 2 notebooks left (from 17), and the new cause lines named them: date_time (Lua): ticks subtracted a hardcoded 14400 s (the authors UTC-4 offset) to cancel unix_epochs local-time os.time{1970..}, so it held only in UTC-4 (CI UTC: actual 6.21355824e17 vs 6.21355968e17, exactly 4 h); now subtracts the same os.time{1970..} value at runtime; file_system (Rust): asserted the cwd name was polyglot/spiral/fsharp, but programs run inside the spiral workspace inherit apps/kino (get_workspace_root_external is Error there by design); the test now asserts get_full_path \".\" names the same directory as get_current_directory (); verifying under CI=true and TZ=UTC0; 01:1x verified locally under CI=true: date_time passes with TZ=UTC0 (proven effective: os.time{1970} is 14400 locally, 0 under TZ=UTC0) and in local time, file_system passes; awaits push; 02:1x CI on the 00:31 push: polyglot green; dice ubuntu green, windows red only on the known WSL contract path (CI-SPIRAL-WASM-NATIVE); spiral red only on date_time + file_system, both fixed locally after that push (await the next push); 06:2x dice CI on the 05:40 push red on ubuntu: ui/rust_derive.ps1 stripped only numeric case names (U[SH]n_m), so readable US0_Some counted as an unknown type and US enums + the Heap structs holding them lost serde/borsh derives (5 E0277). Fixed the pattern to U[SH]n_<name>; regenerated dice ui passes cargo check locally. spiral + polyglot CI still running; 18:1x local re-verification under CI=true TZ=UTC0 with the shipped CLI: date_time exit 0 (228.9 s) and file_system exit 0 (123.6 s), and %TEMP%/spiral_kino survived the pair with 223 cell dirs before and after (the shared root is what process_gleam/process_lua used to delete); the notebook exports went to a temp dir so the tree is untouched; the CI run of those two notebooks lands with the next push", TaskKind, P0, D2, 100u32, Done, "", "ci,kino,spiral", "current", "current")
inl harness_native_lanes () = Task ("HARNESS-NATIVE-LANES", "spiral harness native tier ran ~1260 build-and-run jobs one after another (46 min of job time; 70 min suites under load): now 6 lanes (ForEach-Object -Parallel, SPIRAL_NATIVE_PARALLEL overrides), each with its own gleam project and zig cache, per-row native_ms in results.tsv; full suite single-flight-20261008-221030: 12.8 min wall, all 2036 rows parity, DISAGREE 0 (Gleam 1149 s and Lean 852 s of job time dominate)", TaskKind, P1, D3, 100u32, Done, "", "harness,performance", "current", "current")
inl dir_tree_html_repo () = Task ("DIR-TREE-HTML-REPO", "Move spiral/apps/dir-tree-html into its own repo i574n/dir-tree-html (C:\\home\\git\\dir-tree-html): spiral standards (build.ps1, staged native build with a run check, LF, no comments), reuse spiral (deps/spiral for core lib, BuildSpiral, scripts/core.ps1, CI shape), its own gh-pages CI, adapt every reference in spiral/polyglot/dice/i574n.github (workflow.ps1, spiral scripts/build.ps1, cargo workspace member); 23:2x moved: C:\\home\\git\\dir-tree-html holds build.ps1 (BuildSpiral -> dir_tree_html.rs -> cargo +nightly-2025-11-01 --release -> dist/DirTreeHtml + --self-test run check), Cargo.toml standalone with spiral release profile, package.spiproj core- from deps/spiral, scripts/init.ps1 (links deps/spiral to the sibling spiral checkout, cloning it when missing, then spiral scripts/init-app-build.ps1), scripts/workflow.ps1 + publish.ps1 (renders dist/index.html with itself), .github/workflows/gh-pages.yml (ubuntu+windows build, gh-pages push), LICENSE, LF; spiral: apps/dir-tree-html removed, workspace member + Cargo.lock entry dropped, scripts/init-app-build.ps1 extracted from init.ps1 (fork + app toolchain, reused by app repos), scripts/dir-tree-html.ps1 helper (repo next to the resolved spiral checkout, clone+build when the binary is missing, prints its path); consumers rewired: spiral workflow/publish, polyglot publish/publish-bin/build.livemd, dice init/publish/publish-bin, i574n.github init (clone + init) and build; verified locally: init + build + self-test ok, all 5 consumer call forms resolve to the new binary, render ok, 17 scripts parse, LF; awaits commit + push for its CI; 00:3x binary renamed DirTreeHtml -> dir-tree-html (the package name, Cargo default): [[bin]] keeps path = dir_tree_html.rs at the repo root, which makes cargo require name, so name = package name; build.ps1, publish.ps1, README and spiral scripts/dir-tree-html.ps1 use dist/dir-tree-html(.exe); rebuilt + self-test + publish index ok, helper resolves it from dice; 01:0x the published page (https://i574n.github.io/dir-tree-html/) showed only the linux binary: publish rendered dist/ instead of the repo tree; fix by reuse: spiral scripts/publish-tree.ps1 (extracted from spiral publish.ps1: rsync the repo with the standard filters into dist, _-rename dotfiles, render index; -Root, -Tool, copies the tool aside because dist is wiped), spiral publish.ps1 and dir-tree-html publish.ps1 both call it; rsync install for Windows moved from spiral init.ps1 into init-app-build.ps1; local Windows runs exposed a latent bug in the shared filter: choco rsync is cygwin and globbed the unquoted */ and * filters into extra sources (target/release leaked into dist), fixed with CYGWIN=noglob; verified: dir-tree-html dist = exactly its repo files + index, spiral dist top-level unchanged; awaits push. polyglot/dice/i574n.github publish.ps1 keep their own rsync copies (same latent glob bug on Windows) - move them to publish-tree next; 01:1x publish-tree.ps1 now serves all five repos (spiral, dir-tree-html, polyglot with -Include *.png, dice, i574n.github): one filter list built as an argument array, CYGWIN=noglob; each publish verified locally: exit 0, index rendered, no target/release leaks; -Include verified (*.lock adds Cargo.lock); 18:4x re-verified: the repo is clean at 43c3558 (4 commits) with dist/dir-tree-html(.exe) built, and publish-tree.ps1 serves all five consumers, spiral, dir-tree-html, polyglot, dice and i574n.github each calling it from their own scripts/publish.ps1; the commit and the push are the user's call", Feature, P0, D4, 100u32, Done, "", "repo,spiral,ci", "current", "current")
inl alphabet_ci_xelatex () = Task ("ALPHABET-CI-XELATEX", "alphabet CI red since 2025-11: apps/documents notebook asserts every crowbook output Ok, but on ubuntu-24.04 xelatex fails for test.md.pdf and test.hangul.md.pdf (\"xelatex did not return successfully\"); html/epub pass. Capture the xelatex .log in CI (missing TeX package or Nanum font with the cached texlive-xetex), fix the apt package set or the crowbook template. 2026-10-09: alphabet synced with dice (publish-tree.ps1, scripts/dir-tree-html.ps1, gleam 1.19.1, setup-bun); 2026-10-12: cause found: crowbook 0.17.1 tex.template needs hyphenat/breakurl/lettrine/stdpage/spverbatim/newunicodechar (texlive-latex-extra, confirmed hyphenat.sty via packages.ubuntu.com noble) and ulem (texlive-plain-generic); CI only installed texlive-xetex. Added both to gh-pages.yml apt step and scripts/init.ps1; plain + hangul PDFs build locally (MiKTeX); awaits CI after push; 2026-10-12 root cause from the new xelatex diagnostics step (run 38280261902): every package crowbook's template loads is present (english.ldf, lmodern, fontspec, xunicode ...), but hyperref under XeTeX (PU encoding) inputs puenc-greek.def, which Debian/Ubuntu ship in texlive-lang-greek (\"! LaTeX Error: File puenc-greek.def not found\", l.612, Emergency stop; MiKTeX installs it on demand locally, hence no local repro); fix (uncommitted): texlive-lang-greek added to gh-pages.yml apt packages and scripts/init.ps1; diagnostics step kept (runs only on failure)", Story, P2, D3, 90u32, Active, "", "ci,alphabet,dice-parity,est:90m,load:light,agent:yes", "current", "current")
inl backend_switch_hermetic () = Task ("BACKEND-SWITCH-HERMETIC", "BackendSwitch evaluation, state of the art for both cores: every non-current arm is evaluated in key order on every backend for its type only (compile-time state identical across backends, a type mismatch is an error everywhere, like Kotlin expect/actual), hermetically (throwaway seq, its own variable counter from 1<<<30 so no tag reaches the residual: single-flight had numbered around the discarded arms, the cause of the BackendSwitch cross-core residual class), once per (backend, arm closure) per build (type cache; hopac gains one, cleared with the JP dicts). Hopac validates again (backend_switch_validate_all on; it skipped other arms since 2026-10-02 for speed, unsound). 2026-10-12: edits in spiral_compiler.fs, unbuilt; proof ladder single-flight -> hopac -> restore pending; proven and blessed 2026-10-12 05:07: cross-core residual differences 83 -> 0, behaviour differences 0, hopac missing 0, restore 0 of 3,768; hopac rung 76 min vs 54.5 (validation cost ~40% under full load: next, evaluate type-check-only join points inline); 2026-10-12 closed: blessed twice (dev40 05:07, dev41 08:36), cross-core 0 differences; the ~40% hopac validation cost moves to HOPAC-SPEED", TaskKind, P1, D4, 100u32, Done, "", "compiler,hopac,parity", "current", "current")
inl c_format_any () = Task ("C-FORMAT-ANY", "C arm for lib sm_real format_debug_real (format of any value): frontier_format_any_union / frontier_join_format_any C rows build-fail on backend_switch_has_no_C_arm_in_lib_spiral, so Rust has no oracle there, and sm format test has no C expectation. Structure can reuse the portable serialize_union_rust/record_fold/tuple arms (as Zig/Lean do); the C-specific gap is primitive-to-string: lib globals precede the C prelude that defines StringLit, so a lib helper cannot build a String; needs a compiler-emitted helper or a portable Spiral digit loop; 2026-10-12 done in lib (sm.livemd cells 46/58/87, exported sm_real.spir): append_real C via StaticStringConcat, format_debug_real C arm (snprintf into a static buffer, String built at the call site with StringLit; shortest round-trip floats, quoted chars; unions/tuples/records/nominals/arrays via the portable arms), format_real C arms (empty, prim p with %+.6f/NaN/Infinity, append). frontier_format_any_union and frontier_join_format_any C now build and exit 0 (were build-fail); a probe of union/record/tuple/f32 formatting prints byte-identical text in C and Rust", TaskKind, P2, D4, 90u32, Active, "", "lib,c,format,est:60m,load:light,agent:yes", "current", "current")
inl self_checking_samples () = Task ("SELF-CHECKING-SAMPLES", "Samples and tests as self-checking source (user design session 2026-10-12, nothing fixed yet; dogfood before committing): no prose, code only; expectations live inline in the source of truth, expect-test style (ppx_expect, Rust expect-test/insta, Zig test blocks): a promote run rewrites the expected blocks in place, git diff is the review, a clean run leaves the file untouched, dev mode can persist cell results and clear them after a successful run; the oracle backend is configurable per file or cell (C default) and other backends are checked against it, replacing hand-written per-backend copies and the uncommittable cache EXPECTED.tsv; end state: .spi itself is the notebook (compiler-understood test blocks with inline expectations, Zig/Rust #[test]-like), .livemd becomes a view, so edits are plain file edits; negative samples stay as test blocks whose expectation is a diagnostic (rustc UI tests, clang expected-error); multi-file packages must work (package-manager litmus): measure the dice symlink cost on Windows, then compare compiler-resolved path dependencies (Cargo path/workspaces) with junctions. Phases: 1 benchmark the same sample family through the harness and through Kino (warm workers, parallel cells: KINO-PARALLEL-CACHE); 2 measure dice symlink package resolution on Windows; 3 dogfood one family (ebpf_* 27 samples) as an inline-expectation file with promote mode, keeping harness rows byte-identical; 4 decide; phase 2 first look 2026-10-12: dice reaches lib through two chained symlinks (dice/deps/polyglot -> polyglot, polyglot/deps/spiral -> spiral); raw I/O over the 315 lib .spi/.spir files through the chain is 1.4-2.5x slower warm (hundreds of ms at worst, not the main cost); the compiler normalizes package paths with Path.GetFullPath, which collapses .. but does not resolve links, so a package identity is the path spelling: the same lib reached as dice\\deps\\polyglot\\deps\\spiral\\lib and as spiral\\lib is two packages (parsed, cached and watched twice), the likelier cost and a blocker for one canonical identity per package in a package manager; next: time a dice compile via the link path vs the direct path, then try canonicalizing package roots (FinalPath/ResolveLinkTarget) in the compiler; test block prototype 2026-10-12: survey of the 39 lib notebooks: 1,904 cells, 364 test cells (44 static, 12 in .spir real code, 11 print_code), targets fsharp 169 / cuda 126 / rust 107 / gleam 93 / typescript 93 / lua 34 / c 1, per-target options (rust -d crates, gleam -t javascript -d), all timeouts default; test cells hold top-level-only statements (open, nominal, #r), so a test is a scoped group of top-level statements, not a function: syntax `///> target opts` lines then `test name [static] [print_code] =` with an indented body; semantics = file prefix up to the block + the body (Kino notebook-prefix semantics, Spiral is top-down so position preserves scope); compiler: blockParsingParse returns Error [] for a block starting with `test` (both cores; the same no-statement result as comment-only blocks), unbuilt; converter livemd -> spi/spir with test blocks reproduces the current exports byte for byte in 38 of 40 files (benchmark and lustre carry stale doc text from cell outputs); spi -> livemd adapter round-trips all 37 notebooks with every test source preserved (order of .spir tests and one directive line moved); next: run original vs regenerated notebooks through Kino and compare per-test results, then the build with the parser change; dice package identity fix (2026-10-12, unbuilt): canonical_directory in the shared SpiProj schema resolves every path component with Directory.ResolveLinkTarget (symlinks and junctions), used for packageDir/moduleDir combines and the default package dir, so a package reached through deps/polyglot/deps/spiral and through spiral/ is one package; no harness path crosses a link (checked), so sample outputs must stay byte-identical; to measure: a dice compile through the link path before and after, and dice/alphabet packageDir pointing straight at the sibling ../spiral/lib (CI and local init already create that layout); dice measured 2026-10-12 (cold compile of lib/dice.spi to Rust, one process each): old compiler through the symlinks 19.3 s, new compiler (canonical package dirs + tonight batch) through the symlinks 17.4 s, new compiler with packageDir ../spiral/lib (no links) 18.0 s; the new compiler output is byte-identical through links and without them (one package identity), so dice can drop the links; a single cold compile shows no real symlink cost, so the slowdown the user saw likely sits elsewhere (cargo/rustc over symlinked dirs, Kino watching, repeated warm compiles): measure those next. Test blocks: with the new parser all 364 test blocks embedded in 35 lib files compile to byte-identical C (pristine-copy check; an earlier failure came from stale files in a reused copy, not from test blocks); 2026-10-12 lib/spiral migrated (unstaged): the 39 lib notebooks are now their .spi (370 test blocks; sm' keeps its real-mode code and tests in sm'_real.spir); the 39 .livemd are deleted; Kino document domain (apps/kino/spi/document.spi, Spiral) gained to_spi_tested/to_spir_tested (test cells -> test blocks named by heading) and from_spi/parse_spi (blocks -> test cells), byte-identical to the validated prototype on all 37 notebooks (644 cells); run_notebook.ps1 --path x.spi runs a source file as a notebook and never writes over it; lib/spiral/build.ps1 and near/wallet/build.ps1 run .spi and write <nb>.spi.ipynb (README links -> .spi.html); evidence: per-test A/B original livemd vs round trip 353 tests in 31 notebooks same outcome, .spi run directly math/seq/sm' 79 tests same, the 7 lib-dependent harness samples 53 rows identical to the blessed repro, Kino mix test 140/0; open: the full lib build from .spi (running 09:30), then folder samples -> test blocks; 10:10 user committed the lib migration (dc7b955c 09:51); all 39 lib notebooks run from .spi with exit 0 (Kino run_notebook, 2 at a time), 268 tests in 29 notebooks have the same outcome as the original livemd runs (physics/parsing/rust outputs vanished before comparison, both matched in the A/B); .spi -> .livemd kept for a cell UI: from_spi now restores /// doc runs as markdown cells and adds a #### name (test) heading only when the name would not re-derive; run_notebook --livemd-path writes the Livebook view, --with-tests exports back; 39/39 lib notebooks .spi -> .livemd -> .spi byte-identical, 26/39 livemd byte-identical to the deleted originals, 3,503 of 3,531 old cells verbatim (sm' real cells move ahead of the rest); Kino mix test covers both properties; UI direction: Zed (LSP + runnables, ZED-TEST-RUNNABLES) as the editor, Livebook via --livemd-path for rich outputs; split 2026-10-12 into SAMPLES-TO-TEST-BLOCKS, TEST-EXPECT-PERSIST, CONFIGURABLE-ORACLE, KINO-RUN-ONE-TEST, NOTEBOOKS-TO-SPI-SIBLINGS, SPIR-INTERLEAVED-LIVEMD, ZED-TEST-RUNNABLES; children also TEST-RUN-REPORT, TEST-IDENTITY-I18N, SOURCE-BOUNDARY-AUTHORITY (from the 2026-10-12 external review of dc7b955c)", Epic, P1, D7, 55u32, Active, "", "samples,kino,compiler,dogfood,packages,est:300m,load:light,agent:no", "current", "current")
inl test_signal_metrics () = Task ("TEST-SIGNAL-METRICS", "Test signal and cost metrics drive sample cleanup (2026-10-12, mined from 926 single-flight + 710 hopac runs since 09-26, 362,684 rows): silent rows (no text or outcome change in 20+ runs) are only 3.5% of median cost, so pruning by silence alone saves little; Kotlin is 41% of the total cost (about 92 min native for 253 rows, ~22 s each, JVM kotlinc startup) with 13 rows that ever flipped: batch all Kotlin samples into one kotlinc run (one package per sample) and run each with java -cp; F# is 21% (compile only, mega_omniledger 180 s); the nested-combination families heap_/closure_/union_/array_/case_/method_/mut_ hold ~1,600 rows and about half the cost with at most 50 ever-flipped rows (case_: 323 rows, 0 flips): compact them into composite programs that cover many combinations per compile, keeping every ever-flipped row standalone; highest-signal families: native_ 391 flipped rows, dynamic_ 169, managed_ 108, ts_ 76, frontier_ 52; text-change co-change twins (1,965) are driven by global renames, so redundancy must be measured on outcome flips; next: Kotlin batching in test.ps1, a fast tier (all ever-flipped rows + one per family) for the edit loop, full matrix for bless; Kotlin done 2026-10-12: tests/native-shims/kotlin-server/KotlinServer.java compiles every Kotlin row of a run in one warm JVM (K2JVMCompiler in process, -no-stdlib against kotlin-stdlib.jar), a pre-pass in test.ps1 before the native lanes, lanes only run java -cp; Kotlin row median 285 ms vs ~22 s (single-flight-20261012-050734, all 246 rows agree, bless + reproduction 0 differences); a full single-flight suite 50 -> 26 min; next: same treatment for Swift (swiftc ~3 s/row), compaction of the low-signal families, the fast tier; 2026-10-12 12:00 recomputed over all single-flight runs (6,079 rows, 4,011 with >=5 runs, summed row time 8,162 s): signal (output changes + 2x status flips) concentrates in native_ (3,546), dynamic_ (1,218), managed_ (1,084), frontier_ (779), ts_ (631); silent cost concentrates in array_ (200 of 270 rows silent, 1,106 s), heap_ (205/276, 978 s), union_ (116/192), method_ (91/126), mut_ (65/90); negative_/contract_ rows are silent by design (stable rejections); coverage-first fast tiers (every backend and family, then signal per second): 300 s = 734 rows / 3.7% of the time / 51% of historical signal, 600 s = 1,098 / 7.4% / 73%, 1,200 s = 1,657 / 14.7% / 88%; lists in the job scratch (metrics/fast-tier-*.tsv, compaction.py); next: a harness fast suite from the 600 s list (harness.psd1, compiler lane) and folding the silent combinatorial families into fewer test blocks (SAMPLES-TO-TEST-BLOCKS); caveat: signal = changed during development, a proxy, not proof a row catches bugs", Feature, P1, D4, 70u32, Active, "", "harness,metrics,samples,performance,est:300m,load:medium,agent:yes", "current", "current")
inl fsharp_utf8_strings () = Task ("FSHARP-UTF8-STRINGS", "F# string semantics are .NET UTF-16 while Spiral strings index and measure UTF-8 bytes (C, Kotlin spiralStringIndex, Swift utf8, Wasm, Lean byte positions): 2026-10-12 once F# gained StaticStringConcat, samples/string_utf8 compiles and its .fsx exits 1 under dotnet fsi where C exits 0 (string_eq exits 0 like C); the harness never runs F# natively (test.ps1 excludes Fsharp from native jobs), so F# semantic gaps stay hidden: give F# UTF-8 byte semantics for length/index/slice (Encoding.UTF8 helpers like the Kotlin backend) and add an F# native tier through dotnet fsi or a compiled exe so F# rows are checked against the C oracle", TaskKind, P2, D4, 0u32, Planned, "", "fsharp,backend,strings,harness,est:240m,load:medium,agent:yes", "current", "current")
inl gleam_match_codegen () = Task ("GLEAM-MATCH-CODEGEN", "Gleam backend match codegen, found 2026-10-12 while writing apps/kino/spi/document.spi from_spi (both reproduce on the Kino domain build, worked around there): (1) a second match on a union already narrowed by an enclosing `| _ =>` branch emits a Gleam `case` with only the remaining arms, which Gleam rejects as inexhaustive (missing Us4InDoc/Us4InTest); emit an unreachable `_ -> panic` arm or the full case; (2) matching a single-case union returned by an inlined function (`match open_step ... with | Step (a, b, c) => ...`) emits a duplicate `_ ->` arm that references a/b/c, unbound there (Gleam: Unknown variable); a single-case union needs no default arm. Add both shapes as samples on the Gleam list; 2026-10-12 fixed by the compiler lane, committed by the user in feb8b9f7 (12:50): unbox emits no _ arm when one scrutinee covers every case and an explicit unreachable panic otherwise; samples gleam_match_narrowed / gleam_match_single_case on the Gleam list; the Gleam prelude split so spiral_math_pow is pure Gleam (gleam/float.power) and only emitted by Pow; residual: spiral_halt and 3 more Gleam prelude externals are still Erlang-only (JS-target programs that slice strings would fail); validation ladder running (compiler lane); CI confirmation 14:20: near_wallet gleam build --target javascript passes on ubuntu in run 38280264212", TaskKind, P2, D3, 85u32, Active, "", "gleam,compiler,codegen,est:180m,load:heavy,agent:yes", "current", "current")
inl zed_test_runnables () = Task ("ZED-TEST-RUNNABLES", "Zed runnables for Spiral test blocks: a languages/spiral/runnables.scm query tagging `test name =` (and the file) plus a task template calling apps/kino/spi/run_notebook.ps1 --path $ZED_FILE, so a test block gets a gutter run button like Rust #[test]; needs a run_notebook --test <name> filter that runs the prefix up to that block plus its body; Livebook stays the rich-output view via --livemd-path; 2026-10-12: grammar-free first step landed (untracked): spiral/.zed/tasks.json tasks \"spiral: run test at cursor\" and \"spiral: run file tests\" call apps/zed/tasks/test-at-row.ps1 -File $ZED_FILE -Row $ZED_ROW, which resolves the test block enclosing the cursor row (header or indented body; a top-level definition row runs the whole file) and runs run_notebook.ps1 --test <name> with the ipynb in the temp dir (-DryRun prints the command; checked on math.spi rows 2/3/8/16); gutter run buttons need a real grammar: the extension borrows tree-sitter-rust (languages/spiral/config.toml grammar = \"rust\"), which cannot see `test name =` blocks (TREE-SITTER-SPIRAL)", TaskKind, P2, D3, 50u32, Active, "KINO-RUN-ONE-TEST,TEST-RUN-REPORT,TREE-SITTER-SPIRAL", "zed,kino,tests,est:180m,load:light,agent:yes", "current", "current")
inl ci_after_spi_migration () = Task ("CI-AFTER-SPI-MIGRATION", "First CI runs after the 2026-10-12 commits (dc7b955c lib .livemd -> .spi with 370 test blocks, Kino from_spi/--livemd-path, DeadPureLetElision, Wasm str_cmp, canonical package dirs): spiral, dice, alphabet, polyglot must build lib from .spi with a compiler built from the same commit (an older compiler fails Package not loaded on test blocks); lib/spiral/build.ps1 runs 4 notebooks at once and was reaped locally at 16 GB, check runner memory and lower the throttle if needed; outputs are now <nb>.spi.ipynb/.spi.html; 2026-10-12 11:30 CI read: spiral ubuntu red on 2 runs (before and after the migration) in lib/spiral/near/wallet: gleam build --target javascript rejects the Erlang-only @external spiral_math_pow the Gleam integer prelude bundles (handed to the compiler lane); eoie ubuntu red: spiral apps/compiler/tmp/scripts/env.ps1:98 Join-Path $env:LOCALAPPDATA null on Linux in Swift tool detection, fixed (guarded like BendMain, verified with LOCALAPPDATA unset); alphabet red (ALPHABET-CI-XELATEX); i574n.github red since 05:22; dice and spiral 10:44 runs in progress; 11:40: spiral run 38265092981 (10:44 push 52311f0a, first CI of the .spi lib) died differently: exit 143 (SIGTERM, not a script error) 26 min into lib/spiral/build.ps1 -sequential 1 with zero output in between (15:01:11 -> 15:27:49Z; the build buffered each notebook's log until the end), so the culprit notebook or memory pressure is unknowable from that log; lib/spiral/build.ps1 now prints start/done lines per notebook (exit, attempts, seconds) as they happen; the near_wallet Gleam pow failure would still follow later in that job; 11:58 dice 10:44 run red on windows in contract/: process_rust runs spiral_wasm through invoke-block -Linux (exit 127 on the Windows runner); already decided in CI-SPIRAL-WASM-NATIVE: the NEAR sandbox is Linux/macOS only (near-sandbox-utils), so it is WSL-last work, no skip switch; 12:05 correction: the fine-grained-cells hypothesis for the 26 min SIGTERM was wrong; the Kino lane measured per-test planning (sm' 195 -> 38 steps) at 374 s -> 369 s, math 87 -> 86 s: definition-only steps compile fast, the cost is test steps building once per ///> backend (gleam/fsharp/cuda dominate; sm' summed: target 552 s, compile 507 s, daemon queue 521 -> 303 s, rustc 44 s); my 622 s was contention; the SIGTERM cause stays open until the per-notebook progress lines show it; CI-time levers: per-backend batching of a file's tests (one gleam project per file), cached target builds, fewer targets in CI; 12:42 lib/spiral/build.ps1 done lines now also carry the test counts (spiral-tests JSON: passed/failed/skipped, failed test names, a total line) and available memory (MemAvailable on Linux), so the next 143 shows which notebook ran and whether memory was falling; hypothesis to confirm, not act on yet: runner memory exhaustion with Kino's default 4 concurrent cells building gleam/fsharp/cuda targets (SPIRAL_KINO_CELL_CONCURRENCY=2 in CI would be the lever); 14:20 spiral CI GREEN on feb8b9f7 (run 38280264212, 1h18m, ubuntu + windows, pages deployed): the NEAR wallet Gleam build passes with the target-neutral pow, lib/spiral/build.ps1 reports 39 files / 368 tests passed / 0 failed from .spi on ubuntu, slowest sm' 162 s, parsing 146 s, base 124 s; available memory on the runner never under 8.2 GB, so the earlier exit 143 stays unexplained (not memory in this run; possibly runner-side); my earlier \"parsing 33/40\" came from a text heuristic in my A/B script, the Kino report says 40/40; still to confirm on the next pushes: eoie ubuntu (env.ps1 LOCALAPPDATA fix lands when eoie CI clones spiral), alphabet xelatex (packages + diagnostics step, uncommitted), i574n.github (same near_wallet fix); 14:35 eoie run 38280533281 (12:50 commits incl. the eoie lane's in-progress typed-fields crates) fails on windows in agile_planning_rollup/tests/planning_cli.rs: mutating verbs refused with \"lease authority blocked mutating effect because should_wrap=1\" (tests depend on the fixture's lease clock), handed to the eoie lane; the env.ps1 LOCALAPPDATA fix is confirmed on the next eoie run; alphabet: root cause found (texlive-lang-greek), fix uncommitted", TaskKind, P0, D3, 80u32, Active, "KINO-DAEMON-MEMORY", "ci,lib,kino,est:120m,load:light,agent:pair", "current", "current")
inl samples_to_test_blocks () = Task ("SAMPLES-TO-TEST-BLOCKS", "Folder samples (apps/compiler/tmp/samples, ~3,770 harness rows) become test blocks in .spi files, the way lib/spiral did on 2026-10-12: one file per family, each test block names its backends (///> targets) and its expected exit/stdout inline; the harness reads expectations from source instead of the cache-only EXPECTED.tsv; start with one low-signal family (heap_/closure_/union_ combinatorics, TEST-SIGNAL-METRICS) and measure suite time before/after; negative samples become test blocks expecting a diagnostic", Story, P1, D6, 0u32, Planned, "TEST-SIGNAL-METRICS,TEST-RUN-REPORT", "samples,tests,harness,est:1800m,load:heavy,agent:pair", "current", "current")
inl test_expect_persist () = Task ("TEST-EXPECT-PERSIST", "Expect-test mode for test blocks (user 2026-10-12): a run may write each block's observed result into the source (toggleable dev mode, ppx_expect / insta style) and clears it after a successful run; needs a result syntax under the test header that the parser skip already ignores", Story, P2, D5, 0u32, Planned, "SAMPLES-TO-TEST-BLOCKS", "tests,kino,samples,est:600m,load:medium,agent:pair", "current", "current")
inl configurable_oracle () = Task ("CONFIGURABLE-ORACLE", "The C oracle is configurable (user 2026-10-12): a harness/test-block option names the reference backend (C today; Zig once ZIG-HUB-SPEED reaches C speed), with agreement computed against it", Story, P2, D4, 0u32, Planned, "SAMPLES-TO-TEST-BLOCKS,ZIG-HUB-SPEED", "harness,oracle,est:360m,load:medium,agent:yes", "current", "current")
inl kino_run_one_test () = Task ("KINO-RUN-ONE-TEST", "run_notebook.ps1 --test <name>: run only the prefix of a .spi up to that test block plus its body, report pass/fail and output; prerequisite of ZED-TEST-RUNNABLES and of fast single-test loops; done 2026-10-12: run_notebook --test <name>[,name] runs only those test cells, each carrying its definition prefix and earlier static prelude tests (regression: --test square_2 alone keeps open testing); evaluate/2 tests: [names]; per-test planning for .spi (plan: :tests) measured neutral on time (sm' 195 -> 38 steps, 374 -> 369 s) and kept", TaskKind, P2, D3, 100u32, Done, "", "kino,tests,zed,est:180m,load:medium,agent:yes", "current", "current")
inl notebooks_to_spi_siblings () = Task ("NOTEBOOKS-TO-SPI-SIBLINGS", "Repeat the lib/spiral migration in dice (lib/dice, contract, fsharp), alphabet (documents, hangul) and polyglot notebooks: to_spi_tested export, build scripts run .spi, Kino tests move from livemd round trips to parse_spi; mirror every dice change in alphabet", Story, P2, D4, 0u32, Planned, "CI-AFTER-SPI-MIGRATION", "dice,alphabet,polyglot,kino,est:360m,load:heavy,agent:yes", "current", "current")
inl spir_interleaved_livemd () = Task ("SPIR-INTERLEAVED-LIVEMD", ".spi + _real.spir -> .livemd places real-mode cells before the rest, so sm'_real.spir does not round-trip byte for byte (the other 38 do); interleave by heading so the Livebook view of sm' matches the old notebook; done 2026-10-12: real-mode cells interleave by heading; repo-wide check sm'.spi + sm'_real.spir -> --livemd-path -> --export-only --with-tests gives both files byte-identical", TaskKind, P3, D3, 100u32, Done, "", "kino,livemd,est:120m,load:light,agent:yes", "current", "current")
inl swift_warm_compile () = Task ("SWIFT-WARM-COMPILE", "Swift rows cost ~3 s each (swiftc per file); batch or warm-compile them like the Kotlin server (one swiftc invocation for many modules, or swift-frontend batch mode) and measure the suite", TaskKind, P2, D4, 0u32, Planned, "", "swift,harness,perf,est:300m,load:medium,agent:yes", "current", "current")
inl backend_coverage_gaps () = Task ("BACKEND-COVERAGE-GAPS", "Shapes still unsupported per backend, from AGENTS.md: Kotlin/Swift (recursive unions, multi-value array elements, self-calling closures, stack/ref layouts, globals), Lean/Zig (stack layouts, C-only macros, BackendSwitch records without their key), Wasm (stack mutable layouts), Wgsl/Calyx/OpenQasm/eBPF subsets; drive each from the probe matrix and close one shape at a time", Feature, P2, D6, 0u32, Planned, "", "backends,codegen,est:3000m,load:heavy,agent:yes", "current", "current")
inl probe_matrix_run () = Task ("PROBE-MATRIX-RUN", "Run probe/probe-matrix.ps1 (259 portable samples x Wasm/Zig/Lean/Gleam/Lua/TypeScript/Bend vs the C oracle) on the main cache after the dev41 bless; feed new agreeing rows into the harness lists and the rest into BACKEND-COVERAGE-GAPS", TaskKind, P2, D2, 0u32, Planned, "", "harness,backends,est:120m,load:heavy,agent:yes", "current", "current")
inl zig_hub_speed () = Task ("ZIG-HUB-SPEED", "Zig as the hub backend instead of C, only once it runs at C speed (user direction 2026-10-07): close ZIG-FLOAT-FORMAT, compare Zig vs C on the mega/cube/benchmark samples, then make Zig the oracle candidate (CONFIGURABLE-ORACLE)", Epic, P1, D7, 0u32, Planned, "ZIG-FLOAT-FORMAT", "zig,perf,est:1200m,load:heavy,agent:yes", "current", "current")
inl lean_backend () = Task ("LEAN-BACKEND", "Lean 4 as a full backend (user direction 2026-10): harness rows agree with C today; extend to stack layouts, C-only macros via portable primitives, BackendSwitch records without a Lean key; track elaboration time per row", Feature, P2, D6, 0u32, Planned, "", "lean,backends,est:1500m,load:medium,agent:yes", "current", "current")
inl eoie_regen_drift () = Task ("EOIE-REGEN-DRIFT", "eoie follow-ups from the 2026-10-12 dogfood lane: the current compiler renames generated items and adds impl Default, so every regenerated .rs churns (a full regeneration touched 94 files and left eoie_cli at exactly the 1000-line gate); split eoie_cli before the next regeneration; regression tests for the new receipts (eoie_contracts is at 999 lines); move the remaining rust_global receipt call sites to granular Spiral; 2026-10-12: `agile check <root>` without --compiler stops with \"state drift requires build-time Spiral attestation\" instead of finding the deployed compiler (spiral-bin single-flight SpiralCompiler.dll); with --compiler it passes; default to the deployed compiler or name it in the error", TaskKind, P2, D3, 0u32, Planned, "", "eoie,compiler,est:300m,load:heavy,agent:yes", "current", "current")
inl spiral3_editions () = Task ("SPIRAL3-EDITIONS", "Spiral 3 as an edition of the fork, both editions in one compiler (user 2026-10-12: mrakgr has not touched the language for over a year): edition per package in package.spiproj (Rust-edition style, mixed-edition imports allowed), lexical only: the tokenizer var table (spiral_compiler.fs ~43072, words -> TokKeyword Spec*) gets an edition-3 table mapping symbol keywords to the same Spec tokens and the operator lexer consults it first, so parser/typecheck/peval/backends stay shared; start from geandra_v0_4.py FORWARD (inl :=, let :~, rec ^, union :|, match ?=, nominal :!, prototype :?, instance :+, fun \\, if ?, else |:, ...) and audit collisions per edition (=> already a match arm); keep dot record access, 2-space indent as the edition-3 formatter default (parser is column based, verify); test blocks need an edition-3 spelling; gate: spiral convert --edition 3|2 round-trips every sample and lib .spi byte for byte and both editions compile to identical residuals; 2026-10-12 first collision audit (regex lexer over 1,739 .spi in spiral lib + samples, dice/lib, eoie/src; script tmp/edition3/collisions.py): 25 of the 29 FORWARD symbols never occur as operators today (free: !+ !- &= -| :! :+ :< := :== :? :| :~ ;; ?& ?: ?= \\* \\? \\| ^ |: |? ~> ~~ ~~>); => occurs 10,932 times as the match/lambda arrow (reusing it for then/with is a parser-context question, not a lexer clash); a real clash: & is pattern conjunction (`{ level } & trace_state`, 4 uses) so `and` needs another symbol in edition 3; the ? (60) and \\ (41) hits look like $'...' macro-string escapes the regex does not model, so redo the audit with the compiler tokenizer (SOURCE-BOUNDARY-AUTHORITY) before deciding", Epic, P1, D7, 0u32, Planned, "SOURCE-BOUNDARY-AUTHORITY", "compiler,edition,syntax,est:1800m,load:heavy,agent:pair", "current", "current")
inl edition3_golden_sample () = Task ("EDITION3-GOLDEN-SAMPLE", "The chat's worked program (canonical_form_certificate/main.spi at 31d26ec4, the geandra_v0_4.py fixture: unions, nominals, prototypes/instances, lambdas, records, GADT signatures, existentials) as the first edition-3 golden test: same residual as its edition-2 original on C and Rust; the Python prototype's 116 tests become acceptance cases for the real compiler instead of a separate implementation", TaskKind, P2, D3, 0u32, Planned, "SPIRAL3-EDITIONS", "edition,samples,est:240m,load:medium,agent:yes", "current", "current")
inl test_run_report () = Task ("TEST-RUN-REPORT", "The test command reports discovered/executed/passed/failed/skipped/unsupported per file and in total; a deliberately failing test block fails the test command while an ordinary build stays green (the compiler skips blocks, so a green build says nothing about tests); from the 2026-10-12 review of dc7b955c; done 2026-10-12 (Kino lane, unstaged in apps/kino): Notebook.evaluate/2 in-memory entry point with per-test verdicts and a report (discovered/executed/passed/failed/skipped/unsupported/filtered/not_run); run_notebook prints one `spiral-tests file {json}` line per source file (a .spi with real tests also gets its _real.spir line) plus `spiral-tests total {json}`; non-zero exit on any failed test or cell error; lib/spiral/build.ps1 prints per-notebook and total counts and the failed test names from those lines; Kino mix test 151/151", TaskKind, P2, D3, 100u32, Done, "", "tests,kino,est:240m,load:medium,agent:yes", "current", "current")
inl test_identity_i18n () = Task ("TEST-IDENTITY-I18N", "Test names are derived through test_name_set (ASCII letters, digits, _), so Korean/Chinese/Hindi headings collapse to generic names: separate a stable test identity, a localized title, and a backend-safe symbol (three fields, not one string); done 2026-10-12: report rows carry \"symbol\" (ASCII backend-safe, e.g. test_u441_...) and \"title\" (the Unicode heading); a Unicode --test сложение passed through pwsh -> mix -> erl in a real run; lib .spi files stay byte-identical through the round trip", TaskKind, P2, D3, 100u32, Done, "", "tests,i18n,est:180m,load:light,agent:yes", "current", "current")
inl source_boundary_authority () = Task ("SOURCE-BOUNDARY-AUTHORITY", "Kino finds test blocks with line heuristics (spi_walk/header_of: column-0 test header, 4-space body) while the compiler skips them in BlockParsing: make the compiler the one authority on source boundaries (expose test-block spans/bodies from its tokenizer), reuse it in Kino, the formatter and the notebook renderer; add tests for multiline strings, (* *) comments, malformed headers, tabs; record the indentation convention per edition (4-space extraction is a compatibility rule, not the edition-3 rule)", TaskKind, P2, D4, 0u32, Planned, "", "compiler,kino,tests,est:480m,load:heavy,agent:yes", "current", "current")
inl multilingual_presentation () = Task ("MULTILINGUAL-PRESENTATION", "One resolved program, several human presentations (Korean/Chinese/Hindi/Russian/Arabic and the original names): binding-aware alias tables that rename bindings only (never literals, JSON keys, FFI/external protocol names), checked by identical compile results; a pinned UAX #31 identifier profile with NFC for names only (string contents preserved); agents propose names and docs, tooling verifies; prototype mapping exists for the certificate sample (66 spellings, 4 presentations round-trip)", Epic, P2, D7, 0u32, Planned, "TEST-IDENTITY-I18N,SPIRAL3-EDITIONS", "i18n,edition,agents,est:3000m,load:medium,agent:pair", "current", "current")
inl query_cache_compiler () = Task ("QUERY-CACHE-COMPILER", "Persistent incremental compilation as a query system, not a pile of cached ASTs: layers parse -> resolve -> typecheck -> specialize -> codegen -> native; absence is a dependency (a new instance/export can change old results); specialization discovers dependencies while it runs (static args, instance env); recursive groups get group identities; early cutoff when a derived result is unchanged; builds on HOPAC-WARM-SERVER and the Kino warm server (KINO-SOTA)", Epic, P2, D8, 0u32, Planned, "HOPAC-WARM-SERVER", "compiler,perf,cache,est:6000m,load:heavy,agent:pair", "current", "current")
inl hopac_coordination_kernel () = Task ("HOPAC-COORDINATION-KERNEL", "A reference state machine for the hopac model (choices with losing alternatives, shared result cells, cancellation scopes, owned evaluation contexts; cancellation requested != task finished != state reclaimable), with the fork's documented failures as the regression corpus (shared fresh-ID counters, duplicate parent replay, incomplete placeholders, cross-build contamination fix 57); then Rust (crossbeam, arenas matched to protocol lifetimes) and Gleam (subjects) implementations compared by event histories, clean vs incremental, sequential vs parallel; related: HOPAC-WARM-SERVER (fix 57 is one of the corpus failures) and KINO-SPIRAL-GLEAM (the Gleam side shares the subject-based runtime)", Feature, P2, D7, 0u32, Planned, "", "hopac,concurrency,rust,gleam,est:2400m,load:medium,agent:pair", "current", "current")
inl executable_atlas () = Task ("EXECUTABLE-ATLAS", "A small redacted executable atlas from the espiral-comum repos (gh-pages: HPOW.md, EC2025*.md, KMLs, PDFs): source objects (exact bytes, revision), claims, checks (programs with declared parameters), results (with limitations), presentations (prose, map, notebook, translation); first checks: arithmetic claims (1943 = 29 x 67 is not prime), distance under declared models (sphere 6371 km vs WGS84 differ: ~816.92 vs ~817.68 km), KML metadata lint (dragon alpha24 file names itself alpha23), PDF signature verification as a separate layer (RFC 3161); keep private coordinates and identifiers out of any public demo", Feature, P3, D6, 0u32, Planned, "TEST-RUN-REPORT", "atlas,kino,tests,est:1200m,load:medium,agent:pair", "current", "current")
inl ml_labs () = Task ("ML-LABS", "Revive mrakgr's Spiral-s-ML-Library work as two bounded labs before renting GPUs: Tensor Lab (typed op graph, dimension propagation, storage planner with a CPU reference, then selected GPU kernels) and Leduc Lab (pinned rules/observations, the actual CFR/CEM variants, independent checks); separate same-model-better-execution from different-model results; keep seeds, environment, failed trials with each result", Epic, P3, D7, 0u32, Planned, "", "ml,benchmarks,est:3600m,load:heavy,agent:pair", "current", "current")
inl package_registry_design () = Task ("PACKAGE-REGISTRY-DESIGN", "Package manager design: exact caller-pinned locks (the prototype's plan format), declared capabilities checked at install, index separate from blob storage (crates.io model: index + object storage/CDN; Cloudflare R2 candidate), signatures; social platforms (X/Bluesky/Mastodon) only as optional mirrors and discovery, never the source of truth", Story, P3, D5, 0u32, Planned, "", "packages,registry,est:600m,load:light,agent:pair", "current", "current")
inl social_transport_sim () = Task ("SOCIAL-TRANSPORT-SIM", "X-like simulator as Kino's battle test (user 2026-10-12: deferring it was a bad call; it truly battle-tests Kino): a deterministic, seeded event simulator of many humans/agents publishing Spiral cells as posts (post, reply = downstream cell, quote/link = upstream dependency, edit = new revision, delete, like = demand/interest, unlike = withdrawn demand), with delayed, duplicate, reordered and stale deliveries and cancelled consumers, driving Kino's real compile/run path (warm server, concurrent cells over shared prefixes); invariants checked on every schedule: each visible result equals the sequential re-run of its exact revision, stale revisions never surface, shared prefixes compile once (cache hits counted), withdrawn demand cancels work and frees memory, no cross-request contamination (hopac fix 57 class), equivalent reorderings commute; phase 1: event log format + replay runner + 5 invariants + a 100-cell scenario from lib notebooks; phase 2: scale (10^4 cells), memory ceilings, agent personas; later: transport frames (280-char, twitter-text v3 weighting, NFC) and optional real X/Bluesky/Mastodon mirrors; 2026-10-12 phase 1 built (apps/xsim, untracked, Elixir, path dep on apps/kino): Scenario (cells of any .spi via Kino parse_spi -> posts: definitions as a reply chain, tests replying to the latest definition; seeded likes/unlikes/edits; deliveries shuffled in a window with duplicates), World (idempotent per event index, causal per post+user, replies/edits/likes before their post buffered), Runner (demand-driven: wanted posts -> prefix chain key -> one task per key, cancel on withdrawn demand or edit, results in completion order), Invariants (sequential equivalence vs a fresh baseline, no stale results, one compile per prefix, withdrawn demand hidden, commute across schedules), fault knobs (naive_visibility, cancel: false, rerun_completed, leaking executor) each proven to trip its invariant; mix test 8/8 x5 seeds; mix xsim.run on lib math/date_time/sm' with the fake executor: up to 195 posts, 1,068 deliveries, 104 duplicates, 80 buffered, all invariants ok, commute ok; a leaking executor fails sequential equivalence and commute; next: --executor kino on Kino's new in-memory Notebook.evaluate (agent B), then scale and memory ceilings; 11:55 first runs on real Kino (Notebook.evaluate): two genuine findings, KINO-SOURCE-DIAGNOSTICS (temp paths make outputs nondeterministic) and TEST-PRELUDE-SEMANTICS (tests depend on an earlier static test's open); xsim now models Kino's linear prefixes (tests on the trunk, --branch tests optional) and normalizes temp paths; 12:15 simulator made incremental (prefix key = H(parent key, source), edits re-key only their subtree, the runner only touches posts each delivery changed, refcounted prefix keys, lazy prefix sources): full lib corpus (36 notebooks with tests as interleaved author threads, 1,651 posts, 5,916 deliveries, 529 duplicates, 4 edits + 2 breaking edits per thread) 626.5 s -> 17.5 s simulator time with the fake executor, ~linear (228/535/1,651 posts: 2.3/5.1/17.5 s), every invariant and commute ok; tests 10/10 (new: root edit re-keys the subtree); multi-notebook corpus (--spi a,b,...) and --breaking edits added; 12:25 transport frames: Xsim.Frames splits a cell into numbered frames within 280 weighted characters (twitter-text v3 ranges: Latin weight 1, CJK/Hangul 2; NFC; split at grapheme boundaries; header \"<post> k/n\"), World buffers frames per post and applies the rebuilt post at its earliest frame index once complete (parent missing -> pending), --frames in mix xsim.run; tests 12/12 (Hangul cell -> several frames, each <= 280, shuffled rebuild exact; framed corpus with 30% duplicates and a 20-wide shuffle window keeps every invariant and commutes with the unframed run); 12:20 real-Kino finding KINO-DAEMON-START-RACE; 12:40 --churn N (N edits cycling the root of each thread, woven through the stream: agent-rewrite storms re-key every prefix and cancel in-flight work) exposed an over-strict invariant, not a runner bug: cancelled-then-restarted prefixes counted as double compiles (14 cancels, 5 keys restarted); one_compile_per_prefix is now starts - cancellations <= 1 per key (the rerun_completed fault still trips it); --save/--replay delivery logs (JSON lines) for exact bug reproduction; full lib corpus with frames: 1,651 posts -> 6,643 events, ~8,000 deliveries incl. ~1,330 duplicates, all invariants + commute ok in 20-24 s per schedule; tests 14/14; 12:50 phase-2 scale reached with the fake executor: lib corpus x6 as 216 author threads (--spi-file, since mix.bat caps the command line at 8,191 chars), 9,906 posts -> 40,585 events -> 46,604 deliveries incl. 6,019 duplicates, all framed, with edits, breaking edits and root churn: every invariant + commute ok, 118.9 s simulator time, peak BEAM 110 MB, 300 s wall incl. the sequential baseline; next: real-Kino scenarios at growing size, memory ceilings of the daemon side, agent personas; 13:20 in CI (uncommitted): apps/xsim/build.ps1 (mix test; the framed lib corpus with edits, breaking edits and churn over 2 schedules + commute; unless -fast a cold 2-concurrent real-Kino scenario that guards KINO-DAEMON-START-RACE, then the daemon is stopped) runs from spiral scripts/build.ps1 after the lib notebooks; local -fast run 190 s wall incl. deps and compile; 14:20 semantic oracle added after the KINO-C-FALSE-PASS report: breaking edits are known-wrong revisions, so on the real Kino path any visible ok result for a post whose current revision is a breaking edit is a violation (breaking_edits_fail); a lenient executor that passes everything is caught, an honest one is not (test); the concurrent-vs-sequential invariants alone cannot see a false pass because both sides are wrong the same way; tests 15/15", Epic, P1, D7, 65u32, Active, "", "social,simulator,kino,stress,est:2400m,load:heavy,agent:pair", "current", "current")
inl language_name () = Task ("LANGUAGE-NAME", "Pick the edition-3 language name once SPIRAL3-EDITIONS parses real programs (votes 2026-10-12: Espira 835, Spile 790, Geandra 610 - Geandra as a release codename); prefer a name that keeps .spi/package.spiproj; run a real clearance search before announcing", TaskKind, P3, D2, 0u32, Planned, "SPIRAL3-EDITIONS", "naming,edition,est:60m,load:light,agent:no", "current", "current")
inl eoie_agile_typed_fields () = Task ("EOIE-AGILE-TYPED-FIELDS", "eoie agile typed planning fields instead of key:value tags (user 2026-10-12): estimate_minutes, load (light|medium|heavy: memory/CPU class on the 16 GB box), assignee kind (agent|pair|user), and a show/list/edit surface for them, modeled as typed Spiral in the agile domain (agile.spi records + verbs), with a one-time migration of the est:/load:/agent: tags written on 2026-10-12; list filters (--load heavy, --agent yes) and a planned-minutes rollup per status/epic so the backlog answers what can run in parallel tonight", TaskKind, P2, D4, 0u32, Planned, "", "eoie,agile,dogfood,est:360m,load:heavy,agent:yes", "current", "current")
inl tree_sitter_spiral () = Task ("TREE-SITTER-SPIRAL", "A real tree-sitter grammar for Spiral (both editions) to replace the borrowed tree-sitter-rust in apps/zed: top-level inl/let/type/union/nominal/prototype/instance/open, test blocks with ///> targets, doc runs, macros ($\"...\" $'...' !!!!), so highlights/outline/indents are exact and runnables.scm can tag each `test name =` for gutter run buttons; generate edition-3 symbol tokens from the same table as the compiler tokenizer (SPIRAL3-EDITIONS)", Feature, P2, D6, 0u32, Planned, "", "zed,grammar,editor,est:900m,load:light,agent:yes", "current", "current")
inl kino_source_diagnostics () = Task ("KINO-SOURCE-DIAGNOSTICS", "Found by xsim 2026-10-12: Kino diagnostics embed the per-request temp path (\".../Temp/spiral_kino/1791819891254-162/main.spi:10:8: Unbound variable ...\") so identical inputs give different text and the location points at a throwaway file; map diagnostics back to the source (.spi path + line, or cell index + line within the cell) so results are deterministic and clickable (Zed problem matcher); xsim normalizes the temp dir meanwhile; temp dir now stripped case-insensitively (either slash, optional file:///), messages read main.spi:10:8 and identical inputs give identical text (regression test); mapping main.spi lines back to the .spi line / cell is still open", TaskKind, P2, D3, 60u32, Active, "", "kino,diagnostics,xsim,est:180m,load:medium,agent:yes", "current", "current")
inl test_prelude_semantics () = Task ("TEST-PRELUDE-SEMANTICS", "Found by xsim 2026-10-12: lib .spi files carry test-only imports inside the first static test block (math.spi `test math static =` / `open testing`), and later test blocks only see _assert_* because Kino chains every earlier cell, tests included, into each prefix; a single test run in isolation (--test, Zed run-at-cursor, per-test planning) or a test-only program built from definitions + its own body fails with Unbound variable _assert_approx_eq; define the semantics explicitly (a test prelude block, or each test program = definitions + earlier static test bodies + own body), keep it identical across run_notebook, --test, plan: :tests and the edition-3 spec, regression: --test square alone on math.spi passes; resolved same day by the Kino lane: a static test block is kept as a definition, so its body reaches every later step's program in per-cell, per-test and --test runs; regression in notebook_report_test.exs (--test square_2 alone carries open testing); the xsim failure came from xsim's own branching-tests model, now linear like Kino", TaskKind, P1, D3, 100u32, Done, "", "kino,tests,semantics,est:180m,load:medium,agent:yes", "current", "current")
inl kino_daemon_start_race () = Task ("KINO-DAEMON-START-RACE", "Found by xsim 2026-10-12 12:20 on the real path: two concurrent Spiral.Kino.Notebook.evaluate calls from a cold start: one returns {:error, \"compiler on port 13905 did not start\"} (no verdict, no outputs) while the same program passes sequentially; the run took 208 s vs ~26 s at concurrency 1 (the loser waits out a start timeout); hypothesis: concurrent CompilerClient.ensure callers race to start the daemon on one port and the loser fails instead of waiting for the winner; fix with a single-flight start (lock or registered starter, a live daemon with the right banner counts as success) and a test of N concurrent evaluate calls on a cold daemon; repro: mix xsim.run --spi lib/spiral/math.spi --cells 3 --executor kino --max-concurrency 2 after stopping daemons; 12:25 two causes found by the Kino lane and fixed in apps/kino: (a) the daemon code stamp was the CompilerDaemon .beam mtime, so two builds of identical code (apps/kino vs apps/xsim's dep copy) kept retiring each other's daemon; now the md5 of the loaded code; (b) a port that dropped mid-handshake waited the full 180 s instead of launching; daemon tests 14/14 + a stamp test; cold 2-concurrent xsim repro pending; 12:30 verified by xsim: the cold 2-concurrent repro passes every invariant in 26.6 s (was a start failure after 208 s); warm daemon at concurrency 4 over 8 prefixes also passes", TaskKind, P1, D3, 100u32, Done, "", "kino,concurrency,xsim,est:180m,load:medium,agent:yes", "current", "current")
inl kino_daemon_memory () = Task ("KINO-DAEMON-MEMORY", "Found by xsim + the resource sampler 2026-10-12: the Kino compiler daemon (dotnet compiler server) grows with every distinct program it compiles and is never trimmed: a 22-prefix math.spi scenario at 4 in flight took it from 4.4 GB (12:52) to 7.0 GB (13:00), free memory stayed under ~1 GB for 13 min and the heavy queue stalled 20 min until it was stopped; also the best lead for the spiral CI exit 143 (a 39-notebook sequential lib build feeding one daemon on a 16 GB runner); fix: the daemon retires itself (drain, exit, next client relaunches) above a working-set threshold (env, default ~2.5 GB) or after N compiles, with a test; verify with xsim + sampler (peak daemon GB under the threshold); 13:20 implemented by the Kino lane (uncommitted): after each compile the daemon reads its .NET compiler server's working set and, past SPIRAL_KINO_DAEMON_MAX_MB (default 2500) or SPIRAL_KINO_DAEMON_MAX_COMPILES (default off), stops that server and logs \"compiler recycled after ...\"; the daemon keeps its port and queue, so no client relaunch; verification with a 700 MB cap running; main session will re-verify with xsim + sampler; 13:35 verified by the Kino lane: math.spi with SPIRAL_KINO_DAEMON_MAX_MB=400 passed 15/15 with 3 recycles (\"compiler recycled after reaching 411/416/407 MB\"), compiler server peak 412 MB, 249 s wall (each recycle costs a cold compile); tests for the recycle policy and the working-set reader; caveat: checked after each compile, so one huge compile can overshoot before recycling; also seen: a cold daemon start costs ~1 min because its own mix waits for the build lock held by the client's mix (KINO-COLD-START-LOCK)", TaskKind, P1, D3, 90u32, Active, "", "kino,memory,ci,xsim,est:180m,load:medium,agent:yes", "current", "current")
inl kino_cold_start_lock () = Task ("KINO-COLD-START-LOCK", "Found 2026-10-12 by the Kino lane: a cold Kino compile daemon takes ~1 min to start because the daemon's own `mix` waits for the build lock held by the client's `mix` (\"Waiting for lock on the build directory\" in kino-<port>.err.prev.log); start the daemon from the already-compiled code path (no mix, e.g. elixir -pa _build/.../ebin) or release the client lock first", TaskKind, P2, D2, 0u32, Planned, "", "kino,startup,est:120m,load:light,agent:yes", "current", "current")
inl kino_result_memo () = Task ("KINO-RESULT-MEMO", "User priority 2026-10-12 13:58 (\"each cell run should be instant, memoized by the compiler and kino\"): memoize every Kino plan step on disk keyed by a hash of what determines its result (full program text = prefix + body, target/backend set, compiler build identity, Kino code md5, relevant options); bounded store under the spiral-bin cache, SPIRAL_KINO_MEMO=0 opt-out, memo hit|miss per test in the report and hit counts on the spiral-tests lines; acceptance: re-running an unchanged .spi is near-instant with identical outputs/report, editing one test re-runs only steps whose program changed; baseline (tibia lane, warm daemon, unchanged files): geometry.spi 8 tests 65 s, vitality.spi 5 tests 30 s, coins.spi 5 tests 35 s (6-8 s per test block); assigned to the Kino lane 14:00, xsim verifies; the compiler-side layer is QUERY-CACHE-COMPILER", TaskKind, P0, D4, 0u32, Planned, "KINO-C-FALSE-PASS", "kino,cache,performance,est:240m,load:medium,agent:yes", "current", "current")
inl upstream_syntax_sync () = Task ("UPSTREAM-SYNTAX-SYNC", "Found 2026-10-12 by the tibia lane probing mrakgr's Spiral-s-ML-Library: upstream head (Dec 2025) uses syntax the fork's compiler lacks (unary deref `*x`: 135 errors; nullary `forall t. : t`), and the Feb-2025 snapshot 0f76adf breaks because the fork made '#' an escape inside $\"...\" (upstream writes `# type: ignore`); port the upstream syntax into both cores and make the # escape edition-aware (SPIRAL3-EDITIONS) so upstream programs keep compiling; also compiler CLI --default-int/--default-float on the direct --backend path (the ML lib assumes i32/f32, the fork defaults f64), queued to the compiler lane", Feature, P2, D5, 0u32, Planned, "COMPILER-UPSTREAM-ONION", "compiler,upstream,syntax,est:600m,load:heavy,agent:yes", "current", "current")
inl kino_c_false_pass () = Task ("KINO-C-FALSE-PASS", "Found 2026-10-12 ~14:15 by the tibia session: Kino targets.ex cell_exit returns exit_status 0 for `///> c` (and Delphi via run_dcc) and moves the program exit code into value, so a failing assertion passes (hunt_sim.spi golden_seed_7_on_c with expected 7 -> 8: \"__assert_eq { actual = 7; expected = 8 }\", value=1, status=passed, run exit 0); a ///> c cell also runs only C; fix like the Rust path (value line + exit 0, non-zero only on failure) with a deliberately failing C test as regression, then re-run lib notebooks with ///> c/delphi tests and list tests that flip to failed (hidden failures); assigned to the Kino lane before KINO-RESULT-MEMO; fixed 14:20 by the Kino lane (uncommitted): for c/cpp/delphi a non-zero program exit now fails the cell (\"builder failed (exit N)\" + output) and exit 0 passes with no value; regressions in targets_test.exs (C __assert_eq exit 1 -> error, cpp exit 7 -> error); the old test encoding the bug was removed; a ///> c cell running only C is by design (a cell's ///> lines are its whole target list, README says so); blast radius in lib: only sm'.spi test format targets C (re-run queued); no false pass was memoized (memo not landed yet); verified 14:25 by the tibia session: hunt_sim.spi golden_seed_7 with ///> rust + ///> c passes with both target streams, the 7 -> 8 mutation fails (run exit 1); apps/tibia regression 7 files / 40 tests / 0 failures, 489 s under load (also the KINO-RESULT-MEMO baseline)", TaskKind, P0, D3, 100u32, Done, "", "kino,tests,correctness,est:120m,load:medium,agent:yes", "current", "current")
inl tibia () = Task ("TIBIA", "Tibia as the dogfood project (user 2026-10-12): typed Tibia rules in Spiral (apps/tibia, .spi modules with test blocks, Rust on CPU and WGSL on GPU from one source) and agents measured on a published OT Agent Arena against the best open-source bots; tooling improves first, the goal advances only where the road is clean; latest of everything (Canary 3.6.1, OTClient Redemption 4.1); plan in apps/tibia/*.md (transitional, see TIBIA-DOCS-TO-CODE)", Epic, P1, D8, 0u32, Planned, "", "tibia,dogfood,est:9600m,load:medium,agent:pair", "current", "current")
inl tibia_local_world () = Task ("TIBIA-LOCAL-WORLD", "Local world, all prebuilt: Canary 3.6.1 (opentibiabr/canary 2026-07-01, canary-windows-cmake-release.zip, map otservbr.otbm, GPL-2.0) + OTClient Redemption 4.1 (opentibiabr/otclient 2026-08-15, otclient-windows-solution-opengl.zip) + MariaDB + the official 15.x client assets the client needs; exit: log in, walk, kill a creature; keep binaries outside the repos", TaskKind, P2, D3, 0u32, Planned, "TIBIA", "tibia,server,est:600m,load:medium,agent:pair", "current", "current")
inl tibia_typed_rules () = Task ("TIBIA-TYPED-RULES", "Hunt subset of Canary's rules as Spiral modules in the apps/tibia package (grid and floors, creatures melee/ranged/flee, cooldown groups, HP/mana, potions, loot, death penalty); integer-only so CPU and WGSL traces are bit-identical; started 2026-10-12, all passing through run_notebook: geometry.spi (8 incl. prelude), vitality.spi (5, GADT typestate living/fallen), coins.spi (5, gold/platinum/crystal conservation), rng.spi (6, counter-based lowbias32 keyed by seed/tick/entity/purpose, reference values from an independent implementation), cooldowns.spi (6, spell groups plus own cooldown), hunt.spi (4, uses other modules via ///- --package .), hunt_sim.spi (6, deterministic 600-tick hunt, golden seed 7 = 7 kills/140 gold/69 health); every rules test lists ///> rust and ///> c (40 tests, 0 failures, 489 s full run 2026-10-12)", Feature, P1, D6, 0u32, Planned, "TIBIA,TEST-EXPECT-DIAGNOSTIC", "tibia,spiral,tests,est:1800m,load:light,agent:yes", "current", "current")
inl tibia_fidelity () = Task ("TIBIA-FIDELITY", "Diff the simulator against Canary as the oracle: deterministic mechanics bit-exact, RNG mechanics through a seeded local Canary build or distribution tests of its damage/loot formulas; one verdict per mechanic, every gap named", Feature, P2, D6, 0u32, Planned, "TIBIA-TYPED-RULES,TIBIA-LOCAL-WORLD", "tibia,oracle,est:1800m,load:medium,agent:pair", "current", "current")
inl tibia_baselines () = Task ("TIBIA-BASELINES", "Arena baselines on a frozen scenario pack: headless protocol client (Spiral/Rust), nExBot (github.com/mCodex/nExBot, pushed 2026-09-01, no license file detected: confirm), vBot (OTClient Redemption 4.1 ships mods/game_bot with default_configs/vBot_4.8 and cavebot_1.3, so it runs on Canary's protocol 1511; also in OTCv8/otclientv8, which stops at 11.x), a scripted cavebot, a random-policy control; parity rules (15x11 view, one action-rate cap, same character/supplies/seeds); real-time evaluation budget ~150 h of play per pass at 2-3 client+server pairs", Feature, P2, D5, 0u32, Planned, "TIBIA-LOCAL-WORLD", "tibia,benchmark,est:2400m,load:medium,agent:pair", "current", "current")
inl tibia_agent () = Task ("TIBIA-AGENT", "Agent from mrakgr's graph code upgraded with the mega-sample patterns (sizes as type indices with binary type-level naturals, typestate raw/planned/frozen graph, verified-only existential sealing, usage vectors for storage reuse, staged flat-loop emission to Rust and WGSL); CEM with population 64-256 (his was 4); optional ternary weights; promotion only when it beats the best baseline, the random control stays at chance, independent seed windows reproduce, under a declared budget", Feature, P2, D7, 0u32, Planned, "TIBIA-TYPED-RULES,TIBIA-BASELINES,WGSL-BACKEND", "tibia,ml,est:3600m,load:heavy,agent:pair", "current", "current")
inl tibia_arena_release () = Task ("TIBIA-ARENA-RELEASE", "Publish the OT Agent Arena: harness, scenario specs, seeds, server build recipe, baseline configs, results; invite bot authors to submit configs; never publish CipSoft map/sprites/items", Story, P3, D4, 0u32, Planned, "TIBIA-AGENT", "tibia,publish,est:600m,load:light,agent:pair", "current", "current")
inl tibia_2048_anchor () = Task ("TIBIA-2048-ANCHOR", "Credibility anchor on the same CPU/WGSL framework: beat the learning-based 2048 record (Guei: 625,377 average, 72% reach 32768) with n-tuple TD self-play at GPU scale plus expectimax; 100-500 rented RTX 4090 hours (about R$180-1,300) after the user approves a budget tranche", Feature, P3, D6, 0u32, Planned, "WGSL-BACKEND", "ml,benchmark,est:3000m,load:heavy,agent:pair", "current", "current")
inl test_expect_diagnostic () = Task ("TEST-EXPECT-DIAGNOSTIC", "Split from SELF-CHECKING-SAMPLES: a test block whose expectation is a compiler diagnostic, so negatives live in the .spi beside the code (today a test header takes only static/print_code/ignore and passes on exit 0; Brzozowski alone has 31 negative_* folders); proposal: `test name rejects \"<diagnostic text or code>\" =`, compiled but expected to fail with a matching diagnostic; Kino reports it like any test", Story, P1, D5, 0u32, Planned, "", "tests,compiler,kino,est:600m,load:medium,agent:yes", "current", "current")
inl kino_report_targets () = Task ("KINO-REPORT-TARGETS", "Run report lists the targets each test ran with a verdict and timing per target: coins.spi tests with ///> c pass, but the report and the cell show one output and an empty unavailable list, so nobody can tell whether C ran", TaskKind, P2, D2, 0u32, Planned, "", "kino,tests,est:120m,load:light,agent:yes", "current", "current")
inl kino_queue_latency () = Task ("KINO-QUEUE-LATENCY", "Queue time dominates a test cell: coins.spi cell phases_ms queue 8216, compile 3300, target 1899 of 13581 (2026-10-12, warm daemon, other lanes active); measure queue under no load, then fix ordering/parallelism; complements KINO-RESULT-MEMO", TaskKind, P1, D4, 0u32, Planned, "", "kino,perf,est:240m,load:light,agent:yes", "current", "current")
inl kino_startup_cost () = Task ("KINO-STARTUP-COST", "Fixed cost per run: one filtered test (--test diagonal_headings on geometry.spi) took 22.9 s versus 44.9 s for all 8, so ~15-20 s is startup (mix boot, daemon handshake, prefix compile); measure the split and cut it; target: one unchanged test under 1 s with KINO-RESULT-MEMO", TaskKind, P2, D3, 0u32, Planned, "", "kino,perf,est:180m,load:light,agent:yes", "current", "current")
inl kino_multi_path_output () = Task ("KINO-MULTI-PATH-OUTPUT", "run_notebook with several --path refuses --output-path (\"take a single --path\"), so a multi-file run writes .ipynb files next to the sources; add --output-dir (skip if the Kino lane already tracks it)", TaskKind, P2, D2, 0u32, Planned, "", "kino,est:90m,load:light,agent:yes", "current", "current")
inl kino_wgsl_target () = Task ("KINO-WGSL-TARGET", "///> wgsl (and zig) targets in Kino: today Builders knows rust, fsharp, typescript, python, cuda, cpp, gleam, lua, c, delphi; wgsl runs through spiral-wgsl (exit code, prints nothing) (skip if the Kino lane already tracks it)", TaskKind, P1, D3, 0u32, Planned, "", "kino,wgsl,tibia,est:180m,load:light,agent:yes", "current", "current")
inl compiler_cli_default_numerics () = Task ("COMPILER-CLI-DEFAULT-NUMERICS", "--default-int/--default-float on the direct --backend path (Default_Int/Default_Float exist only in the server arguments, spiral_compiler.fs ~7222); mrakgr's ML library needs i32/f32 and the fork compiles it with f64 (skip if the compiler lane already tracks it)", TaskKind, P2, D2, 0u32, Planned, "", "compiler,ml,est:60m,load:light,agent:yes", "current", "current")
inl qualified_union_cases () = Task ("QUALIFIED-UNION-CASES", "Union cases cannot be qualified by module: `vitality.Slain _` in a pattern fails with \"The module does not have the key: Slain\" (apps/tibia/hunt.spi 2026-10-12), so every caller needs a local `open vitality`; decide per edition whether cases become module members (edition 3 candidate)", TaskKind, P2, D4, 0u32, Planned, "", "compiler,language,est:300m,load:medium,agent:yes", "current", "current")
inl test_file_prelude () = Task ("TEST-FILE-PRELUDE", "A file opens lib modules for its tests through a pseudo-test `test name static = open testing`, which reports count as a discovered and passed test (geometry.spi reports 8 = 7 tests + the prelude); give test-only opens their own header so reports count real tests", TaskKind, P3, D2, 0u32, Planned, "", "tests,kino,est:120m,load:light,agent:yes", "current", "current")
inl tibia_standards () = Task ("TIBIA-STANDARDS", "Settle executable standards for apps/tibia (user 2026-10-12: everything before is drift): integer-only rules (i32: WGSL has no i64), bit-exact CPU/GPU, typestate unions for phases, conservation tests for money/items, every rules test lists ///> rust and ///> c (later ///> wgsl), counter-based RNG keyed by seed/tick/entity/purpose (rng.spi), unsigned arithmetic for hashing (wraps on every backend: Rust wrapping_mul, C unsigned), explicit test names, no comments, one module per file in the apps/tibia package; turn each into a check (eoie verb or test) instead of prose", Story, P1, D3, 0u32, Planned, "TIBIA", "tibia,standards,est:240m,load:light,agent:yes", "current", "current")
inl tibia_docs_to_code () = Task ("TIBIA-DOCS-TO-CODE", "apps/tibia README/PLAN/BENCHMARK/MODELING/PRIOR_ART/WORKFLOW.md are transitional prose (user asked for them 2026-10-12 so the plan is not lost): move each claim into a backlog item or a test, then delete the files when the user agrees", TaskKind, P3, D2, 0u32, Planned, "TIBIA-STANDARDS", "tibia,docs,est:120m,load:light,agent:yes", "current", "current")
inl tibia_latest_track () = Task ("TIBIA-LATEST-TRACK", "Latest-of-everything policy (user 2026-10-12): track opentibiabr/canary (3.6.1), opentibiabr/otclient (4.1) and mCodex/nExBot releases; TFS 1.6 (2024) and 1.4.2 (2022) are stale and not used", TaskKind, P3, D1, 0u32, Planned, "TIBIA", "tibia,deps,est:30m,load:light,agent:yes", "current", "current")
inl kino_cross_target_agreement () = Task ("KINO-CROSS-TARGET-AGREEMENT", "Automatic cross-target agreement: a test listing several targets (///> rust, ///> c, later ///> wgsl) compares their stdout and value against the oracle target, instead of each target only having to exit 0; today agreement holds only because every target asserts the same pinned values (apps/tibia hunt_sim.spi golden_seed_7: .rs and .c both print 7/140/69, verified 2026-10-12 after the KINO-C-FALSE-PASS fix); a cell's ///> lines are its whole target list by design", Story, P2, D4, 0u32, Planned, "CONFIGURABLE-ORACLE", "kino,tests,oracle,est:300m,load:light,agent:yes", "current", "current")
inl wgsl_nullary_unions () = Task ("WGSL-NULLARY-UNIONS", "First union step for WGSL: payload-free unions (enums) as u32 tags; today a runtime `union direction = North | East | South | West` fails with \"The WGSL backend doesn't support the type {North : () | East : () | South : () | West : ()} yet\"; records already flatten and compile-time unions erase (probe 2026-10-12: a record step with a static heading ran on spiral-wgsl, exit 0; lowbias32 mix32 and Chebyshev distance agree with Rust and C on the GPU); then payload unions, then arrays as storage buffers", TaskKind, P1, D3, 0u32, Planned, "", "wgsl,compiler,tibia,est:240m,load:medium,agent:yes", "current", "current")
inl c_signed_overflow_ub () = Task ("C-SIGNED-OVERFLOW-UB", "The C backend emits signed arithmetic as plain + (v1 = v0 + 1l) while Rust emits wrapping_add: signed overflow is undefined behaviour in C, so the oracle could disagree under optimization; a probe (i32 max + 1 < max) agreed at -O0 and -O2 on 2026-10-12, but nothing guarantees it: add -fwrapv to the harness and Kino C builds or emit unsigned-cast arithmetic; unsigned u32 already wraps on both", TaskKind, P3, D2, 0u32, Planned, "", "c,backend,oracle,est:60m,load:light,agent:yes", "current", "current")
inl tibia_hunt_sim_wgsl () = Task ("TIBIA-HUNT-SIM-WGSL", "Run apps/tibia/hunt_sim.spi simulate on WGSL and pin golden_seed_7 (7 kills, 140 gold, 69 health after 600 ticks) on the GPU: needs runtime unions (vitality typestate, spell groups) in WGSL; the first end-to-end proof that one Spiral source simulates identically on CPU and GPU", TaskKind, P2, D4, 0u32, Planned, "WGSL-NULLARY-UNIONS,KINO-WGSL-TARGET", "tibia,wgsl,est:240m,load:medium,agent:yes", "current", "current")
inl zed_definition_impact () = Task ("ZED-DEFINITION-IMPACT", "Run test at cursor on a definition row runs only the tests that depend on that definition (today test-at-row.ps1 falls back to every test in the file: hunt_sim.spi row 86 inl advance -> all 6 tests); needs dependency information from the compiler (QUERY-CACHE-COMPILER) or Kino's per-test prefix plan", TaskKind, P3, D5, 0u32, Planned, "ZED-TEST-RUNNABLES,QUERY-CACHE-COMPILER", "zed,kino,tests,est:300m,load:light,agent:yes", "current", "current")
inl tibia_storage_boundary () = Task ("TIBIA-STORAGE-BOUNDARY", "Measured 2026-10-12: backend-neutral Spiral (records, u32/i32 arithmetic, compile-time unions) already compiles to Rust, C and WGSL with identical results without any prototype; prototypes are only needed at the storage boundary (Rust Vec/arrays vs WGSL storage buffers, one simulation per GPU invocation); design that boundary as a prototype with Rust and WGSL instances, modeled on mrakgr's corebase sa/da instances (type-level length via real_core.type_lit_to_lit), instead of making rules code backend-aware", Story, P2, D4, 0u32, Planned, "WGSL-BACKEND,TIBIA-TYPED-RULES", "tibia,wgsl,prototypes,est:360m,load:light,agent:yes", "current", "current")
inl tibia_headless_client () = Task ("TIBIA-HEADLESS-CLIENT", "Headless game client in Spiral (Rust target) for agents and the arena harness: Canary 3.6.1 keeps the classic login protocol on loginProtocolPort 7171 (raw RSA private exponentiation over a 128-byte block with the datapack key.pem, then XTEA with the client key and Adler-32 checksums, src/server/network/protocol/protocollogin.cpp:125-135), so no HTTP login service is needed; allowOldProtocol=false; Canary accepts exactly CLIENT_VERSION 1511 (src/core.hpp:18), or 11.00 when allowOldProtocol is set; per-agent typed view (15x11 tiles) as the only observation; action-rate cap enforced at the protocol layer for parity", Feature, P2, D6, 0u32, Planned, "TIBIA-LOCAL-WORLD", "tibia,protocol,est:1800m,load:light,agent:yes", "current", "current")
inl tibia_oracle_rng () = Task ("TIBIA-ORACLE-RNG", "Canary draws every random number from one global std::mt19937 seeded by std::random_device (src/utils/tools.cpp:449 getRandomGenerator; uniform_random/normal_random/boolean_random, 110 call sites in 18 files: combat.cpp 16, monster.cpp 17, game.cpp 13, ...); std::uniform_int_distribution is implementation-defined (MSVC and libstdc++ differ), so no simulator RNG can match it bit for bit: fidelity for RNG mechanics is distributional (sample each formula, compare with a goodness-of-fit test), and only deterministic mechanics are diffed exactly; a seed override (env var) in a locally built Canary still helps reproduce single scenarios; the C++ build is heavy (vcpkg), schedule it through the gate", TaskKind, P2, D4, 0u32, Planned, "TIBIA-LOCAL-WORLD", "tibia,oracle,canary,est:300m,load:heavy,agent:pair", "current", "current")
inl tibia_numeric_standard () = Task ("TIBIA-NUMERIC-STANDARD", "Server formulas computed in double are reimplemented as exact integer arithmetic so they stay bit-exact on CPU and on WGSL (no f64 there): first case 2026-10-12, Canary Weapons::getMaxWeaponDamage melee offensive std::round(0.085 * attackFactor * attackValue * attackSkill + level / 5) == (85*v*s*2 + 1000) / 2000 + level / 5 for every (value 1..120 step 7, skill 10..130 step 3, level 1/8/100/777) case, 2,788 combinations, 0 differences against a PowerShell double reference (apps/tibia/damage.spi); attackFactor is a float (1.2f is not 1.2), so balanced/defensive modes need the exact binary value of the factor as a rational and a sweep before use; overflow budget: products stay inside i32 for attack <= 200 and skill <= 150, larger formulas need u64 emulation on WGSL", Story, P1, D4, 0u32, Planned, "TIBIA-STANDARDS", "tibia,standards,wgsl,est:300m,load:light,agent:yes", "current", "current")
