inl linked_units_fsharp_d1 () = Task ("LINKED-UNITS-FSHARP-D1", "draft: the F# extern Call row and wrapped-exports entry in build_many (unit as module, consumer call Unit.export), with the record/tuple ABI flags decided against the F# export codegen", TaskKind, P2, D3, 80u32, Active, "", "team:compiler", "current", "current")
