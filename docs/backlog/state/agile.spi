inl compiler_pack_speed_ab () = Task ("COMPILER-PACK-SPEED-AB", "Quiet-box A/B of compile speed, evening pack (tree core A9A71772B249FB8B) vs the previous core (5AA4938BE6339F4A): tonight's review summed 1,940 s of compile time against 398-757 s before, x's exsss gleam cell and the SEFAZ generator cells hit 300 s on the new compiler; decide load vs regression", TaskKind, P0, D3, 100u32, Done, "", "compiler,performance,matrix,main", "current", "current")
