inl regex_bench_page () = Task ("REGEX-BENCH-PAGE", "regex benchmarks in GH Actions: Spiral bench binary with in-job A/A, rotated arms, CPU-time ratios vs the Rust regex crate, typed rows rendered to HTML on the dir-tree-html page", Story, P0, D5, 70u32, Planned, "REGEX-BENCH-GATE-THROW", "regex,automata,team:org,main", "current", "current")
