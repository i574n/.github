inl xsd_choice_repeated_reader () = Task ("XSD-CHOICE-REPEATED-READER", "xsd_emit: repeated/optional choices read every alternative in document order (list of arms, per-arm try_read; any arm included), not the first found", Story, P0, D4, 100u32, Done, "", "fiscal,xsd,typefeatures,codegen,team:fiscal", "current", "current")
