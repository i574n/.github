inl backend_coverage_gaps () = Task ("BACKEND-COVERAGE-GAPS", "Shapes still unsupported per backend, from AGENTS.md: Kotlin/Swift (recursive unions, multi-value array elements, self-calling closures, stack/ref layouts, globals), Lean/Zig (stack layouts, C-only macros, BackendSwitch records without their key), Wasm (stack mutable layouts), Wgsl/Calyx/OpenQasm/eBPF subsets; drive each from the probe matrix and close one shape at a time", Feature, P0, D6, 60u32, Planned, "", "backends,codegen,team:main,wipe-redo", "current", "current")
