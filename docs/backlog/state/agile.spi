inl note_of_ps1_to_spiral_1 () = Note ("PS1-TO-SPIRAL", 1u32, "2026-10-14T12:09Z", "lane-b", "status 2026-10-14: still waits on EOIE-ONE-CALL (0%, Planned). Baseline size: tracked .ps1 spiral 35 files/3360 lines, eoie 17/1748, polyglot 27/682, dice 13/428, alphabet 8/212, i574n.github 5/75 (6505 lines total)")
inl note_of_ps1_to_spiral_2 () = Note ("PS1-TO-SPIRAL", 2u32, "2026-10-15T10:49Z", "main-thread", "06:49 groom: recount 10-15, tracked .ps1: spiral 39 (35 at the 10-14 baseline), eoie 17, polyglot 27, dice 13, alphabet 8. The count is growing (new harness/zed/compiler scripts), the opposite of this item's goal, while EOIE-ONE-CALL stays at 0%. Kept P3; recount after EOIE-ONE-CALL lands.")
