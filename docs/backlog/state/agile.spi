inl regex_derivatives () = Task ("REGEX-DERIVATIVES", "regex Brzozowski engine: derivative matcher over code points, remainder theorem property, interned + memoized lazy DFA", Story, P1, D4, 60u32, Planned, "REGEX-SYNTAX", "regex,automata,team:org,main", "current", "current")
