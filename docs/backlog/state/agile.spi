inl kit_groom_round () = Task ("KIT-GROOM-ROUND", "kit groom start --until HH:MM: a groom round with a deadline in the store, the Stop gate refuses to idle before it, the report computed from the state", Story, P0, D3, 70u32, Planned, "", "kit,agile,groom,cadence,hooks,team:rig", "current", "current")
