inl kit_entry_x_shape () = Task ("KIT-ENTRY-X-SHAPE", "Every kit verb family parses into a typed command union, the x client shape (apps/client cli.spi/args)", Feature, P0, D6, 65u32, Planned, "", "kit,team:rig,typefeatureset,cli,granular", "current", "current")
