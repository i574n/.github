inl compiler_warnings () = Task ("COMPILER-WARNINGS", "Compiler warnings for the drift lanes clean by hand: unused opens, unneeded recursion markers everywhere, unused bindings, unreachable arms, unused definitions, surfaced in gates, census and CI and fixable by one rig verb", Epic, P1, D5, 0u32, Planned, "COMPILER-WARN-SURFACE,COMPILER-WARN-UNUSED-OPEN,COMPILER-WARN-REC-MARKER-LOCAL,COMPILER-WARN-UNUSED-BINDING,COMPILER-WARN-UNREACHABLE-ARM,COMPILER-WARN-UNUSED-DEFINITION,RIG-WARNINGS-FIX", "team:compiler,compiler,warnings,diagnostics,epic", "current", "current")
