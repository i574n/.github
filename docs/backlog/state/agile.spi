inl compiler_install_full_set () = Task ("COMPILER-INSTALL-FULL-SET", "Pack installs copy the build's WHOLE bin set and gate on a real --check smoke, on Windows and Linux", TaskKind, P1, D2, 100u32, Done, "", "compiler,packs,install,team:compiler", "current", "current")
