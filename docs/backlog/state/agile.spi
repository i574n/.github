inl regex_nerode () = Task ("REGEX-NERODE", "regex Nerode core: eager DFA over derivative classes with a typed state cap, Hopcroft minimization (Moore cross-check), minimality certificate, Hopcroft-Karp equivalence, product, inclusion", Story, P1, D6, 55u32, Paused, "REGEX-DERIVATIVES", "regex,automata,team:org,main", "current", "current")
