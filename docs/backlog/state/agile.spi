inl spiral_compiler_1_0_dod () = Task ("SPIRAL-COMPILER-1-0-DOD", "Spiral compiler 1.0 definition of done (working checklist under provisional ORG-VERSIONING)", Story, P2, D3, 30u32, Planned, "ORG-VERSIONING,SPIPROJ-RETIRE,FEATURE-PARITY-TABLE,SPIRAL-CI-COMPILER-BINARIES", "team:compiler,compiler,versioning", "current", "current")
