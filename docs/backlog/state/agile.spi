inl edition3_symbols_migration () = Task ("EDITION3-SYMBOLS-MIGRATION", "Finish edition 3 and migrate every Spiral source in every repo to its symbols (the edition-3 symbol table), getting closer to x sim compatibility", Feature, P0, D7, 70u32, Planned, "SPIRAL3-EDITIONS,X-EDITION3-RESPELL,TIBIA-EDITION3-ROUND,FISCAL-EDITION3-ROUND,EOIE-EDITION3-ROUND,LIB-EDITION3-ROUND,NOTEBOOK-LIVEMD-RETIRE", "team:compiler,edition,syntax,migration,main", "current", "current")
