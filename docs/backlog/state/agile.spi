inl compiler_warm_clients () = Task ("COMPILER-WARM-CLIENTS", "Route every cold-start heavy compile client (kit regen, lib_land_window consumer gates, test.ps1 linked/split suites, node-proof jobs) through one resident server-tcp compiler per (core hash, root)", TaskKind, P1, D4, 55u32, Active, "COMPILER-MEMO-DESIGN", "team:compiler,compiler,performance,memo", "current", "current")
