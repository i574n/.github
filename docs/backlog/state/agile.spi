inl ml_labs () = Task ("ML-LABS", "Revive mrakgr's Spiral-s-ML-Library work as two bounded labs before renting GPUs: Tensor Lab (typed op graph, dimension propagation, storage planner with a CPU reference, then selected GPU kernels) and Leduc Lab (pinned rules/observations, the actual CFR/CEM variants, independent checks); separate same-model-better-execution from different-model results; keep seeds, environment, failed trials with each result", Epic, P1, D7, 0u32, Planned, "", "ml,benchmarks,team:org", "current", "current")
inl planning_of_ml_labs () = Planning ("ML-LABS", Minutes 3600u32, Load Heavy, Assigned Agent)
inl note_of_ml_labs_1 () = Note ("ML-LABS", 1u32, "2026-10-14T12:55Z", "lane-a", "08:55 lane-a: inventory of Spiral-s-ML-Library 80d6a1a (2026-02-05): 174 .spi/.spir; Leduc Lab = game/leduc (base, cardm, deckm, game, model_cfr, model_cem, play_*), 1,148 lines; Tensor Lab = corebase/tensorm + corecuda/tensor_cuda, 613 lines. Real parser per block in measure\\ml-parse.txt.")
inl note_of_ml_labs_2 () = Note ("ML-LABS", 2u32, "2026-10-15T10:49Z", "main-thread", "06:49 groom: source still present (C:\\home\\git\\Spiral-s-ML-Library). Unchanged; P3.")
