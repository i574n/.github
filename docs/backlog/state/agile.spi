inl compiler_lua_union_tag_iife () = Task ("COMPILER-LUA-UNION-TAG-IIFE", "compiler Lua backend: real_core::union_tag on a runtime union emits local v = ;(function () ... end)(), a leading ; in expression position, which lua5.1 rejects (unexpected symbol near ;)", TaskKind, P2, D3, 100u32, Done, "", "compiler,lua,codegen,team:compiler,tibia", "current", "current")
