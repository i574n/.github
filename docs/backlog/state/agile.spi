inl compiler_giant_state_profile () = Task ("COMPILER-GIANT-STATE-PROFILE", "Profile the compiler on the 10.3 MB kit state file docs/backlog/state/agile.spi (user 11-01 round 5: nail typecheck and write slowness now, before the Rust/Gleam rewrite carries it over): phase split parse/infer/peval/codegen/format/write, then fix the top phase", Story, P0, D4, 0u32, Planned, "GIANT-STATE-1-TRACE,GIANT-STATE-2-EXPONENT,GIANT-STATE-3-FIX-TOP,GIANT-STATE-4-CHECK-5S", "team:compiler,compiler,performance,benchmark,kit,typefeatureset", "current", "current")
