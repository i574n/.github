inl hangulize_upstream_retest () = Task ("HANGULIZE-UPSTREAM-RETEST", "The user updated hangulize to its upstream main: retest everything that uses it (alphabet apps, Spiral ports, notebooks), then measure the work of rewriting 100 percent of hangulize in Spiral to drop the dependency and the fork", TaskKind, P1, D3, 100u32, Done, "", "hangulize,alphabet,measure", "current", "current")
inl sefaz_xsd_xml_reader () = Task ("SEFAZ-XSD-XML-READER", "SEFAZ XSD slice 1: an XSD-subset XML reader in Spiral, no crate (start, end and self-closing tags, double-quoted attributes, text, comments, the xml declaration and processing instructions skipped, the 5 predefined entities), test blocks over tiposBasico_v4.00 (608 lines) and leiauteNFe_v4.00 (7,718 lines)", Story, P0, D4, 100u32, Done, "", "sefaz,xsd,xml,lib", "current", "current")
inl sefaz_xsd_schema_model () = Task ("SEFAZ-XSD-SCHEMA-MODEL", "SEFAZ XSD slice 2: a typed XSD model in Spiral (schema, element, complexType, simpleType, restriction facets, sequence and choice, minOccurs/maxOccurs, attributes, include/import resolution) loaded from the reader, organized per (family, version) with shared basics; checked against the census numbers (12,076 elements, 2,238 complexTypes, 5,389 simpleTypes)", Story, P0, D5, 100u32, Done, "SEFAZ-XSD-XML-READER", "sefaz,xsd,typefeatureset", "current", "current")
inl sefaz_xsd_generator () = Task ("SEFAZ-XSD-GENERATOR", "SEFAZ XSD slice 3: generate typed Spiral from the model: 266 shared enumeration unions keyed by value set (from 1,405 enumerated simpleTypes), typed singleton constants, about 826 deduped records and unions (choices as unions, occurs as option/array), validated length facets, per (family, version) modules; generated code compiles and round-trips real NF-e XML", Feature, P0, D7, 100u32, Done, "SEFAZ-XSD-SCHEMA-MODEL,SEFAZ-XSD-PATTERNS", "sefaz,xsd,generator,typefeatureset", "current", "current")
inl sefaz_xsd_patterns () = Task ("SEFAZ-XSD-PATTERNS", "SEFAZ XSD slice 4: the 196 distinct XSD pattern regexes (of 2,055 facets: classes, bounded repeats, alternation, groups, optional, XSD class subtraction) compiled once each into DFAs with the Brzozowski-derivative approach, as typed validators", Story, P0, D5, 100u32, Done, "SEFAZ-XSD-XML-READER", "sefaz,xsd,regex,derivatives", "current", "current")
inl fiscal_br_delphi_bench () = Task ("FISCAL-BR-DELPHI-BENCH", "SEFAZ XSD slice 5: the Delphi backend for the generated code, and the ACBr and Zeus (DFe.NET) benchmarks the way Tibia uses open-source bots: parse, validate and serialize the same documents and compare results and speed", Story, P0, D6, 100u32, Done, "SEFAZ-XSD-GENERATOR,DELPHI-64BIT-DFA-DISAGREE,DELPHI-CASE-INSENSITIVE-NAMES", "team:fiscal,sefaz,xsd,delphi,benchmark,team:fiscal", "current", "current")
