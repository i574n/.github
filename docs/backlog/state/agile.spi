inl mega_samples_together () = Task ("MEGA-SAMPLES-TOGETHER", "Advance the 5 mega samples at the same time instead of brzozowski alone, so compiler fixes generalize (user 2026-10-06 18:04 'instead of iterating with brzozowski only we might find better fixes for the compiler if we advanced the 5 mega samples at the same time?'); per mega sample: list what it cannot express today, fix in the compiler, keep all five green", Feature, P1, D6, 45u32, Planned, "GADT-JOIN-POINT-GROWING-INDEX", "team:compiler,samples,main", "current", "current")
