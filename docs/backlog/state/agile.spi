inl parser_silent_drops_hard_errors () = Task ("PARSER-SILENT-DROPS-HARD-ERRORS", "Parser: a local named open silently drops the definition (only a ParserErrors warning), and Some { record } needs Some ({ ... }); make both hard errors that name the line", TaskKind, P2, D3, 100u32, Done, "", "team:compiler,compiler,parser,diagnostics", "current", "current")
