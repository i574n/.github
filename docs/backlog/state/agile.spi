inl fiscal_lib_granular_6a_emit () = Task ("FISCAL-LIB-GRANULAR-6A-EMIT", "GRANULAR 6A: xsd_emit code overages at weight 273-350 (134 definitions) to 0 by helper extraction, output-neutral", TaskKind, P2, D4, 40u32, Active, "XSD-FIELD-DESCRIPTORS-3-READ", "team:fiscal,fiscal,lib,granular,style", "current", "current")
