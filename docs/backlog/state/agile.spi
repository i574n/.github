inl kit_exec_metrics_m1 () = Task ("KIT-EXEC-METRICS-M1", "KIT-EXEC-METRICS milestone 1: job receipts become samples per label and machine with elapsed and peak memory", TaskKind, P0, D1, 90u32, Active, "", "kit,metrics,typefeatureset,bench,node,team:rig", "current", "current")
