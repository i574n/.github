inl fiscal_validator_false_green () = Task ("FISCAL-VALIDATOR-FALSE-GREEN", "family gate: validate-example.ps1 reports 0 messages when the schema fails to load (conf_recebto on Windows, SAF-T)", TaskKind, P1, D3, 100u32, Done, "", "team:fiscal,fiscal,ci,xsd,validation", "current", "current")
