inl dialect_rename_edition3 () = Task ("DIALECT-RENAME-EDITION3", "Replace 'edition 3' everywhere with the i574n dialect naming the user chose ('spiral (i574n dialect)'): manifests (edition: 3 -> dialect = i574n), item names, docs, code identifiers, messages; with spiral.toml present the dialect is implicit, and script-like runs need no manifest at all", Story, P1, D3, 40u32, Active, "DIALECT-IDENTITY", "edition3,dialect,naming,main,team:org", "current", "current")
