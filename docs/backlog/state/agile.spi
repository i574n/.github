inl x_split_on_no_array () = Task ("X-SPLIT-ON-NO-ARRAY", "x: a faster prelude split_on that stays Gleam-safe (no array module in the sim build) and fits one post (cell weight <= 272)", TaskKind, P3, D2, 100u32, Done, "X-WIP-VERIFY", "x,perf,prelude", "current", "current")
