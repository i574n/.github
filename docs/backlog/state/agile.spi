inl stable_entry_points_d1 () = Task ("STABLE-ENTRY-POINTS-D1", "draft: a no-main auto-export package builds as a library unit (synthesize the trivial entry before prepass, not as a hand-built EFun')", TaskKind, P2, D2, 85u32, Active, "", "team:compiler", "current", "current")
