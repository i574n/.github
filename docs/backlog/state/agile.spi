inl x_backend_switches () = Task ("X-BACKEND-SWITCHES", "x: run the measured backend switches from X-BACKEND-MAP by their pre-registered rules (sim shell Elixir vs Gleam OTP, corpus run Elixir vs Rust vs Rust+par, native tree sampler, batch dry-run), each on a quiet box with the ledger experiments", Story, P2, D4, 0u32, Planned, "X-BACKEND-MAP,X-RUN-METRICS", "team:microblog,microblog,backends,sim,measure,wipe-redo", "current", "current")
