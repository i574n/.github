inl agile_degrade_d2 () = Task ("AGILE-DEGRADE-D2", "degradation: C3 a false checkable premise (re-checked and corrected by the detector) and C4 draft stack depth of 2 or more", TaskKind, P0, D3, 0u32, Planned, "", "kit,agile,healing,degradation,team:rig", "current", "current")
