inl note_of_profile_mirror_silent_fail_20 () = Note ("PROFILE-MIRROR-SILENT-FAIL", 20u32, "2026-11-05T09:36Z", "resilience", "monitor ALARM (OK->bad transition): profile-mirror-monitor 2026-11-05 05:36 UNREACHABLE (node down all routes)")
