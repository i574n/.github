inl note_of_rust_global_granular_12 () = Note ("RUST-GLOBAL-GRANULAR", 12u32, "2026-10-24T02:25Z", "main", "2026-10-23 22:2x main grooming: Paused by rule (Active, no note since 2026-10-19T18:25Z, no child item noted in 3 days). Resume when picked; progress kept at 5%.")
inl mega_samples_together () = Task ("MEGA-SAMPLES-TOGETHER", "Advance the 5 mega samples at the same time instead of brzozowski alone, so compiler fixes generalize (user 2026-10-06 18:04 'instead of iterating with brzozowski only we might find better fixes for the compiler if we advanced the 5 mega samples at the same time?'); per mega sample: list what it cannot express today, fix in the compiler, keep all five green", Feature, P1, D6, 45u32, Paused, "GADT-JOIN-POINT-GROWING-INDEX", "compiler,samples,main", "current", "current")
