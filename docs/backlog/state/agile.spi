inl formatter_keep_breaks () = Task ("FORMATTER-KEEP-BREAKS", "Formatter keeps authored line breaks: single-valued habits enforced, mixed habits (line breaks) left as written, over-120 still broken; then redo the destructive run from HEAD", Story, P0, D5, 95u32, Blocked, "FORMATTER-PRE-HOPAC-AUDIT", "formatter,spiral,team:compiler,main,wipe-redo", "current", "current")
