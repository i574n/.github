inl backend_primitive_parity_d2 () = Task ("BACKEND-PRIMITIVE-PARITY-D2", "draft 6: base.spi (=.) and (<>.) get C and Pascal arms via the core EQ/NEQ ops", TaskKind, P2, D2, 100u32, Done, "", "team:compiler,compiler,backends,lib", "current", "current")
