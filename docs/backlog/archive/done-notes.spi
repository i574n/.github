inl note_of_package_default_numerics_2 () = Note ("PACKAGE-DEFAULT-NUMERICS", 2u32, "2026-10-14T15:16Z", "lane-a", "11:16 lane-a: core half verified on an isolated Debug build: SpiProj.config now returns Ok for 'edition: 3 / default-int: i64 / default-float: f32' (parse error before). Host half (applyPackageDefaults in Program.fs) is unbuilt: the build uses the in-tree host.")
inl note_of_package_default_numerics_3 () = Note ("PACKAGE-DEFAULT-NUMERICS", 3u32, "2026-10-14T20:22Z", "lane-a", "Host half verified on candidate (core+host on installed core): real-segment literal 3000000000 fails 'cannot be safely parsed as i32' without spiproj field, compiles (exit 0) with 'default-int: i64' in package.spiproj. Patch now in pack-1e.")
